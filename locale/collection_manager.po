#: operators.py:109
msgctxt "Operator"
msgid "* Ctrl+LMB - Expand/Collapse all sublevels\n  * Shift+LMB - Isolate tree/Restore\n  * Alt+LMB - Discard history"
msgstr "* Ctrl+LMB - 展开/折叠所有子层级\n  * Shift+LMB - 隔离树/恢复\n  * Alt+LMB - 放弃历史"

#: operators.py:454
#: operators.py:579
msgctxt "Operator"
msgid "* LMB - Enable all/Restore.\n  * Shift+LMB - Invert.\n  * Shift+Ctrl+LMB - Isolate collections w/ selected objects.\n  * Shift+Alt+LMB - Disable collections w/ selected objects.\n  * Ctrl+LMB - Copy/Paste RTOs.\n  * Ctrl+Alt+LMB - Swap RTOs.\n  * Alt+LMB - Discard history"
msgstr "* LMB - 启用全部/恢复。\n  * Shift+LMB - 反转。\n  * Shift+Ctrl+LMB - 隔离含选中物体的集合。\n  * Shift+Alt+LMB - 禁用含选中物体的集合。\n  * Ctrl+LMB - 复制/粘贴 RTO。\n  * Ctrl+Alt+LMB - 交换 RTO。\n  * Alt+LMB - 放弃历史"

#: operators.py:279
msgctxt "Operator"
msgid "* LMB - Move objects to collection.\n  * Shift+LMB - Add/Remove objects from collection"
msgstr "* LMB - 将物体移动到集合。\n  * Shift+LMB - 在集合中添加/移除物体"

#: operators.py:202
msgctxt "Operator"
msgid "* LMB - Select all objects in collection.\n  * Shift+LMB - Add/Remove collection objects from selection.\n  * Ctrl+LMB - Isolate nested selection.\n  * Ctrl+Shift+LMB - Add/Remove nested from selection"
msgstr "* LMB - 选择集合中的所有物体。\n  * Shift+LMB - 从选择中添加/移除集合物体。\n  * Ctrl+LMB - 隔离嵌套选择。\n  * Ctrl+Shift+LMB - 从选择中添加/移除嵌套项"

#: operators.py:386
#: operators.py:520
msgctxt "Operator"
msgid "* Shift+LMB - Isolate/Restore.\n  * Shift+Ctrl+LMB - Isolate nested/Restore.\n  * Ctrl+LMB - Toggle nested.\n  * Alt+LMB - Discard history"
msgstr "* Shift+LMB - 隔离/恢复。\n  * Shift+Ctrl+LMB - 隔离嵌套/恢复。\n  * Ctrl+LMB - 切换嵌套。\n  * Alt+LMB - 放弃历史"

