msgid "Draw a spline by clicking, like 3ds Max Line; hold Alt and drag for Bezier handles. Zoom, pan and Blender snapping stay available while drawing"
msgstr "通过单击绘制样条，类似 3ds Max 的线；按住 Alt 拖动可绘制贝塞尔手柄。绘制时仍可使用缩放、平移和 Blender 吸附"

#: operators.py:1201
#: panels.py:588
msgctxt "Operator"
msgid "Explode"
msgstr "炸开"

#: operators.py:1476
#: panels.py:446
msgctxt "Operator"
msgid "Extrude"
msgstr "挤出"

#: operators.py:1477
msgctxt "Operator"
msgid "Extrude selected splines into a solid (3ds Max Extrude). Open splines are closed first; the direction follows the view used while drawing (top/bottom = Z, left/right = X, front/back = Y); height may be negative"
msgstr "将选中的样条挤出为实体（3ds Max 挤出）。开放样条会先闭合；方向取决于绘制时使用的视图（顶/底 = Z，左/右 = X，前/后 = Y）；高度可为负值"

#: operators.py:759
#: panels.py:498
msgctxt "Operator"
msgid "Fillet"
msgstr "圆角"

#: operators.py:254
#: panels.py:322
msgctxt "Operator"
msgid "Grow Selection"
msgstr "扩展选择"

#: operators.py:255
msgctxt "Operator"
msgid "Grow the selection one vertex to each side, handy for picking segments"
msgstr "向两侧各扩展一个顶点，便于选取线段"

#: panels.py:628
msgctxt "Operator"
msgid "Hide Lathe"
msgstr "隐藏车削"

#: operators.py:2085
msgctxt "Operator"
msgid "Insert a point between a selected vertex and the next one (3ds Max Refine); Bezier splines are split exactly, shape unchanged. With interactive mode you click anywhere on the curve to insert"
msgstr "在选中顶点与下一个顶点之间插入点（3ds Max 优化）；贝塞尔样条会精确拆分，形状不变。交互模式下可在曲线上任意位置单击插入"

#: panels.py:318
msgctxt "Operator"
msgid "Invert"
msgstr "反选"

#: operators.py:1694
#: panels.py:617
msgctxt "Operator"
msgid "Lathe"
msgstr "车削"

#: operators.py:804
#: panels.py:480
msgctxt "Operator"
msgid "Make First"
msgstr "设为首点"

#: operators.py:805
msgctxt "Operator"
msgid "Make the selected vertex the spline's first point (shape unchanged)"
msgstr "将选中顶点设为样条的首点（形状不变）"

#: operators.py:1245
msgctxt "Operator"
msgid "Merge other selected curve objects into the active one (3ds Max Attach)"
msgstr "将其他选中的曲线物体合并到活动物体（3ds Max 附加）"

#: operators.py:362
msgctxt "Operator"
msgid "Merge selected vertices within the threshold; poly splines are de-duplicated, closed and stitched back together"
msgstr "合并阈值内的选中顶点；多边形样条会去重、闭合并重新缝合"

#: operators.py:1142
#: panels.py:597
msgctxt "Operator"
msgid "Mirror"
msgstr "镜像"

#: operators.py:1143
msgctxt "Operator"
msgid "Mirror selected splines on an axis"
msgstr "沿轴镜像选中的样条"

#: operators.py:1932
#: panels.py:606
msgctxt "Operator"
msgid "Normalize"
msgstr "规范化"

#: operators.py:974
msgctxt "Operator"
msgid "Offset selected splines in parallel. Open splines get a closed outline (ready to extrude); positive goes outward, negative inward. Click then move the mouse to adjust, LMB confirms"
msgstr "平行偏移选中的样条。开放样条会生成闭合轮廓（可直接挤出）；正值向外，负值向内。单击后移动鼠标调整，左键确认"

#: operators.py:973
#: panels.py:574
msgctxt "Operator"
msgid "Outline"
msgstr "轮廓"

#: panels.py:397
msgctxt "Operator"
msgid "Rebuild"
msgstr "重建"

#: operators.py:2084
#: panels.py:515
msgctxt "Operator"
msgid "Refine"
msgstr "优化"

#: menus.py:32
msgctxt "Operator"
msgid "Refine (click with mouse)"
msgstr "优化（鼠标单击）"

#: operators.py:1762
#: panels.py:633
msgctxt "Operator"
msgid "Remove Lathe"
msgstr "移除车削"

#: operators.py:1933
msgctxt "Operator"
msgid "Resample selected splines into equal-length segments (3ds Max Normalize Spline)"
msgstr "将选中的样条重采样为等长线段（3ds Max 规格化样条）"

#: operators.py:904
msgctxt "Operator"
msgid "Resample selected splines into polylines, keeping the shape"
msgstr "将选中的样条重采样为折线，保持形状"

#: panels.py:490
msgctxt "Operator"
msgid "Reset Tangents"
msgstr "重置切线"

#: operators.py:837
#: panels.py:587
msgctxt "Operator"
msgid "Reverse"
msgstr "反转"

#: operators.py:838
msgctxt "Operator"
msgid "Reverse the spline direction"
msgstr "反转样条方向"

#: operators.py:760
msgctxt "Operator"
msgid "Round the selected corners (result becomes a poly spline); click then drag up/down to change the radius live"
msgstr "对选中的角点进行圆化（结果为多边形样条）；单击后上下拖动可实时调整半径"

#: panels.py:671
msgctxt "Operator"
msgid "Sample as Poly"
msgstr "采样为多边形"

#: operators.py:2674
msgctxt "Operator"
msgid "Section"
msgstr "截面"

#: menus.py:47
msgctxt "Operator"
msgid "Section (slice mesh)"
msgstr "截面（剖切网格）"

#: panels.py:317
msgctxt "Operator"
msgid "Select All"
msgstr "全选"

#: operators.py:281
msgctxt "Operator"
msgid "Select All Vertices"
msgstr "选择所有顶点"

#: operators.py:235
msgctxt "Operator"
msgid "Select Whole Spline"
msgstr "选择整条样条"

#: operators.py:236
msgctxt "Operator"
msgid "Select every spline that owns a selected vertex (3ds Max spline sub-object)"
msgstr "选择包含选中顶点的所有样条（3ds Max 样条子对象）"

#: operators.py:282
msgctxt "Operator"
msgid "Select every vertex of the current curve"
msgstr "选择当前曲线的所有顶点"

#: operators.py:1815
msgctxt "Operator"
msgid "Set selected vertices to Corner / Smooth / Bezier / Bezier Corner; poly splines are converted to Bezier (3ds Max right-click vertex types)"
msgstr "将选中顶点设为角点/平滑/贝塞尔/贝塞尔角点；多边形样条会转换为贝塞尔（3ds Max 右键顶点类型）"

#: operators.py:1788
msgctxt "Operator"
msgid "Show / Hide Lathe"
msgstr "显示/隐藏车削"

#: panels.py:628
msgctxt "Operator"
msgid "Show Lathe"
msgstr "显示车削"

#: operators.py:2675
msgctxt "Operator"
msgid "Slice selected meshes with a plane and turn the intersection into splines (3ds Max Section shape). Click, then move the mouse to slide the cutting plane"
msgstr "用平面剖切所选网格，并将交线转换为样条（3ds Max 的剖面图形）。点击后移动鼠标可滑动剖切平面"

#: panels.py:486
msgctxt "Operator"
msgid "Smooth"
msgstr "平滑"

#: operators.py:885
msgctxt "Operator"
msgid "Split selected segments into equal parts (3ds Max Divide)"
msgstr "将所选线段等分为若干段（3ds Max 的 Divide）"

#: operators.py:1202
msgctxt "Operator"
msgid "Split selected splines into one spline per segment (3ds Max Explode)"
msgstr "将所选样条拆分，每段成为一条样条（3ds Max 的 Explode）"

#: operators.py:1789
msgctxt "Operator"
msgid "Temporarily hide the Screw modifier so you can inspect the spline alone"
msgstr "临时隐藏螺旋修改器，以便单独检查样条"

#: operators.py:903
#: panels.py:523
msgctxt "Operator"
msgid "To Poly"
msgstr "转换为多边形"

#: operators.py:861
msgctxt "Operator"
msgid "Toggle the closed state of selected splines"
msgstr "切换所选样条的闭合状态"

#: operators.py:1356
msgctxt "Operator"
msgid "Union / difference / intersect closed splines (largest one is the base, the rest are tools)"
msgstr "对闭合样条执行并集 / 差集 / 相交（最大的为基础，其余为工具）"

#: operators.py:1814
msgctxt "Operator"
msgid "Vertex Type"
msgstr "顶点类型"

#: menus.py:33
#: panels.py:475
msgctxt "Operator"
msgid "Weld"
msgstr "焊接"

#: operators.py:361
msgctxt "Operator"
msgid "Weld Vertices"
msgstr "焊接顶点"

#: panels.py:321
msgctxt "Operator"
msgid "Whole Spline"
msgstr "整条样条"
