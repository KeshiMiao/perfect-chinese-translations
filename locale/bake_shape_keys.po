#: operators/objects.py:14
msgctxt "Operator"
msgid "Creates new object for every frame that has different Shape Key values within the selected frame range.\nCan be used to turn keyframed mesh into separate objects.\nDuplicated meshes will be given unique name for origanizational purposes"
msgstr "在所选帧范围内，为形态键值不同的每一帧创建新物体。\n可用于将有关键帧的网格转换为独立物体。\n为便于管理，复制的网格将获得唯一名称"

#: operators/duplicate.py:21
msgctxt "Operator"
msgid "Duplicate Shape Key (with Animation)"
msgstr "复制形态键（含动画）"

#: operators/bake.py:13
msgctxt "Operator"
msgid "Insert Keyframe for All Shape Keys"
msgstr "为所有形态键插入关键帧"

#: ui.py:19
msgctxt "Operator"
msgid "Insert Keyframe for Shape Keys"
msgstr "为形态键插入关键帧"

#: operators/bake.py:33
msgctxt "Operator"
msgid "Insert keyframes for all shape keys on selected objects on every frame within frame range"
msgstr "在帧范围内的每一帧为所选物体的所有形态键插入关键帧"

#: ui.py:30
msgctxt "Operator"
msgid "Keyframe All Shape Keys"
msgstr "为所有形态键插入关键帧"

#: operators/bake.py:14
msgctxt "Operator"
msgid "Keyframe all shape keys of the active object"
msgstr "为活动物体的所有形态键插入关键帧"

#: operators/duplicate.py:22
msgctxt "Operator"
msgid "Make a duplicated copy of an active shape key with it's animation & drivers"
msgstr "复制活动形态键及其动画与驱动器"

