msgid "Add ARKit Keys"
msgstr "添加 ARKit 形态键"

#: operators.py:398
msgctxt "Operator"
msgid "Add missing ARKit 52 shape keys to the active object. Existing keys are kept and not duplicated."
msgstr "将缺失的 ARKit 52 个形态键添加到活动物体。现有键会保留，不会重复。"

#: operators.py:360
#: ui.py:171
msgctxt "Operator"
msgid "Apply Modifier Keep Shape Keys"
msgstr "应用修改器并保留形态键"

#: operators.py:174
msgctxt "Operator"
msgid "Apply the current source -> target direction to selected mesh objects. Each mesh must contain matching source and target shape keys."
msgstr "将当前源 -> 目标方向应用到选中的网格物体。每个网格必须包含匹配的源和目标形态键。"

#: operators.py:361
msgctxt "Operator"
msgid "Apply the selected modifier while rebuilding all existing shape keys. Other modifiers are temporarily disabled to avoid double application."
msgstr "应用所选修改器并重建所有现有形态键。其他修改器会临时禁用，以避免重复应用。"

#: ui.py:126
msgctxt "Operator"
msgid "Batch Mirror"
msgstr "批量镜像"

#: operators.py:128
msgctxt "Operator"
msgid "Batch Mirror Shape Keys"
msgstr "批量镜像形态键"

#: operators.py:483
msgctxt "Operator"
msgid "Bind the existing ARKit 52 shape keys to VRM0 default Blend Shape Proxy expressions."
msgstr "将现有 ARKit 52 个形态键绑定到 VRM0 默认 Blend Shape Proxy 表情。"

#: operators.py:509
#: ui.py:198
msgctxt "Operator"
msgid "Cancel Default Adaptation"
msgstr "取消默认适配"

#: operators.py:275
msgctxt "Operator"
msgid "Center and symmetrize the mesh data without deleting vertices, changing topology, or touching UVs. Shape key deltas are preserved."
msgstr "居中并对称化网格数据，不删除顶点、不更改拓扑，也不影响 UV。形态键增量会保留。"

#: operators.py:417
#: ui.py:233
msgctxt "Operator"
msgid "Convert Naming"
msgstr "转换命名"

#: operators.py:249
msgctxt "Operator"
msgid "Copy base shape coordinates into the active shape key. This clears the current key without changing the base shape or other shape keys."
msgstr "将基础形态坐标复制到活动形态键。这会清空当前键，但不改变基础形态或其他形态键。"

#: operators.py:536
msgctxt "Operator"
msgid "Import ARKit 52 keys into the VRM0 Blend Shape Proxy. Existing ARKit proxy groups are reused or renamed without duplicate binds."
msgstr "将 ARKit 52 个形态键导入 VRM0 Blend Shape Proxy。现有 ARKit 代理组会被重用或重命名，不会重复绑定。"

#: operators.py:535
msgctxt "Operator"
msgid "Import to VRM Proxy"
msgstr "导入到 VRM 代理"

#: ui.py:211
msgctxt "Operator"
msgid "Lower Camel Case"
msgstr "小驼峰式"

#: operators.py:86
msgctxt "Operator"
msgid "Mirror Active Shape Key"
msgstr "镜像活动形态键"

#: operators.py:173
msgctxt "Operator"
msgid "Mirror Pair Across Selected Meshes"
msgstr "跨选中的网格镜像配对"

#: operators.py:129
msgctxt "Operator"
msgid "Mirror same-side shape keys on the active mesh and create missing opposite keys. Existing targets are preserved unless overwrite is enabled."
msgstr "在活动网格上镜像同侧形态键，并创建缺失的对侧键。除非启用覆盖，否则保留现有目标。"

#: operators.py:87
msgctxt "Operator"
msgid "Mirror the resolved source shape key into the target shape key. Does not create, delete, or rename shape keys."
msgstr "将解析出的源形态键镜像到目标形态键。不会创建、删除或重命名形态键。"

#: operators.py:510
msgctxt "Operator"
msgid "Remove ARKit 52 binds from VRM0 default Blend Shape Proxy expressions while keeping the default groups."
msgstr "从 VRM0 默认 Blend Shape Proxy 表情中移除 ARKit 52 个绑定，同时保留默认组。"

#: operators.py:440
#: ui.py:235
msgctxt "Operator"
msgid "Repair 52 Symmetry"
msgstr "修复 52 对称"

#: operators.py:315
#: ui.py:143
msgctxt "Operator"
msgid "Repair Active Key Symmetry"
msgstr "修复活动键对称"

#: operators.py:274
#: ui.py:43
msgctxt "Operator"
msgid "Repair Model Symmetry"
msgstr "修复模型对称"

#: operators.py:441
msgctxt "Operator"
msgid "Repair symmetry drift across the existing ARKit 52 shape keys. Does not add, delete, or rename shape keys."
msgstr "修复现有 ARKit 52 个形态键之间的对称偏移。不会添加、删除或重命名形态键。"

#: operators.py:316
msgctxt "Operator"
msgid "Repair the active shape key against itself. If only one side was edited, the edited side is mirrored to the untouched side."
msgstr "修复活动形态键自身的对称。如果只编辑了一侧，则将已编辑侧镜像到未改动侧。"

#: operators.py:248
#: ui.py:138
msgctxt "Operator"
msgid "Reset Active Shape Key"
msgstr "重置活动形态键"

#: ui.py:205
msgctxt "Operator"
msgid "Title Case"
msgstr "标题式"

#: operators.py:418
msgctxt "Operator"
msgid "Toggle ARKit names between Left/Right and _L/_R style. Directional names such as MouthLeft are kept."
msgstr "在 Left/Right 与 _L/_R 风格之间切换 ARKit 名称。MouthLeft 等方向性名称保持不变。"
