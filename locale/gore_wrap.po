#: properties.py:269
msgid "Add a 'defects' layer outlining each flagged piece, so you can see what is at risk before cutting. Delete or hide that layer before you cut"
msgstr "添加一个“defects”图层，勾勒出每个被标记的裁片，以便在切割前查看风险。切割前请删除或隐藏该图层"

#: properties.py:161
msgid "Add a separate labels layer numbering the strips in wrap order (exclude it from cutting)"
msgstr "添加单独的标签图层，按包裹顺序为裁片条编号（切割时排除该图层）"

#: ui.py:244
msgid "Advice is stale"
msgstr "建议已过期"

#: properties.py:295
msgid "Along Surface"
msgstr "沿表面"

#: properties.py:275
msgid "Also box the pieces no placement can fix, in a separate cyan 'defects-intrinsic' layer. Those rectangles are cuttable too: delete or hide that layer before you cut"
msgstr "还用单独的青色“defects-intrinsic”图层框出无法通过摆放修复的裁片。这些矩形也可切割：切割前请删除或隐藏该图层"

#: properties.py:224
msgid "Also search up and down the strip, not just around the object. Slower, and it moves what the base and top cuts pass through"
msgstr "还会沿裁片条上下搜索，而不只绕物体搜索。速度更慢，且会改变底部和顶部切割经过的位置"

#: properties.py:115
msgid "Angular width of each gore, derived from the strip count"
msgstr "每个裁片的角宽，由裁片条数量推导"

#: properties.py:205
msgid "Automatic"
msgstr "自动"

#: properties.py:126
msgid "Averaged"
msgstr "平均"

#: ui.py:127
msgid "Best placement is no better than this one"
msgstr "最佳摆放并不优于当前摆放"

#: properties.py:313
msgid "Bottom Circumference"
msgstr "底部周长"

#: properties.py:146
msgid "Bottom Crop"
msgstr "底部裁剪"

#: properties.py:308
msgid "Calibrate By"
msgstr "校准依据"

#: ui.py:265
msgid "Changes how the design reads"
msgstr "改变图案的呈现效果"

#: properties.py:176
msgid "Check Tiling"
msgstr "检查平铺"

#: operators.py:784
msgid "Choose a pattern SVG first."
msgstr "请先选择图案 SVG。"

#: operators.py:553
#: operators.py:711
msgid "Choose a pattern SVG or turn off Fill With Pattern."
msgstr "请选择图案 SVG，或关闭“用图案填充”。"

#: properties.py:262
msgid "Corner Angle (deg)"
msgstr "拐角角度（度）"

#: properties.py:253
msgid "Custom"
msgstr "自定义"

#: properties.py:262
msgid "Custom mode: keep a join as a sharp corner only if the path turns by more than this many degrees; gentler bends are smoothed into one curve"
msgstr "自定义模式：仅当路径转折超过此角度数时，才将接合处保留为尖角；更平缓的弯折会平滑为一条曲线"

#: properties.py:257
msgid "Custom mode: maximum deviation of the fitted curves from the true warped shape"
msgstr "自定义模式：拟合曲线与真实变形形状的最大偏差"

#: properties.py:251
msgid "Cutter Resolution"
msgstr "切割器分辨率"

#: ui.py:99
msgid "Deeper than the object is tall"
msgstr "比物体高度更深"

#: operators.py:392
msgid "Derived dimension is zero; re-run Preview."
msgstr "推导尺寸为零；请重新运行预览。"

#: properties.py:146
msgid "Discard everything below this height (mesh units)"
msgstr "丢弃此高度以下的所有内容（网格单位）"

#: properties.py:287
msgid "Distance From Top (mm)"
msgstr "距顶部距离（毫米）"

#: properties.py:295
msgid "Distance up the strip itself, as measured on the flat pattern"
msgstr "沿裁片条自身的距离，按展开图案测量"

#: properties.py:156
msgid "Douglas-Peucker simplification tolerance"
msgstr "Douglas-Peucker 简化容差"

#: properties.py:128
msgid "Each gore fitted to its own angular sector of the scan"
msgstr "每个裁片适配扫描件各自的角扇区"

#: operators.py:384
msgid "Enter a positive measured value."
msgstr "请输入正的测量值。"

#: properties.py:251
msgid "Exact fidelity for precise cutting (0.00625 mm, 5°)"
msgstr "精确切割所需的高保真（0.00625 毫米，5°）"

#: properties.py:249
msgid "Fewest nodes, smoothest cut; keeps real corners (0.1 mm, 30°)"
msgstr "节点最少、切割最平滑；保留真实拐角（0.1 毫米，30°）"

#: properties.py:167
msgid "Fill With Pattern"
msgstr "用图案填充"

#: properties.py:239
msgid "Fit the warped pattern to smooth cubic bezier curves so the cutter does not stutter through many tiny line segments"
msgstr "将变形图案拟合为平滑的三次贝塞尔曲线，避免切割器因大量细小线段而卡顿"

#: properties.py:128
msgid "Fitted"
msgstr "拟合"

#: ui.py:267
msgid "Gain is mostly the coverage it removes"
msgstr "增益主要来自它去除的覆盖范围"

#: properties.py:151
msgid "Gaussian smoothing of the radius profile, in bands"
msgstr "按条带对半径轮廓进行高斯平滑"

#: ui.py:47
msgid "Gore 1 = green, wind toward orange (gore 2)"
msgstr "裁片 1 = 绿色，向橙色（裁片 2）方向缠绕"

#: ui.py:28
#: ui.py:32
msgid "Gore Wrap"
msgstr "Gore Wrap"

#: properties.py:311
msgid "Height"
msgstr "高度"

#: properties.py:244
msgid "How aggressively to simplify the warped pattern into smooth cutter curves"
msgstr "将变形图案简化为平滑切割曲线的强度"

#: properties.py:287
msgid "How far down from the top of the object the pattern ends"
msgstr "图案从物体顶部向下结束的位置"

#: properties.py:110
msgid "How many gore strips to cut the object into"
msgstr "将物体切成多少条裁片"

#: properties.py:189
msgid "How many times the pattern tiles around the full circumference (fit exactly, for seamlessness)"
msgstr "图案沿整个周长平铺的次数（精确适配以实现无缝）"

#: properties.py:291
msgid "How the distance from the top is measured"
msgstr "距顶部距离的测量方式"

#: properties.py:201
msgid "How the pattern is positioned on the gores"
msgstr "图案在裁片上的定位方式"

#: properties.py:275
msgid "Include All Cuts Under Threshold"
msgstr "包含阈值以下的所有切割"

#: properties.py:194
msgid "Invert Pattern"
msgstr "反转图案"

#: properties.py:282
msgid "Limit Pattern Height"
msgstr "限制图案高度"

#: properties.py:208
msgid "Manual"
msgstr "手动"

#: properties.py:269
msgid "Mark Defects in Export"
msgstr "在导出中标记缺陷"

#: properties.py:312
msgid "Max Diameter"
msgstr "最大直径"

#: properties.py:176
msgid "Measure how well the pattern joins itself when it repeats, whenever the pattern file changes. Runs in the background with a progress bar; turn it off to skip it and check by hand instead"
msgstr "每当图案文件更改时，测量图案重复时自身接合的效果。会在后台显示进度条运行；关闭后可跳过并改为手动检查"

#: properties.py:291
msgid "Measured"
msgstr "测量值"

#: properties.py:317
msgid "Measured (mm)"
msgstr "测量值（毫米）"

#: properties.py:211
msgid "Min Fragment Area (mm²)"
msgstr "最小碎片面积（平方毫米）"

#: properties.py:217
msgid "Min Fragment Width (mm)"
msgstr "最小碎片宽度（毫米）"

#: ui.py:238
msgid "Minutes, not seconds. Esc cancels."
msgstr "需要几分钟而非几秒。按 Esc 取消。"

#: properties.py:123
msgid "Mode"
msgstr "模式"

#: properties.py:297
msgid "Model Height"
msgstr "模型高度"

#: properties.py:303
msgid "Multiplier from mesh units to millimeters"
msgstr "网格单位到毫米的倍数"

#: properties.py:217
msgid "Narrowest piece that survives regardless of how long it is. Kept low: it is a guard against hair-thin slivers, not the main test. Floored at 0.10 mm, below which an exact threshold is not achievable"
msgstr "无论多长都能保留的最窄碎片。保持较低：它用于防止极细的碎片，并非主要判定。下限为 0.10 毫米，低于此值无法实现精确阈值"

#: operators.py:915
msgid "No advice row selected."
msgstr "未选择建议行。"

#: ui.py:115
msgid "Not optimized"
msgstr "未优化"

#: properties.py:161
msgid "Number Strips"
msgstr "为条带编号"

#: properties.py:126
msgid "One averaged gore shape repeated for every strip"
msgstr "每个条带都重复使用一个平均拼片形状"

#: properties.py:156
msgid "Outline Tolerance (mm)"
msgstr "轮廓容差（毫米）"

