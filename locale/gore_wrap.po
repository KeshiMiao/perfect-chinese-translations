msgstr "沿条带向上滑动图案"

#: properties.py:211
msgid "Smallest piece of material that survives weeding, transfer and the blast; the search avoids leaving anything smaller"
msgstr "能承受排废、转移和喷砂的最小材料碎片；搜索会避免留下更小的碎片"

#: properties.py:239
msgid "Smooth to Curves"
msgstr "平滑为曲线"

#: properties.py:151
msgid "Smoothing"
msgstr "平滑"

#: properties.py:230
msgid "Spin the pattern around the object (degrees); the tiling repeats every 360 / Repeats Around"
msgstr "让图案绕物体旋转（度）；平铺每隔 360 / 环绕重复次数 重复一次"

#: properties.py:139
msgid "Start Angle"
msgstr "起始角度"

#: properties.py:282
msgid "Stop the pattern short of the top of the object and close it off with a straight cut parallel to the bottom"
msgstr "让图案在物体顶部之前停止，并用平行于底部的直切收尾"

#: properties.py:115
msgid "Strip Angle"
msgstr "条带角度"

#: properties.py:110
