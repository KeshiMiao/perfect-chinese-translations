msgstr "手动设置容差和拐角角度"

#: properties.py:133
msgid "Signed edge allowance: positive overlaps neighbors, negative leaves a gap, zero is a butt joint"
msgstr "带符号的边缘余量：正值与相邻边缘重叠，负值留出间隙，零为对接"

#: properties.py:244
msgid "Simplify Mode"
msgstr "简化模式"

#: properties.py:257
