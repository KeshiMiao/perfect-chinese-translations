#: add-on-dynamic-render-border-v1.1.3/__init__.py:350
msgid "Scale the border horizontally (1.0 = original size). Useful to tighten or loosen the Fast method result"
msgstr "水平缩放边框（1.0 = 原始大小）。可用于收紧或放宽快速方法的结果"

#: add-on-dynamic-render-border-v1.1.3/__init__.py:362
msgid "Scale the border vertically (1.0 = original size). Useful to tighten or loosen the Fast method result"
msgstr "垂直缩放边框（1.0 = 原始大小）。可用于收紧或放宽快速方法的结果"

#: add-on-dynamic-render-border-v1.1.3/__init__.py:330
msgid "Shift the border horizontally. Negative = left, Positive = right"
msgstr "水平移动边框。负值 = 向左，正值 = 向右"

#: add-on-dynamic-render-border-v1.1.3/__init__.py:340
msgid "Shift the border vertically. Negative = down, Positive = up"
msgstr "垂直移动边框。负值 = 向下，正值 = 向上"

#: add-on-dynamic-render-border-v1.1.3/__init__.py:391
msgid "Target Source"
msgstr "目标来源"

#: add-on-dynamic-render-border-v1.1.3/__init__.py:395
msgid "Use a custom list of collections"
msgstr "使用自定义集合列表"

#: add-on-dynamic-render-border-v1.1.3/__init__.py:394
msgid "Use a custom list of objects"
msgstr "使用自定义物体列表"

#: add-on-dynamic-render-border-v1.1.3/__init__.py:377
msgid "Uses every vertex of the mesh. Most accurate, but can be slow on high-poly objects"
msgstr "使用网格的所有顶点。最精确，但在高面数物体上可能较慢"

#: add-on-dynamic-render-border-v1.1.3/__init__.py:382
msgid "Uses only the 8 corners of the object's bounding box. Much faster, but the border may be slightly larger than necessary"
msgstr "仅使用物体边界框的 8 个角点。速度快得多，但边框可能略大于所需范围"

