msgid "Complete filepath of the texture map"
msgstr "纹理贴图的完整文件路径"

#: substance_textures_importer/propertygroups.py:271
msgid "Creates a (pseudo) PBR nodetree to load images textures"
msgstr "创建（伪）PBR 节点树以加载图像纹理"

