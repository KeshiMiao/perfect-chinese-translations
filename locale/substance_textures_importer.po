#: substance_textures_importer/propertygroups.py:126
msgid "Active"
msgstr "活动"

#: substance_textures_importer/functions.py:684
msgid "All Objects materials"
msgstr "所有物体材质"

#: substance_textures_importer/functions.py:685
msgid "All scene materials"
msgstr "所有场景材质"

#: substance_textures_importer/functions.py:683
msgid "All visible Objects materials"
msgstr "所有可见物体材质"

#: substance_textures_importer/propertygroups.py:250
msgid "Allows Manual setup of the Maps filenames,                     \n  (Tick the checkbox between Map Name and Sockets                                         to enable manual file selection)"
msgstr "允许手动设置贴图文件名（勾选“贴图名称”和“接口”之间的复选框以启用手动文件选择）"

#: substance_textures_importer/propertygroups.py:158
msgid "Append your own Nodegroups in the 'Replace Shader' list above                     \n                    \n Allows to use Custom Shader nodes                    \n Custom NodeGroups must have a valid Surface Shader output socket                     \n and at least one input socket to appear in the list                     \n (Experimental !!!)"
msgstr "在上述“替换着色器”列表中追加自己的节点组。允许使用自定义着色器节点。自定义节点组必须具有有效的表面着色器输出接口和至少一个输入接口，才会出现在列表中（实验性！！！）"

#: substance_textures_importer/propertygroups.py:257
msgid "Apply on active material only,                         \n  (By default the script iterates through all materials                        \n  presents in the Material Slots.)                        \n Enable this to only use the active Material Slot."
msgstr "仅应用到活动材质（默认情况下脚本会遍历材质插槽中的所有材质）。启用此项以仅使用活动材质插槽。"

#: substance_textures_importer/functions.py:892
msgid "Assign Images"
msgstr "指定图像"

#: substance_textures_importer/propertygroups.py:265
msgid "Assign the images found in usr_dir to the corresponding nodes.                        \n The nodes should already be created for this to work.                         \n (Enable 'Setup Nodes' to create them at the same time)"
msgstr "将 usr_dir 中找到的图像指定给对应节点。节点应已创建才能生效。（启用“设置节点”以便同时创建它们）"

#: substance_textures_importer/propertygroups.py:116
msgid "Associated file exists"
msgstr "关联文件存在"

#: substance_textures_importer/functions.py:884
msgid "Attach Curves and Ramps"
msgstr "附加曲线和渐变"

#: substance_textures_importer/propertygroups.py:183
msgid "Attach RGB Curves and Color Ramps nodes                        \n                        \n Inserts a RGB Curve if the Texture map type is RGB                         \n or a Color ramp if the texture map type is Black & White                        \n between the Image texture node and the Shader Input Socket                        \n during Nodes Trees setup"
msgstr "附加 RGB 曲线和颜色渐变节点。在设置节点树时，如果纹理贴图类型为 RGB，则在图像纹理节点和着色器输入接口之间插入 RGB 曲线；如果为黑白，则插入颜色渐变。"

#: substance_textures_importer/propertygroups.py:103
msgid "Auto detect target shader socket"
msgstr "自动检测目标着色器接口"

#: substance_textures_importer/propertygroups.py:231
msgid "Base Shader node selector                         \n Used to select a replacement for the current Shader node                        \n if 'Replace Shader' is enabled or if no valid Shader node is detected."
msgstr "基础着色器节点选择器。用于在启用“替换着色器”或未检测到有效着色器节点时，为当前着色器节点选择替代项。"

#: substance_textures_importer/preferences.py:37
msgid "Check this option to show the Extension panel                                     in the Material Properties Panel.                                     \n It will remain available in the File menu                                     > Import > Substance Textures and via                                     \n F3 Search > Import Surfacing Textures"
msgstr "勾选此选项可在“材质属性”面板中显示扩展面板。它仍可通过“文件”菜单 > 导入 > Substance Textures 以及 F3 搜索 > Import Surfacing Textures 使用"

#: substance_textures_importer/propertygroups.py:169
msgid "Clear existing nodes                      \n Removes all nodes from the material shader                      \n before setting up the nodes trees"
msgstr "清除现有节点。在设置节点树之前，从材质着色器中移除所有节点。"

#: substance_textures_importer/functions.py:882
msgid "Clear nodes from material"
msgstr "从材质中清除节点"

