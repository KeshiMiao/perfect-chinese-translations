msgid "Export selected and visible objects only"
msgstr "仅导出选中且可见的物体"

#: Faster_FBX_Exporter/__init__.py:132
msgid "Export smoothing information (prefer 'Normals Only' option if your target importer understands custom normals)"
msgstr "导出平滑信息（如果目标导入器理解自定义法线，建议使用“仅法线”选项）"

