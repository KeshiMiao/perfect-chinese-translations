msgid "Add binormal and tangent vectors, together with normal they form the tangent space (will only work correctly with tris/quads only meshes!)"
msgstr "添加副法线和切线向量，与法线共同构成切线空间（仅在纯三角/四边面网格上才能正确工作！）"

#: Faster_FBX_Exporter/__init__.py:254
msgid "All Actions"
msgstr "所有动作"

#: Faster_FBX_Exporter/__init__.py:84
msgid "All Local"
msgstr "全部本地"

#: Faster_FBX_Exporter/__init__.py:261
msgid "Always add a keyframe at start and end of actions for animated channels"
msgstr "始终在动作的起始和结束处为动画通道插入关键帧"

#: Faster_FBX_Exporter/__init__.py:430
msgid "Animation"
msgstr "动画"

#: Faster_FBX_Exporter/__init__.py:189
msgid "Append a final bone to the end of each chain to specify last bone length (use this when you intend to edit the armature from exported data)"
msgstr "在每条链末端追加一根最终骨骼以指定最后一根骨骼的长度（当你打算用导出的数据编辑骨架时使用）"

#: Faster_FBX_Exporter/__init__.py:83
msgid "Apply Scalings"
msgstr "应用缩放"

#: Faster_FBX_Exporter/__init__.py:105
msgid "Apply Transform"
msgstr "应用变换"

#: Faster_FBX_Exporter/__init__.py:75
msgid "Apply Unit"
msgstr "应用单位"

#: Faster_FBX_Exporter/__init__.py:90
msgid "Apply custom scaling and units scaling to FBX scale"
msgstr "将自定义缩放和单位缩放应用到 FBX 缩放"

#: Faster_FBX_Exporter/__init__.py:84
msgid "Apply custom scaling and units scaling to each object transformation, FBX scale remains at 1.0"
msgstr "将自定义缩放和单位缩放应用到每个物体的变换，FBX 缩放保持为 1.0"

#: Faster_FBX_Exporter/__init__.py:88
msgid "Apply custom scaling to FBX scale, and units scaling to each object transformation"
msgstr "将自定义缩放应用到 FBX 缩放，将单位缩放应用到每个物体的变换"

#: Faster_FBX_Exporter/__init__.py:86
msgid "Apply custom scaling to each object transformation, and units scaling to FBX scale"
msgstr "将自定义缩放应用到每个物体的变换，将单位缩放应用到 FBX 缩放"

#: Faster_FBX_Exporter/__init__.py:99
msgid "Apply global space transform to the object rotations. When disabled only the axis space is written to the file and all object transforms are left as-is"
msgstr "将全局空间变换应用到物体旋转。禁用时仅将轴空间写入文件，所有物体变换保持原样"

#: Faster_FBX_Exporter/__init__.py:119
#: Faster_FBX_Exporter/__init__.py:417
msgid "Armature"
msgstr "骨架"

#: Faster_FBX_Exporter/__init__.py:222
msgid "Armature FBXNode Type"
msgstr "骨架 FBX 节点类型"

#: Faster_FBX_Exporter/__init__.py:105
msgid "Bake space transform into object data, avoids getting unwanted rotations to objects when target space is not aligned with Blender's space (WARNING! experimental option, use at own risk, known to be broken with armatures/animations)"
msgstr "将空间变换烘焙进物体数据，避免目标空间与 Blender 空间不一致时物体出现多余的旋转（警告！实验性选项，请自行承担风险，已知在骨架/动画上会出错）"

#: Faster_FBX_Exporter/__init__.py:233
msgid "Baked Animation"
msgstr "烘焙动画"

#: Faster_FBX_Exporter/__init__.py:286
msgid "Batch Mode"
msgstr "批量模式"

#: Faster_FBX_Exporter/__init__.py:300
msgid "Batch Own Dir"
msgstr "批量独立目录"

#: Faster_FBX_Exporter/__init__.py:117
msgid "Camera"
msgstr "摄像机"

#: Faster_FBX_Exporter/__init__.py:290
msgid "Collection"
msgstr "集合"

#: Faster_FBX_Exporter/__init__.py:179
msgid "Convert all faces to triangles"
msgstr "将所有面转换为三角形"

#: Faster_FBX_Exporter/__init__.py:300
msgid "Create a dir for each exported file"
msgstr "为每个导出的文件创建目录"

#: Faster_FBX_Exporter/__init__.py:184
msgid "Custom Properties"
msgstr "自定义属性"

#: Faster_FBX_Exporter/__init__.py:145
msgid "Do not export color attributes"
msgstr "不导出颜色属性"

#: Faster_FBX_Exporter/__init__.py:290
msgid "Each collection (data-block ones) as a file, does not include content of children collections"
msgstr "每个集合（数据块集合）导出为一个文件，不包含子集合的内容"

#: Faster_FBX_Exporter/__init__.py:295
msgid "Each collection (including master, non-data-block one) of the active scene as a file, including content from children collections"
msgstr "活动场景的每个集合（包括主集合，非数据块集合）导出为一个文件，包含子集合的内容"

#: Faster_FBX_Exporter/__init__.py:292
msgid "Each collection (including master, non-data-block ones) of each scene as a file, including content from children collections"
msgstr "每个场景的每个集合（包括主集合，非数据块集合）导出为一个文件，包含子集合的内容"

#: Faster_FBX_Exporter/__init__.py:289
msgid "Each scene as a file"
msgstr "每个场景导出为一个文件"

#: Faster_FBX_Exporter/__init__.py:136
msgid "Edge"
msgstr "边"

#: Faster_FBX_Exporter/__init__.py:281
msgid "Embed Textures"
msgstr "嵌入纹理"

#: Faster_FBX_Exporter/__init__.py:281
msgid "Embed textures in FBX binary file (only for \"Copy\" path mode!)"
msgstr "在 FBX 二进制文件中嵌入纹理（仅用于“复制”路径模式！）"

#: Faster_FBX_Exporter/__init__.py:116
msgid "Empty"
msgstr "空物体"

#: Faster_FBX_Exporter/__init__.py:233
msgid "Export baked keyframe animation"
msgstr "导出烘焙的关键帧动画"

#: Faster_FBX_Exporter/__init__.py:147
msgid "Export colors in linear color space"
msgstr "以线性色彩空间导出颜色"

