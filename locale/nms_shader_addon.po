#: __init__.py:1
msgid "Applies a flat, direction-based 'normal shading' material to selected objects (the Minecraft NMS render look), preserving the original texture's transparency."
msgstr "为选中物体应用基于方向的平面「法线着色」材质（Minecraft NMS 渲染风格），并保留原纹理的透明度。"

#: __init__.py:359
msgid "Apply to Collection"
msgstr "应用到集合"

#: __init__.py:359
msgid "Apply to every mesh in the active collection, or any collection selected in the Outliner (includes subcollections)"
msgstr "应用到活动集合中的每个网格，或在大纲视图中选中的任意集合（包含子集合）"

#: __init__.py:354
msgid "Automatically enable transparent film + RGBA output when applying the shader"
msgstr "应用着色器时自动启用透明胶片 + RGBA 输出"

#: __init__.py:399
msgid "Click a collection in the Outliner, then Apply."
msgstr "在大纲视图中点击一个集合，然后点击应用。"

#: __init__.py:349
msgid "Distinct hard color per face direction. Off = smooth raw normal gradient."
msgstr "每个面方向使用独立的硬色。关闭 = 平滑的原始法线渐变。"

#: __init__.py:404
msgid "Each object gets its own color order."
msgstr "每个物体使用各自的颜色顺序。"

#: __init__.py:349
msgid "Flat Candy Colors"
msgstr "平面糖果色"

