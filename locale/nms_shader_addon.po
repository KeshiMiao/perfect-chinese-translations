#: __init__.py:402
msgid "Overlay-layer transparency is kept automatically."
msgstr "叠加层透明度会自动保留。"

#: __init__.py:401
msgid "Select mesh objects, then click Apply."
msgstr "选择网格物体，然后点击应用。"

