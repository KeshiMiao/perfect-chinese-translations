msgstr "从指定集合导出"

#: omUlette main/omuExport.py:65
msgid "export only selected objects"
msgstr "仅导出选中物体"

#: omUlette main/omuExport.py:35
msgid "export the objects from this collection.."
msgstr "导出此集合中的物体。"

#: omUlette main/omuExport.py:23
msgid "export this action."
msgstr "导出此动作。"

#: omUlette main/omuExport.py:29
msgid "include this animation in it's own file"
msgstr "将此动画包含在单独文件中"

#: omUlette main/omuExport.py:29
msgid "include this animation in the \"main\" file"
msgstr "将此动画包含在“主”文件中"

