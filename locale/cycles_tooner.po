msgstr "不透明度"

#: __init__.py:66
#: operators_converter.py:1787
msgid "Opacity applied to selected toon materials"
msgstr "应用到所选卡通材质的不透明度"

#: __init__.py:104
msgid "Opacity for this CyclesTooner material"
msgstr "此 CyclesTooner 材质的不透明度"

#: __init__.py:84
#: operators_outline.py:1236
msgid "Outline Color"
msgstr "描边颜色"

#: __init__.py:94
#: operators_outline.py:1278
