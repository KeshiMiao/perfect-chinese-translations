msgstr "将卡通材质转换为 Toon BSDF 并管理 Cycles 的描边"

#: __init__.py:11
#: ui.py:16
msgid "CyclesTooner"
msgstr "CyclesTooner"

#: __init__.py:131
#: ui.py:68
msgid "Emission"
msgstr "自发光"

#: __init__.py:138
#: ui.py:70
msgid "Emission Factor"
msgstr "自发光系数"

#: __init__.py:138
msgid "How much of the Emission shader is mixed in. 0 keeps the Toon shading and 1 shows the unshaded color"
msgstr "混合多少自发光着色器。0 保留卡通着色，1 显示无着色颜色"

#: __init__.py:11
msgid "Material"
msgstr "材质"

#: __init__.py:131
msgid "Mix an Emission shader into this CyclesTooner material so that it keeps its color in shade"
msgstr "将自发光着色器混合到此 CyclesTooner 材质，使其在阴影中保持颜色"

#: __init__.py:124
#: ui.py:67
msgid "No Shadow"
msgstr "无阴影"

#: __init__.py:66
#: __init__.py:104
