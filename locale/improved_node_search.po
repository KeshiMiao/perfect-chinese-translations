#: node_search/search.py:315
msgid "\"Search in Attributes\""
msgstr "“在属性中搜索”"

#: node_search/search.py:327
msgid "\"Search in Sockets\""
msgstr "“在插槽中搜索”"

#: node_search/search.py:302
msgid "\"Search\""
msgstr "“搜索”"

#: node_search/search.py:310
msgid "- Exact match option will match the whole string, otherwise partial matches are found."
msgstr "- 精确匹配选项将匹配整个字符串，否则会查找部分匹配。"

#: node_search/search.py:309
msgid "- Make sure to handle special characters properly in regex mode."
msgstr "- 请确保在正则表达式模式下正确处理特殊字符。"

#: node_search/search.py:311
msgid "- Match case option makes the search case sensitive."
msgstr "- 区分大小写选项使搜索区分大小写。"

#: node_search/search.py:317
msgid "- Provide the attribute name in the 'Attribute Search' field."
msgstr "- 在“属性搜索”字段中填写属性名称。"

#: node_search/search.py:329
msgid "- Provide the socket name or type in the 'Socket Search' field."
msgstr "- 在“插槽搜索”字段中填写插槽名称或类型。"

#: node_search/search.py:320
#: node_search/search.py:333
msgid "- This adds an additional filter on top of the main search criteria, allowing more refined search."
msgstr "- 这会在主搜索条件之上增加额外筛选，可实现更精细的搜索。"

#: node_search/search.py:321
msgid "- To search only by attribute, disable search options in nodes' 'Search in Name', 'Search in Label', etc."
msgstr "- 若仅按属性搜索，请关闭节点中的“在名称中搜索”“在标签中搜索”等搜索选项。"

#: node_search/search.py:334
msgid "- To search only by sockets, disable search options in nodes' 'Search in Name', 'Search in Label', etc."
msgstr "- 若仅按插槽搜索，请关闭节点中的“在名称中搜索”“在标签中搜索”等搜索选项。"

#: node_search/search.py:316
msgid "- Toggle 'Search in Attributes' to filter nodes that use a specific attribute name."
msgstr "- 开启“在属性中搜索”可按使用了特定属性名称来筛选节点。"

#: node_search/search.py:328
msgid "- Toggle 'Search in Sockets' to filter nodes by their sockets."
msgstr "- 开启“在插槽中搜索”可按节点的插槽筛选节点。"

#: node_search/search.py:303
msgid "- Type your search term and choose what to search in (Name, Label, Node Type)."
msgstr "- 输入搜索词并选择搜索范围（名称、标签、节点类型）。"

#: node_search/search.py:330
msgid "- Use the toggles to specify whether to search by socket name, type, in inputs or in outputs."
msgstr "- 使用开关指定按插槽名称、类型、输入或输出搜索。"

#: node_search/search.py:304
msgid "- You can also enable special filters to find disconnected nodes, unused nodes"
msgstr "- 你也可以启用特殊筛选来查找未连接的节点、未使用的节点"

#: node_search/search.py:308
msgid "- You can use regular expressions by toggling the regex option."
msgstr "- 开启正则表达式选项即可使用正则表达式。"

#: node_search/search.py:307
msgid "Additional options"
msgstr "附加选项"

#: node_search/prefs.py:35
msgid "Attenuation of the border color"
msgstr "边框颜色的衰减"

#: node_search/prefs.py:101
msgid "Attribute Search"
msgstr "属性搜索"

#: node_search/prefs.py:35
msgid "Border Attenuation"
msgstr "边框衰减"

#: node_search/prefs.py:43
msgid "Border Size (px)"
msgstr "边框大小（像素）"

#: node_search/search.py:319
#: node_search/search.py:332
msgid "Combination with other search options"
msgstr "与其他搜索选项的组合"

#: node_search/search.py:642
msgid "Display"
msgstr "显示"

#: node_search/prefs.py:20
msgid "Exact Match"
msgstr "精确匹配"

#: node_search/prefs.py:25
msgid "Highlight Color"
msgstr "高亮颜色"

#: node_search/prefs.py:25
msgid "Highlight color of the found nodes overlay"
msgstr "找到的节点叠加层的高亮颜色"

#: node_search/prefs.py:43
msgid "How large is the attenuated border in pixels"
msgstr "衰减边框的大小（像素）"

#: node_search/prefs.py:96
msgid "If toggled, \"Attribute Search\" will be used to filter nodes by usage of specified attribute name"
msgstr "若开启，将使用“属性搜索”按指定属性名称的使用情况筛选节点"

#: node_search/prefs.py:107
msgid "If toggled, \"Socket Search\" will be used to filter nodes by their sockets"
msgstr "若开启，将使用“插槽搜索”按节点的插槽筛选节点"

#: node_search/prefs.py:121
msgid "If toggled, the \"Socket Search\" will include socket names"
msgstr "若开启，“插槽搜索”将包含插槽名称"

#: node_search/prefs.py:116
msgid "If toggled, the \"Socket Search\" will include socket types"
msgstr "若开启，“插槽搜索”将包含插槽类型"

#: node_search/prefs.py:79
msgid "If toggled, the search will include nodes that are not connected to anything"
msgstr "若开启，搜索将包含未连接到任何内容的节点"

#: node_search/prefs.py:84
msgid "If toggled, the search will include nodes that have missing images"
msgstr "若开启，搜索将包含图像缺失的节点"

#: node_search/prefs.py:89
msgid "If toggled, the search will include nodes that have missing node groups"
msgstr "若开启，搜索将包含节点组缺失的节点"

#: node_search/prefs.py:20
msgid "If toggled, then only exact matches of the input will be searched"
msgstr "若开启，则仅搜索与输入完全匹配的内容"

#: node_search/prefs.py:15
msgid "If toggled, then the search will be case sensitive"
msgstr "若开启，则搜索区分大小写"

#: node_search/prefs.py:10
msgid "If toggled, then the search will be done using regular expressions"
msgstr "若开启，则使用正则表达式进行搜索"

#: node_search/prefs.py:72
msgid "If toggled, then we will search also the inside of node groups in current node tree"
msgstr "若开启，还会搜索当前节点树中节点组的内部"

#: node_search/prefs.py:62
msgid "If toggled, then what is in \"Search\" will be searched in node \"Label\""
msgstr "若开启，“搜索”中的内容将在节点的“标签”中搜索"

#: node_search/prefs.py:57
msgid "If toggled, then what is in \"Search\" will be searched in node \"Name\""
msgstr "若开启，“搜索”中的内容将在节点的“名称”中搜索"

#: node_search/prefs.py:67
msgid "If toggled, then what is in \"Search\" will be searched in node \"Node Type\" (.bl_idname)"
msgstr "若开启，“搜索”中的内容将在节点的“节点类型”（.bl_idname）中搜索"

