msgstr "PLAGALYS 钢琴键盘"

#: __init__.py:278
msgid "Palette"
msgstr "调色板"

#: __init__.py:250
msgid "Parent object of the keys. Use New Keyboard, or Make Playable on your own model"
msgstr "琴键的父级物体。使用「新建键盘」，或对自有模型使用「设为可演奏」"

#: __init__.py:524
msgid "Piano MIDI Player"
msgstr "钢琴 MIDI 播放器"

#: keyboard_tools.py:237
msgid "Pivot at the Back of Each Key"
msgstr "轴心位于每个琴键的后端"

#: __init__.py:258
msgid "Press Depth (mm)"
msgstr "按下深度 (mm)"

#: __init__.py:264
msgid "Release (frames)"
msgstr "松开 (帧)"

#: __init__.py:284
msgid "Right Hand / Main"
msgstr "右手 / 主"

#: keyboard_tools.py:257
msgid "Select at least one octave of key objects (one object per key)"
msgstr "至少选择一个八度的琴键物体（每个琴键一个物体）"

#: __init__.py:294
msgid "Shift every note up or down. 12 = one octave"
msgstr "将所有音符上移或下移。12 = 一个八度"

#: __init__.py:274
msgid "Single Color"
msgstr "单色"

#: __init__.py:256
msgid "Skip Leading Silence"
msgstr "跳过开头静音"

#: __init__.py:266
msgid "Small changes of depth only, a millimetre at most: a slight bounce when the key lands, soft notes a little less deep, held keys rising slightly. Timing and notes are never changed, and the result is the same at every Regenerate"
msgstr "仅在深度上做微小变化，最多一毫米：琴键落下时轻微回弹，轻音稍浅一些，保持的音符略微回升。时间与音符永不改变，每次重新生成的结果都相同"

#: __init__.py:262
msgid "Soft Note Press (frames)"
msgstr "轻音按下 (帧)"

#: __init__.py:273
msgid "Split at the note below: left hand / right hand"
msgstr "在下方音符处拆分：左手 / 右手"

#: __init__.py:254
msgid "Start Frame"
msgstr "起始帧"

#: __init__.py:288
msgid "Strength"
msgstr "强度"

#: __init__.py:268
msgid "Strength of Bounce and Settle. 1 = realistic, 2 = exaggerated"
msgstr "回弹与稳定强度。1 = 真实，2 = 夸张"

#: keyboard_tools.py:253
msgid "Switch to Object Mode first"
msgstr "请先切换到物体模式"

#: keyboard_tools.py:276
msgid "The black/white pattern of the selection does not look like a piano keyboard (one object per key, keyboard along X, black keys higher or shorter)"
msgstr "选中的黑白分布看起来不像钢琴键盘（每个琴键一个物体，键盘沿 X 轴，黑键更高或更短）"

#: __init__.py:264
msgid "Time for the key spring to bring the key back up"
msgstr "琴键弹簧使琴键回弹所需的时间"

#: __init__.py:253
#: __init__.py:275
msgid "Track"
msgstr "轨道"

#: __init__.py:294
msgid "Transpose (semitones)"
msgstr "移调 (半音)"

#: __init__.py:292
msgid "Transpose notes outside the keyboard to the nearest octave instead of dropping them"
msgstr "将键盘范围之外的音符移调至最近的八度，而不是丢弃"

#: __init__.py:283
msgid "Your own colors below"
msgstr "下方自定义颜色"

