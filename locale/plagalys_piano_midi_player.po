msgid "MIDI"
msgstr "MIDI"

#: __init__.py:252
msgid "MIDI File"
msgstr "MIDI 文件"

#: __init__.py:567
msgid "MIDI Options"
msgstr "MIDI 选项"

#: keyboard_tools.py:235
msgid "MIDI number of the leftmost key. 21 = A0, 28 = E1, 36 = C2, 60 = middle C"
msgstr "最左侧琴键的 MIDI 编号。21 = A0，28 = E1，36 = C2，60 = 中央 C"

#: __init__.py:282
msgid "Monochrome"
msgstr "单色"

#: __init__.py:281
msgid "Neon"
msgstr "霓虹"

#: __init__.py:543
#: keyboard_tools.py:370
msgid "New Keyboard"
msgstr "新建键盘"

#: __init__.py:280
msgid "Night blue and copper, the PLAGALYS colors"
msgstr "夜蓝与铜色，PLAGALYS 配色"

#: __init__.py:314
msgid "No playable keys under the active object: select its keys and use Make Playable"
msgstr "活动物体下没有可演奏的琴键：选中其琴键并使用「设为可演奏」"

#: __init__.py:583
msgid "Note Range"
msgstr "音符范围"

#: __init__.py:276
msgid "Notes below go to the left-hand color. 60 = C4, middle C (shown as C3 on some brands, e.g. Yamaha)"
msgstr "低于此值的音符使用左手颜色。60 = C4，即中央 C（某些品牌如 Yamaha 显示为 C3）"

#: __init__.py:274
msgid "One color for every note"
msgstr "所有音符使用同一种颜色"

#: __init__.py:282
msgid "One warm color"
msgstr "单一暖色"

