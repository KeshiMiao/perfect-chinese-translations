#: __init__.py:473
msgctxt "Operator"
msgid "Remove the key animation and put every key back up"
msgstr "移除琴键动画并将所有琴键复位"

#: __init__.py:323
msgctxt "Operator"
msgid "Replace the key animation with the notes of the MIDI file"
msgstr "用 MIDI 文件的音符替换琴键动画"

#: keyboard_tools.py:226
msgctxt "Operator"
msgid "Turn the selected key objects of any piano model into a playable keyboard: sorts them left to right, tells black from white keys, assigns MIDI notes and moves each pivot to the back of its key. Linked duplicates and rotated imports (FBX, OBJ, glTF) are fixed on the way"
msgstr "将任意钢琴模型的选中琴键物体转换为可演奏键盘：从左到右排序，区分黑键与白键，分配 MIDI 音符，并将每个轴心移到其琴键后端。链接副本和旋转过的导入（FBX、OBJ、glTF）会一并修正"

#: __init__.py:306
msgctxt "Operator"
msgid "Use Selected"
msgstr "使用选中项"

#: __init__.py:307
msgctxt "Operator"
msgid "Use the active object (or its parent) as the keyboard"
msgstr "使用活动物体（或其父级）作为键盘"
