msgstr "淡出（帧）"

#: keyboard_tools.py:232
msgid "Find the lowest note from the number of keys and the black/white pattern (88 keys start on A0, 73 on E1, 61 on C2)"
msgstr "根据琴键数量和黑白键排列推算最低音（88 键从 A0 开始，73 键从 E1，61 键从 C2）"

#: __init__.py:292
msgid "Fit Notes to Keyboard"
msgstr "将音符适配到键盘"

#: __init__.py:254
msgid "Frame where the MIDI starts (the first note, if Skip Leading Silence is on)"
msgstr "MIDI 起始帧（若启用「跳过前导静音」，则为第一个音符）"

#: __init__.py:260
msgid "Frames a key takes to go down on the loudest notes (velocity 127)"
msgstr "最响音符（力度 127）按下琴键所需的帧数"

#: __init__.py:262
msgid "Frames a key takes to go down on the softest notes (velocity 1)"
msgstr "最轻音符（力度 1）按下琴键所需的帧数"

#: __init__.py:270
#: __init__.py:588
msgid "Glow on Press"
msgstr "按下时发光"

#: keyboard_tools.py:232
msgid "Guess Lowest Note"
msgstr "推测最低音"

#: __init__.py:276
msgid "Hand Split"
msgstr "手部分割"

#: __init__.py:286
msgid "How long the color takes to fade out after the note ends. 0 = off at once; higher values leave a trail on fast passages"
msgstr "音符结束后颜色淡出所需的时间。0 = 立即熄灭；数值越大，快速段落会留下拖尾"

#: __init__.py:290
msgid "How much the key surface itself takes the glow color (0 = light only, 1 = fully colored key)"
msgstr "琴键表面本身染上辉光颜色的程度（0 = 仅发光，1 = 琴键完全着色）"

#: __init__.py:256
msgid "Ignore the silence before the first note. DAWs like Logic export a region at its position in the project, so a part at bar 30 would otherwise start a minute late"
msgstr "忽略第一个音符之前的静音。Logic 等 DAW 会按工程中的位置导出片段，否则第 30 小节的段落会延迟一分钟才开始"

#: __init__.py:573
msgid "Key Motion"
msgstr "琴键运动"

#: __init__.py:290
msgid "Key Tint"
msgstr "琴键着色"

#: keyboard_tools.py:189
msgid "Key bed and cheeks"
msgstr "键盘底板与侧板"

#: __init__.py:250
msgid "Keyboard"
msgstr "键盘"

#: keyboard_tools.py:187
msgid "Keys"
msgstr "琴键"

#: keyboard_tools.py:237
msgid "Keys rotate around their origin. Moves each origin to the back-bottom edge of the key (keyboard facing -Y, the player's side)"
msgstr "琴键绕各自原点旋转。将每个原点移到琴键后下方边缘（键盘朝向 -Y，即演奏者一侧）"

#: __init__.py:273
msgid "Left / Right Hand"
msgstr "左手 / 右手"

#: __init__.py:285
msgid "Left Hand"
msgstr "左手"

#: __init__.py:270
msgid "Light up pressed keys, piano-tutorial style (adds a small emission setup to the key materials)"
msgstr "点亮被按下的琴键，类似钢琴教学视频（为琴键材质添加小型自发光设置）"

#: __init__.py:260
msgid "Loud Note Press (frames)"
msgstr "强音按下（帧）"

#: keyboard_tools.py:235
msgid "Lowest Note (MIDI)"
msgstr "最低音（MIDI）"

