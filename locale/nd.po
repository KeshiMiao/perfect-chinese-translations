#: ND/bevels/bevel.py:50
msgid "Adds a bevel modifier to the selected object\nCTRL — Remove existing modifiers\nSHIFT — Create a stacked bevel modifier"
msgstr "为选中物体添加倒角修改器\nCTRL — 移除现有修改器\nSHIFT — 创建堆叠的倒角修改器"

#: ND/deform/lattice.py:49
msgid "Adds a lattice modifier to the selected object\nCTRL — Remove existing modifiers"
msgstr "为选中物体添加晶格修改器\nCTRL — 移除现有修改器"

#: ND/scene/flare.py:43
msgid "Adds a new lighting rig targeting selected objects position"
msgstr "添加新的灯光装置，以选中物体的位置为目标"

#: ND/extrusion/screw.py:52
msgid "Adds a screw modifier tuned for converting a sketch into a cylindrical object\nCTRL — Remove existing modifiers"
msgstr "添加经过调校的螺旋修改器，用于将草图转换为圆柱形物体\nCTRL — 移除现有修改器"

#: ND/extrusion/solidify.py:50
msgid "Adds a solidify modifier, and enables smoothing\nCTRL — Remove existing modifiers"
msgstr "添加实体化修改器并启用平滑\nCTRL — 移除现有修改器"

#: ND/sketch/circularize.py:49
msgid "Adds a vertex bevel operator to the selected plane to convert it into a circular shape\nCTRL — Remove existing modifiers"
msgstr "为选中平面添加顶点倒角操作，使其转换为圆形\nCTRL — 移除现有修改器"

#: ND/bevels/vertex_bevel.py:50
msgid "Adds a vertex group bevel and weld modifier\nSHIFT — Place modifiers at the bottom of the stack\nALT — Create a vertex group edge bevel\nCTRL — Remove existing modifiers"
msgstr "添加顶点组倒角和焊接修改器\nSHIFT — 将修改器置于堆栈底部\nALT — 创建顶点组边倒角\nCTRL — 移除现有修改器"

#: ND/bevels/edge_bevel.py:49
msgid "Adds a weighted edge bevel modifier to the selected object\nSHIFT — Place modifiers at the top of the stack\nCTRL — Remove existing modifiers"
msgstr "为选中物体添加加权边倒角修改器\nSHIFT — 将修改器置于堆栈顶部\nCTRL — 移除现有修改器"

#: ND/bevels/bevel_resolution.py:41
msgid "Adjust all bevel resolutions for the selected objects"
msgstr "调整选中物体的所有倒角分辨率"

#: ND/utils/snap_align.py:44
msgid "Align and snap one object to another"
msgstr "将一个物体对齐并吸附到另一个物体"

#: ND/viewport/silhouette.py:39
msgid "Apply flat black shading all objects in the viewport to help assess thier silhouette"
msgstr "为视图中的所有物体应用纯黑平直着色，以帮助评估轮廓"

#: ND/replicate/circular_array.py:53
msgid "Array an object around another in a circular fashion\nALT — Use faux origin (for origin-reliant procedural geometry)\nCTRL — Remove existing modifiers"
msgstr "让一个物体以环形方式围绕另一个物体阵列\nALT — 使用伪原点（适用于依赖原点的程序化几何体）\nCTRL — 移除现有修改器"

#: ND/replicate/array_cubed.py:55
msgid "Array an object in up to three dimensions\nCTRL — Remove existing modifiers"
msgstr "在最多三个维度上阵列物体\nCTRL — 移除现有修改器"

#: ND/replicate/array_cubed.py:54
msgid "Array³"
msgstr "阵列³"

#: ND/utils/sync_modifiers.py:161
