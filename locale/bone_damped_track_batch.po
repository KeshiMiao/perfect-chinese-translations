#: __init__.py:756
msgid "Add constraints to all matching bones in the armature"
msgstr "为骨架中所有匹配的骨骼添加约束"

#: __init__.py:756
msgid "All Bones"
msgstr "所有骨骼"

#: __init__.py:1
msgid "Animation"
msgstr "动画"

#: __init__.py:745
msgid "Base influence value (0-1) for each bone's Damped Track constraint. Higher = bones follow their child tightly (less swing); lower = looser (more swing). Combined with gradient modes for root-stiff / tip-soft results."
msgstr "每根骨骼的阻尼追踪约束的基础影响值（0-1）。数值越高 = 骨骼紧密跟随其子级（摆动更少）；数值越低 = 更松弛（摆动更多）。与渐变模式结合可获得根部僵硬/末端柔软的效果。"

#: __init__.py:1
msgid "Batch-add Damped Track constraints with gradient influence"
msgstr "批量添加带渐变影响的阻尼追踪约束"

#: __init__.py:670
msgid "Bone Damped Track"
msgstr "骨骼阻尼追踪"

#: __init__.py:1
msgid "Bone Damped Track Batch"
msgstr "骨骼阻尼追踪批量"

#: __init__.py:674
msgid "Bone Tools"
msgstr "骨骼工具"

#: __init__.py:695
msgid "Bone name / MMD JP-EN names containing any keyword match; comma-separated"
msgstr "骨骼名 / MMD 日文-英文名包含任一关键词；用逗号分隔"

#: __init__.py:820
msgid "Cloth/Hair Keywords"
msgstr "布料/头发关键词"

#: __init__.py:831
msgid "Comma-separated name keywords; bones whose names contain any of them are added even if the filter missed them. Use Preview to verify."
msgstr "逗号分隔的名称关键词；名称包含任一关键词的骨骼将被添加，即使过滤器漏掉了它们。使用预览验证。"

#: __init__.py:837
msgid "Comma-separated name keywords; bones whose names contain any of them are removed even if the filter matched them (e.g. 足,腿,foot,leg). Use Preview to verify."
msgstr "逗号分隔的名称关键词；名称包含任一关键词的骨骼将被移除，即使过滤器匹配了它们（例如 足,腿,foot,leg）。使用预览验证。"

#: __init__.py:825
msgid "Comma-separated; a bone matches if its name, MMD Japanese name or MMD English name contains any keyword"
msgstr "逗号分隔；如果骨骼名称、MMD 日文名或 MMD 英文名包含任一关键词，则匹配"

#: __init__.py:781
msgid "Constant change from start to end value"
msgstr "从起始值到结束值恒定变化"

#: __init__.py:767
msgid "Decrease"
msgstr "递减"

#: __init__.py:768
msgid "Distribute influence by each chain's total length, from start to end influence, regardless of chain length"
msgstr "无论链长度如何，按每条链的总长度分配影响，从起始影响到结束影响"

#: __init__.py:782
msgid "Ease In"
msgstr "缓入"

#: __init__.py:783
msgid "Ease Out"
msgstr "缓出"

#: __init__.py:721
#: __init__.py:778
msgid "Easing"
msgstr "缓动"

#: __init__.py:773
msgid "End Influence"
msgstr "结束影响"

#: __init__.py:720
msgid "End influence"
msgstr "结束影响"

#: __init__.py:783
msgid "Fast near the root, slower toward the tip"
msgstr "靠近根部快，越靠近末端越慢"

#: __init__.py:815
msgid "Filter"
msgstr "过滤器"

#: __init__.py:796
msgid "First Child"
msgstr "第一个子级"

#: __init__.py:715
#: __init__.py:762
msgid "Gradient Mode"
msgstr "渐变模式"

#: __init__.py:697
msgid "Green = has constraints (non-IK); constrained leg bones also match"
msgstr "绿色 = 有约束（非 IK）；带约束的腿部骨骼也会匹配"

#: __init__.py:766
msgid "Increase"
msgstr "递增"

#: __init__.py:766
msgid "Influence += step for each level down the chain"
msgstr "沿链每下降一级，影响 += 步长"

#: __init__.py:767
msgid "Influence -= step for each level down the chain"
msgstr "沿链每下降一级，影响 -= 步长"

#: __init__.py:773
msgid "Influence at the chain tip in Proportional mode (default 0; raise it to keep tips from going fully loose)"
msgstr "比例模式下链末端的影响值（默认 0；提高它可防止末端完全松弛）"

#: __init__.py:789
msgid "Influence change per level down the chain in Increase/Decrease mode. Larger step = faster gradient; for long chains prefer Proportional mode."
msgstr "递增/递减模式下沿链每下降一级的影响变化量。步长越大 = 渐变越快；长链建议使用比例模式。"

