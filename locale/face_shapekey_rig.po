msgid "뷰포트 컨트롤러 삭제"
msgstr "删除视图控制器"

#: face_shapekey_rig/operators.py:1820
msgctxt "Operator"
msgid "뷰포트 패널 리로드"
msgstr "重新加载视图面板"

#: face_shapekey_rig/eye.py:7339
msgctxt "Operator"
msgid "뷰포트에 시선 패드(눈동자 컨트롤러)를 만들거나 다시 만들거나 지웁니다"
msgstr "在视图中创建、重建或删除视线板（眼球控制器）"

#: face_shapekey_rig/operators.py:1970
msgctxt "Operator"
msgid "뷰포트에 크로스헤어가 나타납니다. 클릭한 위치에 패널이 생성되고, 이미 있으면 패널 전체가 그곳으로 이동합니다. 우클릭/ESC = 취소"
msgstr "视图中会出现十字准线。点击位置将创建面板；若已存在，整个面板会移动到该处。右键/ESC = 取消"

#: face_shapekey_rig/preset_vp.py:639
msgctxt "Operator"
msgid "뷰포트에 표정 목록 컨트롤러를 만들거나 다시 만들거나 지웁니다. 손잡이를 끌어 표정을 고릅니다"
msgstr "在视图中创建、重建或删除表情列表控制器。拖动把手选择表情"

#: face_shapekey_rig/face_ui.py:293
msgctxt "Operator"
msgid "뷰포트에서 얼굴 캔버스 위를 클릭해 이 마커의 위치를 정합니다 (정면 뷰 권장)"
msgstr "在视图中点击脸部画布来设定此标记的位置（建议使用正视图）"

#: face_shapekey_rig/operators.py:2681
msgctxt "Operator"
msgid "뷰포트에서 이 컨트롤러를 선택합니다 (배치 모드면 틀을 선택)"
msgstr "在视图中选择此控制器（若在摆放模式则选择框）"

#: face_shapekey_rig/face_ui.py:4547
msgctxt "Operator"
msgid "뷰포트에서 자유 변형"
msgstr "在视图中自由变形"

#: face_shapekey_rig/face_ui.py:3054
msgctxt "Operator"
msgid "뷰포트에서 자유 변형 (Ctrl+T)"
msgstr "在视图中自由变形（Ctrl+T）"

#: face_shapekey_rig/operators.py:3557
msgctxt "Operator"
msgid "브라우저에 전용 립싱크 편집기를 엽니다. 파형과 모음 구간을 보며 구간을 클릭해 A/I/U/E/O를 바꾸고, 적용을 누르면 Blender에 다시 굽습니다"
msgstr "在浏览器中打开专用口型同步编辑器。查看波形和元音区间，点击区间切换 A/I/U/E/O，点击应用即可重新烘焙到 Blender"

#: face_shapekey_rig/operators.py:265
msgctxt "Operator"
msgid "상/하/좌/우 방향별로 셰이프 키를 연결한 XY 패드를 추가합니다. 같은 키를 상+하(또는 좌+우)에 넣으면 -1~1 풀레인지로 동작합니다"
msgstr "添加按上/下/左/右方向分别连接形态键的 XY 板。若同一键放入上+下（或左+右），则以 -1~1 全域范围运作"

#: face_shapekey_rig/face_ui.py:2157
msgctxt "Operator"
msgid "새 캔버스 만들기"
msgstr "新建画布"

#: face_shapekey_rig/operators.py:1685
msgctxt "Operator"
msgid "새 컬렉션을 만듭니다. 체크한 컨트롤러가 있으면 바로 담습니다"
msgstr "新建集合。若有勾选的控制器则直接放入"

#: face_shapekey_rig/eye.py:6295
msgctxt "Operator"
msgid "새 파츠 레이어를 맨 앞에 추가합니다"
msgstr "在最前面添加新部件图层"

#: face_shapekey_rig/eye.py:6324
msgctxt "Operator"
msgid "새 폴더"
msgstr "新建文件夹"

#: face_shapekey_rig/eye.py:6499
msgctxt "Operator"
msgid "새 폴더 (지금 보이는 파츠로)"
msgstr "新建文件夹（使用当前可见的部件）"

#: face_shapekey_rig/eye.py:7220
msgctxt "Operator"
msgid "색조/채도/명도 계산"
msgstr "计算色相/饱和度/明度"

#: face_shapekey_rig/eye.py:7203
msgctxt "Operator"
msgid "색조/채도/명도 초기화"
msgstr "重置色相/饱和度/明度"

#: face_shapekey_rig/operators.py:1746
msgctxt "Operator"
msgid "선택 → 컬렉션"
msgstr "选择 → 集合"

#: face_shapekey_rig/eye.py:5366
msgctxt "Operator"
msgid "선택 영역 수정"
msgstr "编辑选区"

#: face_shapekey_rig/eye.py:5226
msgctxt "Operator"
msgid "선택 영역 적용"
msgstr "应用选区"

#: face_shapekey_rig/eye.py:4710
msgctxt "Operator"
msgid "선택한 눈 데칼 메시에 파츠 레이어 합성 머티리얼을 만듭니다"
msgstr "为选中的眼睛贴花网格创建部件图层合成材质"

#: face_shapekey_rig/face_ui.py:2003
msgctxt "Operator"
msgid "선택한 메시 추가"
msgstr "添加选中的网格"

#: face_shapekey_rig/eye.py:6052
msgctxt "Operator"
msgid "선택한 메시(얼굴·머리카락·모자 등)를 카메라 시선 방향으로 눌러 2D 그림처럼 보이게 합니다. 캔버스 파츠도 같이 눌립니다. 렌더 카메라 기준 연출"
msgstr "沿相机视线方向压平选中的网格（脸部、头发、帽子等），使其看起来像 2D 画面。画布部件也会一同压平。按渲染相机进行设置"

#: face_shapekey_rig/operators.py:2304
msgctxt "Operator"
msgid "선택한 본의 위치/회전/크기를 지웁니다. 캐릭터 본과 함께 선택된 Face Rig 컨트롤러(FP_…)는 그대로 둡니다. 컨트롤러만 선택했을 때는 평소처럼 지웁니다"
msgstr "清除选中骨骼的位置/旋转/缩放。与角色骨骼一起选中的 Face Rig 控制器（FP_…）保持不变。仅选中控制器时，按常规清除"

#: face_shapekey_rig/operators.py:142
msgctxt "Operator"
msgid "선택한 셰이프 키를 조절하는 1D 슬라이더를 추가합니다"
msgstr "为选中的形态键添加 1D 滑块用于调节"

#: face_shapekey_rig/atlas.py:2968
msgctxt "Operator"
msgid "선택한 오브젝트(입/눈 데칼 등)에 격자 이미지 칸 전환을 추가합니다"
msgstr "为选中物体（嘴/眼贴花等）添加网格图像单元格切换"

#: face_shapekey_rig/operators.py:3782
msgctxt "Operator"
msgid "선택한 재생 오디오를 제거합니다 (시퀀서 스트립만 해당). 립싱크 데이터는 그대로 남습니다"
msgstr "移除选中的播放音频（仅限序列编辑器片段）。口型同步数据保持不变"

#: face_shapekey_rig/eye.py:6325
msgctxt "Operator"
msgid "선택한 파츠 자리에 폴더를 만들고 그 파츠를 넣습니다. 같은 태그·같은 자리의 폴더끼리는 하나만 켜져서, 예를 들어 '일반 눈'과 '폭소 눈' 폴더를 눈 하나로 전환할 수 있습니다"
msgstr "在选中部件的位置创建文件夹并将该部件放入其中。相同标签、相同位置的文件夹中只会启用一个，例如可用一只眼睛在“普通眼”和“大笑眼”文件夹之间切换"

#: face_shapekey_rig/eye.py:6606
msgctxt "Operator"
msgid "선택한 파츠를 그림·값·키프레임까지 똑같이 복제해 바로 위에 놓습니다 (이름 뒤에 .001)"
msgstr "完全复制选中部件（包括图像、数值和关键帧）并放在其正上方（名称后加 .001）"

#: face_shapekey_rig/layer_vp.py:1304
msgctxt "Operator"
msgid "성능 측정"
msgstr "性能测量"

#: face_shapekey_rig/layer_vp.py:1341
msgctxt "Operator"
msgid "성능 측정 (8초)"
msgstr "性能测量（8 秒）"

#: face_shapekey_rig/operators.py:1588
msgctxt "Operator"
msgid "셰이프 키 베이크 (익스포트용)"
msgstr "烘焙形态键（用于导出）"

#: face_shapekey_rig/operators.py:1867
msgctxt "Operator"
msgid "셰이프 키 이름 동기화"
msgstr "同步形态键名称"

#: face_shapekey_rig/operators.py:3237
msgctxt "Operator"
msgid "셰이프 키 이름과 ARKit 이름을 비교해 매핑을 자동으로 채웁니다 (기존 매핑은 교체). 눈동자 패드 등은 수동으로 추가하세요"
msgstr "将形态键名称与 ARKit 名称比较并自动填充映射（替换现有映射）。瞳孔垫片等请手动添加"

#: face_shapekey_rig/operators.py:1868
msgctxt "Operator"
msgid "셰이프 키 이름을 바꾼 뒤 실행하세요. 드라이버가 실제로 연결된 키 이름을 읽어 목록/메타데이터를 갱신합니다"
msgstr "重命名形态键后运行。会读取驱动器实际连接的键名称并更新列表/元数据"

#: face_shapekey_rig/eye.py:6818
msgctxt "Operator"
msgid "순서 바꾸기"
msgstr "交换顺序"

#: face_shapekey_rig/operators.py:2608
msgctxt "Operator"
msgid "순서 이동"
msgstr "移动顺序"

#: face_shapekey_rig/face_ui.py:405
msgctxt "Operator"
msgid "숫자패드 1처럼 얼굴 정면 뷰로 바꾸고 캔버스를 화면 가운데로 (얼굴 방향 설정 반영)"
msgstr "像数字键盘 1 一样切换到脸部正视图，并将画布置于屏幕中央（反映脸部朝向设置）"

#: face_shapekey_rig/operators.py:2067
msgctxt "Operator"
msgid "스냅 이동"
msgstr "吸附移动"

#: face_shapekey_rig/operators.py:3723
msgctxt "Operator"
msgid "스페이스바로 재생할 때 들리는 오디오를 시퀀서에 추가합니다. 립싱크 분석용 오디오와는 별개라 여기서 볼륨/음소거/시작 프레임만 따로 조절할 수 있습니다"
msgstr "将按空格键播放时听到的音频添加到序列编辑器。它与口型同步分析音频分开，因此可在此单独调整音量/静音/起始帧"

#: face_shapekey_rig/atlas.py:3791
msgctxt "Operator"
msgid "스프라이트 립싱크 다시 굽기"
msgstr "重新烘焙精灵口型同步"

#: face_shapekey_rig/atlas.py:3008
msgctxt "Operator"
msgid "스프라이트 시트 삭제"
msgstr "删除精灵图集"

#: face_shapekey_rig/atlas.py:2967
msgctxt "Operator"
msgid "스프라이트 시트 추가"
msgstr "添加精灵图集"

#: face_shapekey_rig/atlas.py:3775
msgctxt "Operator"
msgid "스프라이트 시트 키를 모두 Constant 보간으로 바꿉니다 (칸 사이가 섞이는 문제 방지)"
msgstr "将所有精灵图集关键帧改为常量插值（防止单元格之间混合）"

#: face_shapekey_rig/operators.py:141
msgctxt "Operator"
msgid "슬라이더 추가"
msgstr "添加滑块"

#: face_shapekey_rig/eye.py:7371
msgctxt "Operator"
msgid "시선 미리보기"
msgstr "视线预览"

#: face_shapekey_rig/eye.py:7291
msgctxt "Operator"
msgid "시선 초기화"
msgstr "重置视线"

#: face_shapekey_rig/eye.py:7338
msgctxt "Operator"
msgid "시선 컨트롤러"
msgstr "视线控制器"

#: face_shapekey_rig/face_ui.py:2318
msgctxt "Operator"
msgid "시선 컨트롤러 만들기"
msgstr "创建视线控制器"

#: face_shapekey_rig/operators.py:3135
msgctxt "Operator"
msgid "시작 프레임으로 이동해 카운트다운 후 재생과 녹화를 시작합니다. 다시 누르면 취소/정지되고, End Frame에 도달하면 자동으로 멈춥니다"
msgstr "移动到起始帧，倒计时后开始播放和录制。再次按下可取消/停止，到达结束帧后自动停止"

#: face_shapekey_rig/operators.py:3818
msgctxt "Operator"
msgid "시퀀서에 넣은 립싱크 사운드 스트립을 제거합니다. 타임라인 스크럽 시 소리가 나지 않게 됩니다"
msgstr "移除放入序列编辑器的口型同步声音片段。拖动时间轴时将不再发声"

#: face_shapekey_rig/atlas.py:3655
msgctxt "Operator"
msgid "시퀀스 미리보기"
msgstr "序列预览"

#: face_shapekey_rig/atlas.py:4550
msgctxt "Operator"
msgid "시퀀스 삭제"
msgstr "删除序列"

#: face_shapekey_rig/atlas.py:3949
msgctxt "Operator"
msgid "시퀀스를 '%s' 시트로 옮기기 (추천)"
msgstr "将序列移动到“%s”图集（推荐）"

#: face_shapekey_rig/atlas.py:3686
msgctxt "Operator"
msgid "시퀀스를 입 파츠의 시트로 옮기기"
msgstr "将序列移动到嘴部部件的图集"

#: face_shapekey_rig/face_ui.py:890
msgctxt "Operator"
msgid "시트 삭제"
msgstr "删除图集"

#: face_shapekey_rig/face_ui.py:819
msgctxt "Operator"
msgid "시트 추가"
msgstr "添加图集"

#: face_shapekey_rig/face_ui.py:891
msgctxt "Operator"
msgid "시트를 목록에서 뺍니다 (이미 배치한 파츠는 그대로)"
msgstr "从列表中移除图集（已放置的部件保持不变）"

#: face_shapekey_rig/face_ui.py:1132
msgctxt "Operator"
msgid "시트에서 파츠를 고르고 태그를 정해 캔버스에 올립니다. 태그의 기준 마커 위치에 놓입니다"
msgstr "从图集中选择部件并指定标签，放到画布上。会放在标签的基准标记位置"

#: face_shapekey_rig/atlas.py:3115
msgctxt "Operator"
msgid "썸네일 갱신"
msgstr "刷新缩略图"

#: face_shapekey_rig/operators.py:2863
msgctxt "Operator"
msgid "씬 설정(컬렉션/프리셋/모캡/립싱크/라벨)을 리그에 저장합니다. 다른 파일에서 리그와 메시를 Append 한 뒤 '캐릭터 가져오기'로 복구하세요. 파일 저장 시 자동 갱신됩니다"
msgstr "将场景设置（集合/预设/动作捕捉/口型同步/标签）保存到绑定中。在其他文件中追加绑定和网格后，用“导入角色”恢复。保存文件时会自动更新"

#: face_shapekey_rig/eye.py:5227
msgctxt "Operator"
msgid "얼굴 메시 편집 모드에서 새로 고른 면으로 캔버스 메시만 바꿉니다. 파츠·마커·프리셋·설정과 그림 위치는 그대로 (같은 정면 UV를 이어서 씀)"
msgstr "在脸部网格编辑模式下，仅将画布网格更换为新选择的面。部件、标记、预设、设置和图像位置保持不变（继续使用相同正面的 UV）"

#: face_shapekey_rig/eye.py:5732
msgctxt "Operator"
msgid "얼굴 앞에 머리보다 넓은 평면 캔버스를 만들어 머리 본에 붙입니다. 분노 마크처럼 얼굴 밖으로 나가는 감정표현용. 파츠·태그·프리셋은 다른 캔버스와 같이 씁니다"
msgstr "在脸部前方创建比头更宽的平面画布，并附着到头部骨骼上。用于愤怒符号等超出脸部的表情。部件、标签、预设与其他画布共用"

#: face_shapekey_rig/eye.py:5466
msgctxt "Operator"
msgid "얼굴 움직임에 다시 붙이기"
msgstr "重新附着到脸部运动"

#: face_shapekey_rig/face_ui.py:404
msgctxt "Operator"
msgid "얼굴 정면 보기"
msgstr "脸部正视图"

#: face_shapekey_rig/eye.py:5501
msgctxt "Operator"
msgid "얼굴 캔버스 만들기"
msgstr "创建脸部画布"

#: face_shapekey_rig/operators.py:3074
msgctxt "Operator"
msgid "연결 시작"
msgstr "开始连接"

#: face_shapekey_rig/eye.py:5451
msgctxt "Operator"
msgid "영역 수정을 그만두고 캔버스를 다시 보이게 합니다"
msgstr "停止编辑选区并重新显示画布"

#: face_shapekey_rig/atlas.py:3484
msgctxt "Operator"
msgid "예전 '반전 칸 만들기'로 다른 칸 그림을 가져다 쓰던 칸을 모두 원래 칸으로 되돌립니다 (그 칸의 크기·위치도 지움)"
msgstr "将所有曾通过旧版“创建翻转单元格”借用其他单元格图像的单元格恢复为原始单元格（同时清除该单元格的尺寸/位置）"

#: face_shapekey_rig/operators.py:4089
msgctxt "Operator"
msgid "오디오 립싱크 생성"
msgstr "生成音频口型同步"

#: face_shapekey_rig/atlas.py:4568
msgctxt "Operator"
msgid "위아래 시퀀스 자동 생성"
msgstr "自动生成上下序列"

#: face_shapekey_rig/eye.py:6819
msgctxt "Operator"
msgid "위에 있을수록 앞에 그려집니다"
msgstr "越靠上绘制越靠前"

#: face_shapekey_rig/eye.py:7127
msgctxt "Operator"
msgid "위치 0, 크기 1, 회전 0, 불투명도 1로 되돌립니다"
msgstr "将位置恢复为 0、大小恢复为 1、旋转恢复为 0、不透明度恢复为 1"

#: face_shapekey_rig/atlas.py:3509
msgctxt "Operator"
msgid "이 값을 모든 칸에"
msgstr "将此值应用到所有格子"

#: face_shapekey_rig/operators.py:3541
msgctxt "Operator"
msgid "이 구간의 시작 프레임으로 이동합니다"
msgstr "跳转到此区间的起始帧"

#: face_shapekey_rig/atlas.py:3656
msgctxt "Operator"
msgid "이 시퀀스의 단계를 지금 바로 보여 줍니다 (키는 넣지 않음). 기준 칸으로 표정이 바뀌며, '끄기'로 말하기를 끕니다"
msgstr "立即预览此序列的步骤（不插入关键帧）。表情会切换到基准格子，选择“关闭”可关闭说话"

#: face_shapekey_rig/atlas_vp.py:1225
msgctxt "Operator"
msgid "이 시트의 뷰포트 컨트롤러를 지웁니다 (칸 키는 유지)"
msgstr "删除此图集的视图控制器（保留格子关键帧）"

#: face_shapekey_rig/atlas.py:3687
msgctxt "Operator"
msgid "이 시트의 시퀀스를 ④ 입 파츠가 그리는 시트로 옮기고, 이 시트는 지웁니다 (같은 입 그림을 쓰는 시트끼리)"
msgstr "将此图集的序列移到 ④ 嘴部部件所绘制的图集，并删除此图集（仅限使用同一嘴部图像的图集）"

#: face_shapekey_rig/face_ui.py:974
msgctxt "Operator"
msgid "이 시트의 이미지를 다른 파일로 바꿉니다. 이 시트에서 올린 파츠와 입 시퀀스도 새 이미지를 씁니다"
msgstr "将此图集的图像替换为其他文件。从此图集加载的部件和嘴部序列也将使用新图像"

#: face_shapekey_rig/atlas_vp.py:1193
msgctxt "Operator"
msgid "이 시트의 칸을 뷰포트에서 고르는 격자 패드(+ 말하기 슬라이더)를 드라이버 방식 패널에 만듭니다"
msgstr "在驱动器方式面板中创建网格板（+ 说话滑块），用于在视图中选择此图集的格子"

#: face_shapekey_rig/atlas.py:3557
msgctxt "Operator"
msgid "이 입 모양을 지금 바로 보여 줍니다 (키는 넣지 않음). '끄기'로 표정 칸으로 돌아갑니다"
msgstr "立即预览此嘴型（不插入关键帧）。选择“关闭”会返回表情格子"

#: face_shapekey_rig/atlas.py:4104
msgctxt "Operator"
msgid "이 입 키 넣기"
msgstr "插入此嘴部关键帧"

#: face_shapekey_rig/eye.py:7308
msgctxt "Operator"
msgid "이 칸 배치 되돌리기"
msgstr "还原此格子布局"

#: face_shapekey_rig/atlas.py:3369
#: face_shapekey_rig/eye.py:7695
msgctxt "Operator"
msgid "이 칸 보기"
msgstr "查看此格子"

#: face_shapekey_rig/ime.py:495
msgctxt "Operator"
msgid "이 칸에 넣을 글자를 작은 입력 창에서 씁니다 (Blender에서 한글·일본어·중국어 입력이 안 될 때). 엔터 = 넣기, Esc = 취소"
msgstr "在小输入窗口中输入要放入此格子的文字（当 Blender 无法输入韩文、日文、中文时）。Enter = 应用，Esc = 取消"

#: face_shapekey_rig/eye.py:7635
msgctxt "Operator"
msgid "이 칸을 일괄 조절할 칸으로 체크합니다. 지금 칸의 배치를 바꾸면 체크한 칸들도 같이 바뀝니다 (크기는 같은 비율, 위치·회전은 움직인 만큼)"
msgstr "将此格子勾选为批量调整的格子。更改当前格子的布局时，已勾选的格子也会随之变化（大小按相同比例，位置和旋转按移动量）"

#: face_shapekey_rig/atlas.py:3404
msgctxt "Operator"
msgid "이 칸을 일괄 조절할 칸으로 체크합니다. 지금 칸의 크기·위치를 바꾸면 체크한 칸들도 같이 바뀝니다 (크기는 같은 비율, 위치는 움직인 만큼)"
msgstr "将此格子勾选为批量调整的格子。更改当前格子的大小和位置时，已勾选的格子也会随之变化（大小按相同比例，位置按移动量）"

#: face_shapekey_rig/eye.py:7696
msgctxt "Operator"
msgid "이 칸을 지금 칸으로 만들어 뷰포트에 바로 보여 줍니다 (자동 키가 켜져 있으면 키도 들어감). 배치는 이 칸 기준으로 조절됩니다"
msgstr "将此格子设为当前格子并立即在视图中显示（若自动关键帧已开启，也会插入关键帧）。布局将以此格子为基准调整"

#: face_shapekey_rig/atlas.py:3370
msgctxt "Operator"
msgid "이 칸을 지금 칸으로 만들어 뷰포트에 바로 보여 줍니다 (자동 키가 켜져 있으면 키도 들어감). 크기·위치는 이 칸 기준으로 조절됩니다"
msgstr "将此格子设为当前格子并立即在视图中显示（若自动关键帧已开启，也会插入关键帧）。大小和位置将以此格子为基准调整"

#: face_shapekey_rig/operators.py:2723
msgctxt "Operator"
msgid "이 컨트롤러와 연결된 드라이버를 제거합니다 (셰이프 키는 유지). 체크된 항목이 2개 이상이면 체크된 것들을 한꺼번에 삭제합니다"
msgstr "移除此控制器关联的驱动器（保留形态键）。若勾选项目有 2 个或以上，则一次性删除勾选的项目"

#: face_shapekey_rig/operators.py:2228
msgctxt "Operator"
msgid "이 탭의 컨트롤러만 배치 모드로: 틀을 선택해 옮길 수 있습니다. 다시 누르거나 ESC/우클릭으로 끕니다"
msgstr "仅将此选项卡的控制器切换到布局模式：可选择并移动框架。再次按下或按 ESC/右键单击可关闭"

#: face_shapekey_rig/face_ui.py:3086
msgctxt "Operator"
msgid "이 파츠 키 넣기"
msgstr "插入此部件关键帧"

#: face_shapekey_rig/eye.py:6505
msgctxt "Operator"
msgid "이 폴더 삭제"
msgstr "删除此文件夹"

#: face_shapekey_rig/face_ui.py:2550
msgctxt "Operator"
msgid "이 폴더 키 넣기"
msgstr "为此文件夹插入关键帧"

#: face_shapekey_rig/eye.py:6380
#: face_shapekey_rig/face_ui.py:2518
msgctxt "Operator"
msgid "이 폴더로 전환"
msgstr "切换到此文件夹"

#: face_shapekey_rig/eye.py:6381
msgctxt "Operator"
msgid "이 폴더를 켜고 같은 태그·같은 자리의 다른 폴더는 끕니다 ('바꾸면 자동 키'가 켜져 있으면 키도 넣음)"
msgstr "启用此文件夹，并关闭具有相同标签、相同位置的其他文件夹（若开启了“更改时自动关键帧”，也会插入关键帧）"

#: face_shapekey_rig/face_ui.py:1758
msgctxt "Operator"
msgid "이 표정을 적용하고 현재 프레임에 키를 넣습니다 (이 프레임부터 표정이 바뀜)"
msgstr "应用此表情并在当前帧插入关键帧（表情从此帧开始变化）"

#: face_shapekey_rig/atlas.py:3290
msgctxt "Operator"
msgid "이미 넣은 입 배치 키에 지금 고른 보간 방법을 적용합니다 (선택한 키프레임만 / 이 입의 모든 키)"
msgstr "将当前选择的插值方法应用到已插入的嘴部布局关键帧（仅所选关键帧 / 此嘴部的所有关键帧）"

#: face_shapekey_rig/eye.py:6956
msgctxt "Operator"
msgid "이미 넣은 키에 지금 고른 보간 방법을 적용합니다 (선택한 키프레임만 / 이 파츠의 모든 키)"
msgstr "将当前选择的插值方法应用到已插入的关键帧（仅所选关键帧 / 此部件的所有关键帧）"

#: face_shapekey_rig/face_ui.py:938
msgctxt "Operator"
msgid "이미지 다시 불러오기"
msgstr "重新加载图像"

#: face_shapekey_rig/atlas.py:4419
msgctxt "Operator"
msgid "이미지 불러오기"
msgstr "加载图像"

#: face_shapekey_rig/atlas.py:3116
msgctxt "Operator"
msgid "이미지를 칸 단위로 잘라 선택 그리드 썸네일을 만듭니다"
msgstr "将图像按格子切分，并创建可选网格缩略图"

#: face_shapekey_rig/atlas.py:3338
#: face_shapekey_rig/eye.py:6842
msgctxt "Operator"
msgid "이전/다음 칸"
msgstr "上一个/下一个格子"

#: face_shapekey_rig/operators.py:812
msgctxt "Operator"
msgid "일괄 수정 (체크된 항목)"
msgstr "批量修改（勾选项目）"

#: face_shapekey_rig/atlas.py:3403
#: face_shapekey_rig/eye.py:7634
msgctxt "Operator"
msgid "일괄 조절할 칸"
msgstr "要批量调整的格子"

#: face_shapekey_rig/atlas.py:3266
msgctxt "Operator"
msgid "입 키 넣기"
msgstr "插入嘴部关键帧"

#: face_shapekey_rig/atlas.py:3735
msgctxt "Operator"
msgid "입 파츠에 연결"
msgstr "连接到嘴部部件"

#: face_shapekey_rig/operators.py:3236
msgctxt "Operator"
msgid "자동 매핑"
msgstr "自动映射"

#: face_shapekey_rig/operators.py:1063
msgctxt "Operator"
msgid "자유 배치 가능한 라벨 텍스트를 만듭니다. 오브젝트 모드에서 G/S로 배치·크기 조절, Tab으로 내용 수정, 폰트는 폰트 속성에서"
msgstr "创建可自由摆放的标签文本。在物体模式下用 G/S 调整位置和大小，用 Tab 修改内容，字体在字体属性中设置"

#: face_shapekey_rig/face_ui.py:4566
msgctxt "Operator"
msgid "자유 변형 (Ctrl+T)"
msgstr "自由变换 (Ctrl+T)"

#: face_shapekey_rig/operators.py:3781
msgctxt "Operator"
msgid "재생 오디오 제거"
msgstr "移除播放音频"

#: face_shapekey_rig/operators.py:3722
msgctxt "Operator"
msgid "재생 오디오 추가"
msgstr "添加播放音频"

#: face_shapekey_rig/operators.py:1821
msgctxt "Operator"
msgid "저장된 설정으로 모든 컨트롤러를 다시 구성합니다. 위젯/드라이버/토글 연결을 최신 버전 방식으로 재적용합니다"
msgstr "根据已保存的设置重新构建所有控制器。以最新版本的方式重新应用控件、驱动器、切换连接"

#: face_shapekey_rig/operators.py:1503
msgctxt "Operator"
msgid "저장된 표정 프리셋을 컨트롤러에 적용합니다"
msgstr "将已保存的表情预设应用到控制器"

#: face_shapekey_rig/face_ui.py:2707
#: face_shapekey_rig/face_ui.py:2969
msgctxt "Operator"
msgid "저장하고 끝내기"
msgstr "保存并完成"

#: face_shapekey_rig/face_ui.py:2712
#: face_shapekey_rig/face_ui.py:2974
msgctxt "Operator"
msgid "저장하고 이 프레임에 키"
msgstr "保存并在此帧插入关键帧"

#: face_shapekey_rig/face_ui.py:2101
msgctxt "Operator"
msgid "적용"
msgstr "应用"

#: face_shapekey_rig/atlas.py:3056
msgctxt "Operator"
msgid "적용 (드라이버 재구성)"
msgstr "应用（重建驱动器）"

#: face_shapekey_rig/eye.py:6273
msgctxt "Operator"
msgid "적용 (머티리얼 재구성)"
msgstr "应用（重建材质）"

#: face_shapekey_rig/face_ui.py:2005
msgctxt "Operator"
msgid "전부 지우기"
msgstr "全部清除"

#: face_shapekey_rig/eye.py:6488
msgctxt "Operator"
msgid "전체 보기 (폴더 없이)"
msgstr "查看全部（不含文件夹）"

#: face_shapekey_rig/face_ui.py:1857
msgctxt "Operator"
msgid "전환"
msgstr "切换"

#: face_shapekey_rig/operators.py:1008
msgctxt "Operator"
msgid "좌/우 포함식을 바꿔 반대쪽 셰이프 키를 찾아, 같은 설정과 색상으로 반대쪽 컨트롤러를 만듭니다 (위치는 패널 중심 기준 미러). 체크된 항목이 2개 이상이면 체크된 것들을 한꺼번에 미러합니다"
msgstr "切换左/右包含条件，查找对侧形态键，并创建具有相同设置和颜色的对侧控制器（位置以面板中心为基准镜像）。若勾选项目有 2 个或以上，则一次性镜像勾选的项目"

#: face_shapekey_rig/eye.py:6791
msgctxt "Operator"
msgid "중심 다시 잡기"
msgstr "重新居中"

#: face_shapekey_rig/operators.py:3122
msgctxt "Operator"
msgid "중지"
msgstr "停止"

#: face_shapekey_rig/face_ui.py:3603
msgctxt "Operator"
msgid "지금 고른 캔버스의 파츠·태그·마커·시트·표정 프리셋·입 시퀀스·립싱크 설정과 속성값, 시트 이미지(원본 해상도)를 .zip 하나로 저장합니다 (키프레임 제외)"
msgstr "将当前所选画布的部件、标签、标记、图集、表情预设、嘴部序列、唇形同步设置和属性值，以及图集图像（原始分辨率）保存为一个 .zip 文件（不含关键帧）"

#: face_shapekey_rig/eye.py:6792
msgctxt "Operator"
msgid "지금 보이는 칸의 그림으로 파츠 중심을 다시 계산합니다 (그림 위치는 그대로)"
msgstr "根据当前可见格子的图像重新计算部件中心（图像位置保持不变）"

#: face_shapekey_rig/face_ui.py:1681
msgctxt "Operator"
msgid "지금 보이는 파츠 배치(칸·위치·크기·회전·불투명도, 입 칸)를 표정으로 저장합니다"
msgstr "将当前可见的部件布局（格子、位置、大小、旋转、不透明度、嘴部格子）保存为表情"

#: face_shapekey_rig/eye.py:6502
msgctxt "Operator"
msgid "지금 보이는 파츠로 덮어쓰기"
msgstr "用当前可见的部件覆盖"

#: face_shapekey_rig/operators.py:3699
msgctxt "Operator"
msgid "지금 보이는 패널 위치를 기준으로 다시 묶습니다. 캐릭터나 패널을 옮긴 뒤 위치가 어긋났을 때 누르세요"
msgstr "以当前可见的面板位置为基准重新绑定。移动角色或面板后位置错位时请点击"

#: face_shapekey_rig/atlas.py:4521
msgctxt "Operator"
msgid "지금 선택된 칸을 기준 칸으로 하는 시퀀스를 추가합니다 (열림 = 기준 칸). 닫힘 칸을 지정해 주세요"
msgstr "添加以当前所选格子为基准格子的序列（张开 = 基准格子）。请指定闭合格子"

#: face_shapekey_rig/eye.py:6186
msgctxt "Operator"
msgid "지금 씬의 활성 카메라를 기준으로 누르게 합니다"
msgstr "以当前场景的活动相机为基准进行按压"

#: face_shapekey_rig/eye.py:7247
msgctxt "Operator"
msgid "지금 칸 그림에서 가장 많이 쓰인 색을 '원래 색'으로 넣습니다 (스포이트는 화면 색이라 조명·색 관리 때문에 틀릴 수 있음)"
msgstr "将当前格图像中使用最多的颜色作为“原始颜色”填入（吸管取的是屏幕颜色，可能因照明和色彩管理而不准确）"

#: face_shapekey_rig/atlas.py:3459
msgctxt "Operator"
msgid "지금 칸에 저장된 크기·위치·반전과 다른 칸 그림 연결을 모두 지우고, 이미지에 그려진 원래 칸으로 되돌립니다 (이미지 파일은 건드리지 않음)"
msgstr "清除当前格保存的大小、位置、翻转以及与其他格图像的连接，恢复为图像中绘制的原始格（不会改动图像文件）"

#: face_shapekey_rig/atlas.py:3539
msgctxt "Operator"
msgid "지금 칸으로 지정"
msgstr "设为当前格"

#: face_shapekey_rig/atlas.py:3580
msgctxt "Operator"
msgid "지금 칸의 그림을 뒤집어서 다른 칸 번호로 씁니다. 이미지에 반전 그림을 따로 그릴 필요가 없습니다"
msgstr "翻转当前格的图像并用作其他格编号。无需在图像中单独绘制翻转图像"

#: face_shapekey_rig/eye.py:7309
msgctxt "Operator"
msgid "지금 칸의 칸별 배치(위치·크기·회전·불투명도·크롭)를 지워 전체 배치 값으로 되돌립니다 (일괄 조절로 체크한 칸도 같이)"
msgstr "清除当前格的逐格布局（位置、大小、旋转、不透明度、裁剪），恢复为全局布局值（通过批量调整勾选的格也会一并处理）"

#: face_shapekey_rig/atlas.py:3510
msgctxt "Operator"
msgid "지금 칸의 크기/위치를 공통값으로 만들고 다른 칸의 개별 설정을 모두 지웁니다"
msgstr "将当前格的大小/位置设为公共值，并清除其他格的所有单独设置"

#: face_shapekey_rig/operators.py:3007
msgctxt "Operator"
msgid "지금의 컨트롤러 위치들을 기본 표정으로 저장합니다. '기본값으로 되돌리기'가 이 상태로 복원합니다"
msgstr "将当前控制器位置保存为默认表情。“恢复默认值”会恢复到此状态"

#: face_shapekey_rig/face_ui.py:2326
#: face_shapekey_rig/face_ui.py:2741
msgctxt "Operator"
msgid "지우기"
msgstr "清除"

#: face_shapekey_rig/face_ui.py:2213
msgctxt "Operator"
msgid "찍기"
msgstr "捕获"

#: face_shapekey_rig/operators.py:813
msgctxt "Operator"
msgid "체크된 컨트롤러들을 한 번에 수정합니다 (체크된 항목의 연필 버튼으로 열림). 같은 타입끼리만 가능하며, 값이 서로 다른 항목은 '(다수 선택됨)'으로 표시됩니다"
msgstr "同时编辑已勾选的控制器（通过已勾选项目的铅笔按钮打开）。仅限相同类型；值不同的项目会显示为“(多选)”"

#: face_shapekey_rig/operators.py:1747
msgctxt "Operator"
msgid "체크한 컨트롤러들을 선택한 컬렉션에 넣거나 뺍니다"
msgstr "将勾选的控制器加入或移出所选集合"

#: face_shapekey_rig/eye.py:5450
#: face_shapekey_rig/face_ui.py:2709
msgctxt "Operator"
msgid "취소"
msgstr "取消"

#: face_shapekey_rig/layer_vp.py:1341
msgctxt "Operator"
msgid "측정 중…"
msgstr "测量中…"

#: face_shapekey_rig/eye.py:6185
msgctxt "Operator"
msgid "카메라 다시 연결"
msgstr "重新连接摄像机"

#: face_shapekey_rig/atlas.py:3458
#: face_shapekey_rig/atlas.py:4020
msgctxt "Operator"
msgid "칸 비우기"
msgstr "清空格"

#: face_shapekey_rig/atlas.py:3162
msgctxt "Operator"
msgid "칸 키프레임"
msgstr "格关键帧"

#: face_shapekey_rig/operators.py:2886
msgctxt "Operator"
msgid "캐릭터 가져오기"
msgstr "导入角色"

#: face_shapekey_rig/operators.py:2862
msgctxt "Operator"
msgid "캐릭터 이동 준비"
msgstr "准备移动角色"

#: face_shapekey_rig/face_ui.py:3602
msgctxt "Operator"
msgid "캔버스 내보내기"
msgstr "导出画布"

#: face_shapekey_rig/eye.py:5180
msgctxt "Operator"
msgid "캔버스 메시를 직접 고친 뒤(Extrude·정점 이동 등) 누르세요. 늘린 면에 같은 정면 UV를 이어 주고, 얼굴에 다시 붙입니다. 기존 파츠·마커 위치는 그대로"
msgstr "手动修改画布网格后（挤出、移动顶点等）请按此按钮。为拉伸出的面延续相同正面 UV，并重新贴合到脸部。现有部件和标记位置保持不变"

#: face_shapekey_rig/face_ui.py:3648
msgctxt "Operator"
msgid "캔버스 불러오기 (덮어쓰기)"
msgstr "加载画布（覆盖）"

#: face_shapekey_rig/eye.py:5467
msgctxt "Operator"
msgid "캔버스가 얼굴 메시의 최종 모양(아마추어·셰이프 키)을 그대로 따라가게 다시 붙입니다. 리그에 캔버스를 따로 바인드해서 일그러질 때 누르세요 (캔버스의 아마추어 모디파이어는 지워짐)"
msgstr "重新贴合画布，使其跟随脸部网格的最终形状（骨架和形态键）。当画布单独绑定到骨架而出现扭曲时请按此按钮（画布的骨架修改器会被移除）"

#: face_shapekey_rig/eye.py:5367
msgctxt "Operator"
msgid "캔버스를 잠시 숨기고 얼굴 메시를 편집 모드로 엽니다. 지금 캔버스 영역이 미리 선택되어 있으니 면을 더하거나 빼고 '적용'을 누르세요"
msgstr "暂时隐藏画布并将脸部网格打开到编辑模式。当前画布区域已预先选中，请添加或删除面后按“应用”"

#: face_shapekey_rig/operators.py:3222
msgctxt "Operator"
msgid "캘리브레이션 보정을 지우고 원본 수신값을 사용합니다"
msgstr "清除校准修正并使用原始接收值"

#: face_shapekey_rig/operators.py:3459
msgctxt "Operator"
msgid "캡처 중 프리셋 적용"
msgstr "捕获时应用预设"

#: face_shapekey_rig/operators.py:2722
msgctxt "Operator"
msgid "컨트롤러 삭제"
msgstr "删除控制器"

#: face_shapekey_rig/operators.py:2680
msgctxt "Operator"
msgid "컨트롤러 선택"
msgstr "选择控制器"

#: face_shapekey_rig/operators.py:520
msgctxt "Operator"
msgid "컨트롤러 수정"
msgstr "编辑控制器"

#: face_shapekey_rig/operators.py:2227
#: face_shapekey_rig/operators.py:2261
msgctxt "Operator"
msgid "컨트롤러 위치 옮기기 (배치 모드)"
msgstr "移动控制器位置（摆放模式）"

#: face_shapekey_rig/operators.py:3281
msgctxt "Operator"
msgid "컨트롤러마다 역할(눈 감기/눈썹/입 모음/눈동자)을 고르면 ARKit 매핑을 자동으로 만들어 줍니다. 이름으로 미리 추측해서 채워둡니다"
msgstr "为每个控制器选择角色（闭眼/眉毛/嘴部收拢/瞳孔）后，会自动创建 ARKit 映射。会根据名称预先推测并填入"

#: face_shapekey_rig/operators.py:1723
msgctxt "Operator"
msgid "컬렉션 삭제"
msgstr "删除集合"

#: face_shapekey_rig/operators.py:1684
msgctxt "Operator"
msgid "컬렉션 추가"
msgstr "添加集合"

#: face_shapekey_rig/operators.py:1724
msgctxt "Operator"
msgid "컬렉션을 없애고 소속 컨트롤러를 컬렉션 밖으로 뺍니다 (컨트롤러는 유지)"
msgstr "删除集合并将所属控制器移出集合（控制器保留）"

#: face_shapekey_rig/face_ui.py:2518
msgctxt "Operator"
msgid "켜져 있음"
msgstr "已开启"

#: face_shapekey_rig/face_ui.py:1857
msgctxt "Operator"
msgid "켜짐"
msgstr "开启"

#: face_shapekey_rig/eye.py:7052
msgctxt "Operator"
msgid "키 삽입"
msgstr "插入关键帧"

#: face_shapekey_rig/face_ui.py:1581
msgctxt "Operator"
msgid "키프레임을 잠시 멈추고 고른 프리셋(표정)의 파츠를 그대로 고칩니다. 끝나면 '저장하고 끝내기' 또는 '취소'"
msgstr "暂时暂停关键帧，直接修改所选预设（表情）的部件。完成后选择“保存并结束”或“取消”"

#: face_shapekey_rig/operators.py:521
msgctxt "Operator"
msgid "타입/방향/셰이프 키/라벨을 변경합니다"
msgstr "更改类型/方向/形态键/标签"

#: face_shapekey_rig/face_ui.py:712
msgctxt "Operator"
msgid "태그 삭제"
msgstr "删除标签"

#: face_shapekey_rig/face_ui.py:629
msgctxt "Operator"
msgid "태그 추가"
msgstr "添加标签"

#: face_shapekey_rig/face_ui.py:713
msgctxt "Operator"
msgid "태그를 지웁니다. 이 태그였던 파츠는 '태그 없음'(얼굴 가운데 기준)이 됩니다"
msgstr "删除标签。原本属于此标签的部件将变为“无标签”（以脸部中心为基准）"

#: face_shapekey_rig/operators.py:1120
msgctxt "Operator"
msgid "텍스트 색상"
msgstr "文本颜色"

#: face_shapekey_rig/operators.py:1168
msgctxt "Operator"
msgid "텍스트 색상 자동"
msgstr "文本颜色自动"

#: face_shapekey_rig/operators.py:1062
msgctxt "Operator"
msgid "텍스트 추가"
msgstr "添加文本"

#: face_shapekey_rig/operators.py:1121
msgctxt "Operator"
msgid "텍스트(라벨)의 색상을 변경합니다. 포즈 모드에서도 대상 텍스트를 골라 적용할 수 있고, 컨트롤러 색을 따올 수 있습니다"
msgstr "更改文本（标签）的颜色。在姿态模式下也可以选择目标文本并应用，还可以采用控制器颜色"

#: face_shapekey_rig/atlas.py:3087
msgctxt "Operator"
msgid "투명 배경 설정"
msgstr "设置透明背景"

#: face_shapekey_rig/operators.py:1784
msgctxt "Operator"
msgid "틀/핸들에 남은 포즈 회전을 초기화해 배치 모드 화살표와 스냅을 정상화합니다 (위치·크기·값은 유지)"
msgstr "初始化边框/控制柄上残留的姿态旋转，使摆放模式箭头和吸附恢复正常（位置、大小和值保持不变）"

#: face_shapekey_rig/atlas.py:4420
msgctxt "Operator"
msgid "파일에서 스프라이트 시트 이미지를 불러와 바로 적용합니다 (대상 머티리얼의 기존 시트 이미지도 교체)"
msgstr "从文件加载精灵图集图像并立即应用（目标材质的现有图集图像也会被替换）"

#: face_shapekey_rig/face_ui.py:797
msgctxt "Operator"
msgid "파츠 가장자리에 얇은 흰 선이 보일 때. 투명한 곳에 숨어 있는 흰색을 그림 색으로 채웁니다 (그림·투명도는 그대로). 고친 이미지는 .blend 안에 저장됩니다"
msgstr "当部件边缘出现细白线时使用。用图像颜色填充隐藏在透明区域中的白色（图像和透明度保持不变）。修改后的图像会保存在 .blend 中"

#: face_shapekey_rig/layer_vp.py:1088
msgctxt "Operator"
msgid "파츠 격자·입·표정 목록·시선 패드를 뷰포트에 만들거나 갱신하거나 정렬하거나 지웁니다"
msgstr "在视图中创建、更新、排序或删除部件栅格、嘴、表情列表和视线板"

#: face_shapekey_rig/face_ui.py:630
msgctxt "Operator"
msgid "파츠 그룹(태그)을 만듭니다. 기준 마커와 새 파츠의 기본값(대칭·시선·입·크기)을 정합니다"
msgstr "创建部件组（标签）。设置基准标记和新部件的默认值（对称、视线、嘴、大小）"

#: face_shapekey_rig/eye.py:6605
msgctxt "Operator"
msgid "파츠 복제"
msgstr "复制部件"

#: face_shapekey_rig/eye.py:6514
msgctxt "Operator"
msgid "파츠 삭제"
msgstr "删除部件"

#: face_shapekey_rig/eye.py:6294
#: face_shapekey_rig/face_ui.py:1131
msgctxt "Operator"
msgid "파츠 추가"
msgstr "添加部件"

#: face_shapekey_rig/eye.py:6408
msgctxt "Operator"
msgid "파츠 폴더"
msgstr "部件文件夹"

#: face_shapekey_rig/face_ui.py:417
msgctxt "Operator"
msgid "파츠를 놓을 기준점을 추가합니다. 눈·눈썹·입·감정표현을 고르거나 + 로 이름을 직접 정합니다"
msgstr "添加用于放置部件的基准点。选择眼睛、眉毛、嘴、情绪表情，或用 + 自定义名称"

#: face_shapekey_rig/operators.py:1214
msgctxt "Operator"
msgid "패널 레이아웃(컨트롤러/텍스트/컬렉션)을 JSON으로 저장합니다"
msgstr "将面板布局（控制器/文本/集合）保存为 JSON"

#: face_shapekey_rig/operators.py:1969
msgctxt "Operator"
msgid "패널 위치 지정"
msgstr "设置面板位置"

#: face_shapekey_rig/operators.py:2787
msgctxt "Operator"
msgid "패널 전체 제거"
msgstr "移除所有面板"

#: face_shapekey_rig/operators.py:1783
msgctxt "Operator"
msgid "패널 정렬 복구"
msgstr "恢复面板排列"

#: face_shapekey_rig/operators.py:1886
msgctxt "Operator"
msgid "패널을 본에 붙이기 (해제하려면 본을 비우고 실행)"
msgstr "将面板附加到骨骼（要解除，请清空骨骼后执行）"

#: face_shapekey_rig/eye.py:7372
msgctxt "Operator"
msgid "패드를 끝까지 밀어 범위를 확인합니다 (키는 넣지 않음)"
msgstr "将控制板推到极限以检查范围（不插入关键帧）"

#: face_shapekey_rig/eye.py:5502
msgctxt "Operator"
msgid "편집 모드에서 고른 얼굴 면을 복사해 살짝 띄운 '얼굴 캔버스'를 만듭니다. 정면 투영 UV, 얼굴과 같은 변형(아마추어·셰이프 키)을 따라가며, 눈·입 파츠를 이 메시 하나에 조립합니다"
msgstr "在编辑模式下复制所选脸部面，创建一个稍微抬起的「脸部画布」。使用正面投影 UV，跟随与脸部相同的变形（骨架·形态键），并将眼睛/嘴部部件组装到这个网格上"

#: face_shapekey_rig/operators.py:3841
msgctxt "Operator"
msgid "편집한 모음 구간대로 립싱크 키프레임을 다시 굽습니다"
msgstr "按照编辑后的元音区间重新烘焙唇形同步关键帧"

#: face_shapekey_rig/face_ui.py:4548
msgctxt "Operator"
msgid "포토샵 Ctrl+T처럼 뷰포트에서 파츠를 옮기고(안쪽 드래그), 크기를 바꾸고(모서리·변), 돌립니다(위 동그라미·바깥). Enter 확정 · Esc 취소. Shift = 비율 유지/15° 단위, Alt = 기준점 기준 크기"
msgstr "像 Photoshop 的 Ctrl+T 一样，在视图中移动部件（内侧拖动）、缩放（角/边）、旋转（上方圆圈/外侧）。Enter 确认 · Esc 取消。Shift = 保持比例/15° 步进，Alt = 以基准点缩放"

#: face_shapekey_rig/operators.py:3052
msgctxt "Operator"
msgid "표정 전체 키프레임"
msgstr "表情整体关键帧"

#: face_shapekey_rig/atlas.py:3540
msgctxt "Operator"
msgid "표정 칸 피커에서 지금 고른 칸을 이 모음의 입으로 지정합니다"
msgstr "将表情格子选择器中当前选中的格子指定为该元音的嘴型"

#: face_shapekey_rig/preset_vp.py:638
msgctxt "Operator"
msgid "표정 컨트롤러"
msgstr "表情控制器"

#: face_shapekey_rig/face_ui.py:2732
msgctxt "Operator"
msgid "표정 컨트롤러 만들기"
msgstr "创建表情控制器"

#: face_shapekey_rig/operators.py:1541
msgctxt "Operator"
msgid "표정 프리셋의 이름을 바꿉니다"
msgstr "重命名表情预设"

#: face_shapekey_rig/operators.py:1589
msgctxt "Operator"
msgid "프레임 구간의 드라이버 값을 셰이프 키 키프레임으로 굽고 드라이버를 제거합니다. FBX/VRM 익스포트 전에 사용하세요. 패널 복구는 '뷰포트 패널 리로드'"
msgstr "将帧区间的驱动器值烘焙为形态键关键帧并移除驱动器。请在导出 FBX/VRM 前使用。恢复面板请使用「重新加载视图面板」"

#: face_shapekey_rig/face_ui.py:1801
#: face_shapekey_rig/operators.py:1571
msgctxt "Operator"
msgid "프리셋 삭제"
msgstr "删除预设"

#: face_shapekey_rig/operators.py:1540
msgctxt "Operator"
msgid "프리셋 이름 변경"
msgstr "重命名预设"

#: face_shapekey_rig/face_ui.py:1680
#: face_shapekey_rig/operators.py:1463
msgctxt "Operator"
msgid "프리셋 저장"
msgstr "保存预设"

#: face_shapekey_rig/operators.py:1502
msgctxt "Operator"
msgid "프리셋 적용"
msgstr "应用预设"

#: face_shapekey_rig/face_ui.py:1757
msgctxt "Operator"
msgid "프리셋 적용 + 키"
msgstr "应用预设 + 关键帧"

#: face_shapekey_rig/face_ui.py:1580
#: face_shapekey_rig/face_ui.py:2718
msgctxt "Operator"
msgid "프리셋 편집"
msgstr "编辑预设"

#: face_shapekey_rig/face_ui.py:1660
