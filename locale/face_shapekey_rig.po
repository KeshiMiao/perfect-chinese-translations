msgstr "视图控制器"

#: face_shapekey_rig/atlas_vp.py:1250
#: face_shapekey_rig/layer_vp.py:1132
msgctxt "Operator"
msgid "뷰포트 컨트롤러 갱신"
msgstr "更新视图控制器"

#: face_shapekey_rig/atlas.py:4211
#: face_shapekey_rig/atlas_vp.py:1192
