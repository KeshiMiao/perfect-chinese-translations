#: face_shapekey_rig/face_ui.py:820
msgctxt "Operator"
msgid "격자로 그린 스프라이트 시트 이미지를 불러와 행·열로 자르고 파츠 번호를 매깁니다"
msgstr "导入按网格绘制的精灵图集图像，按行、列切分并编号部件"

