msgstr "开启摆放（重新创建材质）"

#: face_shapekey_rig/operators.py:2378
msgctxt "Operator"
msgid "변 크기 조절"
msgstr "调整边尺寸"

#: face_shapekey_rig/operators.py:2303
msgctxt "Operator"
msgid "변형 지우기 (컨트롤러 보호)"
msgstr "清除变形（保护控制器）"

#: face_shapekey_rig/atlas.py:3289
#: face_shapekey_rig/eye.py:6955
msgctxt "Operator"
msgid "보간 적용"
msgstr "应用插值"

#: face_shapekey_rig/operators.py:3221
msgctxt "Operator"
msgid "보정 해제"
msgstr "取消校正"

#: face_shapekey_rig/operators.py:382
msgctxt "Operator"
msgid "본 패드 추가"
msgstr "添加骨骼板"

#: face_shapekey_rig/face_ui.py:2139
msgctxt "Operator"
msgid "불러오기 (덮어쓰기)"
msgstr "加载（覆盖）"

#: face_shapekey_rig/operators.py:2643
msgctxt "Operator"
msgid "뷰포트 배치 위치(위→아래, 왼쪽→오른쪽) 순서대로 목록 순서를 자동 정렬합니다 (그룹별)"
msgstr "按视图中的摆放位置（从上到下、从左到右）自动排序列表顺序（按组）"

#: face_shapekey_rig/operators.py:2043
msgctxt "Operator"
msgid "뷰포트 색상 다시 불러오기"
msgstr "重新加载视图颜色"

#: face_shapekey_rig/layer_vp.py:1087
