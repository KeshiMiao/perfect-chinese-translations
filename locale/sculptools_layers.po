#: layers_base.py:477
#: ui.py:230
msgctxt "Operator"
msgid "Add Layer"
msgstr "添加图层"

#: layers_base.py:478
msgctxt "Operator"
msgid "Add an empty layer on top of the stack and make it active. Strokes not saved yet go into the current layer first"
msgstr "在图层堆栈顶部添加一个空图层并将其设为活动图层。尚未保存的笔触会先归入当前图层。"

#: layers_base.py:2844
msgctxt "Operator"
msgid "Add one subdivision level to the object and to every layer, through a Multires modifier (created if the object has none)"
msgstr "通过多级精度修改器为物体和每个图层添加一级细分（若物体没有该修改器则创建）"

#: layers_base.py:1446
#: ui.py:97
msgctxt "Operator"
msgid "Apply Morph"
msgstr "应用 Morph"

#: layers_base.py:3215
msgctxt "Operator"
msgid "Bake sculpt layers into animatable shape keys on a separate object. The result is a plain dense mesh: do NOT run the Multires modifier's Rebuild Subdivisions on it, Blender deletes every shape key without warning"
msgstr "将雕刻图层烘焙为单独物体上的可动画形态键。结果是普通高密度网格：请勿对其运行多级精度修改器的“重建细分”，Blender 会在无警告的情况下删除所有形态键。"

#: layers_base.py:3209
#: ui.py:728
msgctxt "Operator"
msgid "Bake to Shape Keys"
msgstr "烘焙到形态键"

#: ui.py:98
msgctxt "Operator"
msgid "Cancel"
msgstr "取消"

#: layers_base.py:1529
msgctxt "Operator"
msgid "Cancel Morph"
msgstr "取消 Morph"

#: layers_base.py:976
msgctxt "Operator"
msgid "Change Visibility"
msgstr "更改可见性"

#: layers_base.py:977
msgctxt "Operator"
msgid "Change layer visibility.\nShift+Click: isolate this layer (Shift+Click again to reveal all)"
msgstr "更改图层可见性。\nShift+单击：隔离此图层（再次 Shift+单击可显示全部）"

#: layers_base.py:2765
#: ui.py:667
msgctxt "Operator"
msgid "Clean Up Unused Data"
msgstr "清理未使用数据"

#: layers_base.py:2509
#: ui.py:445
msgctxt "Operator"
msgid "Clear Layers"
msgstr "清除图层"

#: layers_base.py:2360
#: ui.py:291
msgctxt "Operator"
msgid "Collapse All"
msgstr "全部折叠"

#: layers_base.py:595
msgctxt "Operator"
msgid "Copy the layer data, every layer included, and use the copy on the active object. The original stays in the list, unused"
msgstr "复制图层数据（包括所有图层），并将副本用于活动物体。原数据保留在列表中，但不使用"

#: layers_base.py:2766
msgctxt "Operator"
msgid "Delete layer-data collections in LAYERS_DATA that no object uses anymore (orphans from deleted objects, Duplicate Data, or reassignment)"
msgstr "删除 LAYERS_DATA 中不再被任何物体使用的图层数据集合（由已删除物体、复制数据或重新分配产生的孤立数据）"

#: layers_base.py:652
msgctxt "Operator"
msgid "Delete the active layer: what it holds leaves the mesh"
msgstr "删除活动图层：其中内容将从网格中移除"

#: layers_base.py:2510
msgctxt "Operator"
msgid "Delete the layer data that no longer fits this mesh, so you can start new layers. The mesh keeps its current shape. Undo the topology change instead to keep them"
msgstr "删除不再适配此网格的图层数据，以便开始新图层。网格保持当前形状。若要保留这些数据，请改为撤销拓扑更改"

#: layers_base.py:1530
msgctxt "Operator"
msgid "Discard the Morph Brush strokes and return to the object"
msgstr "放弃变形笔刷笔触并返回物体"

#: layers_base.py:594
msgctxt "Operator"
msgid "Duplicate Data"
msgstr "复制数据"

#: layers_base.py:2004
msgctxt "Operator"
msgid "Duplicate Layer"
msgstr "复制图层"

#: layers_base.py:2005
msgctxt "Operator"
msgid "Duplicate the active layer: the copy goes just above it and becomes active"
msgstr "复制活动图层：副本位于其正上方并成为活动图层"

#: layers_base.py:1387
msgctxt "Operator"
msgid "Erase part of the active layer by painting: a stroke removes it gradually at the brush's strength, Ctrl+stroke restores it. Apply Morph keeps the result"
msgstr "通过绘制擦除活动图层的一部分：笔触按笔刷强度逐渐移除，Ctrl+笔触可恢复。应用变形可保留结果"

#: layers_base.py:2135
msgctxt "Operator"
msgid "Invert Layer"
msgstr "反转图层"

#: layers_base.py:2136
msgctxt "Operator"
msgid "Invert the active layer: what was pushed out is pulled in. Opacity and visibility are not changed"
msgstr "反转活动图层：原本推出的部分变为拉入。不改变不透明度和可见性"

#: layers_base.py:2361
msgctxt "Operator"
msgid "Keep the mesh as it looks now and remove its layers: visible ones are baked in at their opacity, hidden ones are lost"
msgstr "保持网格当前外观并移除其图层：可见图层按其不透明度烘焙，隐藏图层将丢失"

#: layers_base.py:1447
msgctxt "Operator"
msgid "Keep what the Morph Brush erased in the active layer"
msgstr "保留变形笔刷在活动图层中擦除的内容"

#: layers_base.py:2600
msgctxt "Operator"
msgid "Link Layer Data"
msgstr "链接图层数据"

#: layers_base.py:1856
msgctxt "Operator"
msgid "Merge Down"
msgstr "向下合并"

#: layers_base.py:1857
msgctxt "Operator"
msgid "Merge the current layer to the one below it"
msgstr "将当前图层合并到其下方图层"

#: layers_base.py:2222
#: ui.py:559
msgctxt "Operator"
msgid "Mirror Layer"
msgstr "镜像图层"

#: layers_base.py:2223
msgctxt "Operator"
msgid "Mirror the active layer across the object's local axis plane. Symmetrize copies the source side onto the other; Flip swaps them"
msgstr "沿物体局部轴平面镜像活动图层。对称化将源侧复制到另一侧；翻转则交换两侧"

#: layers_base.py:1386
#: ui.py:303
msgctxt "Operator"
msgid "Morph Brush"
msgstr "变形笔刷"

#: layers_base.py:1797
msgctxt "Operator"
msgid "Move Layer"
msgstr "移动图层"

#: layers_base.py:1798
msgctxt "Operator"
msgid "Move the active layer up or down"
msgstr "向上或向下移动活动图层"

#: ui.py:582
msgctxt "Operator"
msgid "None"
msgstr "无"

#: layers_base.py:1561
msgctxt "Operator"
msgid "Rebuild layer data to match a natively-added Multires, preserving the current sculpt"
msgstr "重建图层数据以匹配原生添加的多级精度，同时保留当前雕刻"

#: layers_base.py:651
msgctxt "Operator"
msgid "Remove Layer"
msgstr "移除图层"

#: layers_base.py:3020
msgctxt "Operator"
msgid "Remove the highest subdivision level from the Multires modifier and from every layer; detail finer than the level below is lost"
msgstr "从多级精度修改器和每个图层中移除最高细分级别；比下一级更精细的细节将丢失"

#: layers_base.py:755
msgctxt "Operator"
msgid "Save Layer"
msgstr "保存图层"

#: layers_base.py:756
msgctxt "Operator"
msgid "Save current sculpt changes on the active layer"
msgstr "将当前雕刻更改保存到活动图层"

#: layers_base.py:925
msgctxt "Operator"
msgid "Set Active Layer"
msgstr "设为活动图层"

#: layers_base.py:3395
msgctxt "Operator"
msgid "Set Layer Opacity"
msgstr "设置图层不透明度"

#: layers_base.py:926
msgctxt "Operator"
msgid "Set the active layer (auto-saves the previous one if needed)"
msgstr "设置活动图层（必要时自动保存上一个图层）"

#: layers_base.py:3396
msgctxt "Operator"
msgid "Set this layer's opacity: drag the slider or type a value"
msgstr "设置此图层的不透明度：拖动滑块或输入数值"

#: ui.py:491
msgctxt "Operator"
msgid "SubD"
msgstr "细分"

