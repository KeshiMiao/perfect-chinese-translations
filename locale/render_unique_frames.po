msgstr "添加图层输出节点"

#: render_unique_frames/ops.py:29
msgctxt "Operator"
msgid "Adds a compositor node setup for exporting each viewlayer"
msgstr "添加用于导出每个视图层的合成器节点设置"

#: render_unique_frames/ops.py:50
msgctxt "Operator"
msgid "Render Unique Frames"
msgstr "渲染唯一帧"

