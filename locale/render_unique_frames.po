#: render_unique_frames/ops.py:10
msgid "Create Sequence"
msgstr "创建序列"

#: render_unique_frames/preferences.py:7
msgid "Default output node directory"
msgstr "默认输出节点目录"

#: render_unique_frames/preferences.py:14
msgid "Default output node file"
msgstr "默认输出节点文件"

#: render_unique_frames/preferences.py:7
msgid "Defines what is the default directory for file output nodes created with the AddLayerOutputNodes operator"
msgstr "定义使用 AddLayerOutputNodes 操作符创建的文件输出节点的默认目录"

#: render_unique_frames/preferences.py:14
