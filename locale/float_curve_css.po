msgctxt "Operator"
msgid "Register Curve Profile"
msgstr "注册曲线轮廓"

#: float_curve_css_v1_0_4/curve_profile_tools.py:198
msgctxt "Operator"
msgid "Register the active Curve object as a Curve Profile source for Float Curve conversion"
msgstr "将活动的曲线物体注册为曲线轮廓源，用于浮点曲线转换"

#: float_curve_css_v1_0_4/curve_profile_tools.py:216
