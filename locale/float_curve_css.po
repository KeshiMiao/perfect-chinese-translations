#: float_curve_css_v1_0_4/float_curve_tools.py:183
msgctxt "Operator"
msgid "Apply curve points from the JSON text field below onto the active Float Curve node"
msgstr "将下方 JSON 文本框中的曲线点应用到活动的浮点曲线节点"

#: float_curve_css_v1_0_4/float_curve_tools.py:165
msgctxt "Operator"
msgid "Apply the previously copied Float Curve points onto the currently active Float Curve node. Select the target node first, then click Apply"
msgstr "将之前复制的浮点曲线点应用到当前活动的浮点曲线节点。请先选择目标节点，然后点击应用"

#: float_curve_css_v1_0_4/curve_profile_tools.py:234
msgctxt "Operator"
msgid "Convert the selected Curve Profile into a Float Curve node inside the active object's Geometry Nodes modifier. Creates the modifier and node automatically if they do not exist yet"
msgstr "将选中的曲线轮廓转换为活动物体几何节点修改器中的浮点曲线节点。若修改器或节点不存在，将自动创建"

#: float_curve_css_v1_0_4/float_curve_tools.py:143
msgctxt "Operator"
msgid "Copy Curve"
msgstr "复制曲线"

#: float_curve_css_v1_0_4/float_curve_tools.py:144
msgctxt "Operator"
msgid "Copy all points of the currently active Float Curve node. Use Apply Curve afterwards to paste them onto any other Float Curve node (empty or not)"
msgstr "复制当前活动浮点曲线节点的所有点。之后使用应用曲线将它们粘贴到任意其他浮点曲线节点（无论是否为空）"

#: float_curve_css_v1_0_4/curve_profile_tools.py:233
msgctxt "Operator"
msgid "Create / Update Float Curve"
msgstr "创建 / 更新浮点曲线"

#: float_curve_css_v1_0_4/curve_profile_tools.py:215
msgctxt "Operator"
msgid "Delete Selected Profile"
msgstr "删除选中的轮廓"

#: float_curve_css_v1_0_4/float_curve_export.py:25
msgctxt "Operator"
msgid "Export Float Curve To Curve"
msgstr "导出浮点曲线为曲线"

#: float_curve_css_v1_0_4/float_curve_export.py:26
msgctxt "Operator"
msgid "Export the active Float Curve node to a Bezier Curve object in the 3D Viewport, preserving shape, points, and sharp peaks"
msgstr "将活动的浮点曲线节点导出为 3D 视图中的贝塞尔曲线物体，保留形状、点和尖峰"

#: float_curve_css_v1_0_4/float_curve_tools.py:203
#: float_curve_css_v1_0_4/float_curve_tools.py:249
msgctxt "Operator"
msgid "Flip Domain"
msgstr "翻转定义域"

#: float_curve_css_v1_0_4/float_curve_tools.py:204
msgctxt "Operator"
msgid "Flip the active Float Curve node. Vertical: flip values upside down (Y axis). Horizontal: mirror left to right (X axis). Domain: visual mirror with point order reversal"
msgstr "翻转活动的浮点曲线节点。垂直：将值上下翻转（Y 轴）。水平：左右镜像（X 轴）。定义域：通过点顺序反转实现视觉镜像"

#: float_curve_css_v1_0_4/curve_profile_tools.py:197
