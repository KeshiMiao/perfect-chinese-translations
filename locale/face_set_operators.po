msgstr "面集合转顶点组"

#: mask.py:55
msgctxt "Operator"
msgid "Mask from Edit Mode Selection"
msgstr "从编辑模式选择创建遮罩"

#: mask.py:10
msgctxt "Operator"
msgid "Mask selected vertices in sculpt mode.\nWARNING: Will unhide hidden vertices"
msgstr "在雕刻模式下遮罩选中的顶点。\n警告：将取消隐藏隐藏的顶点"

#: mask.py:9
msgctxt "Operator"
msgid "Selection to Sculpt Mask"
msgstr "选择转雕刻遮罩"

#: face_sets.py:79
msgctxt "Operator"
msgid "Transfer the face set index to the material index.\nWill create new material slot with empty node-less material for each face set.\nWARNING: Material colors might blend in with face set colors in sculpt mode if Viewport Shading color is set to Material"
msgstr "将面集合索引传递到材质索引。\n将为每个面集合创建带有空的无节点材质的新材质槽。\n警告：如果视图着色颜色设置为材质，雕刻模式下的材质颜色可能会与面集合颜色混淆"
