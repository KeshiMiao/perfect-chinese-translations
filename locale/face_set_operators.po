msgstr "创建新 UV 贴图"

#: __init__.py:1
msgid "Create material slots, vertex groups, seams, uv islands, and named attributes from sculpt Face Sets"
msgstr "从雕刻面集合创建材质槽、顶点组、缝合边、UV 孤岛和命名属性"

#: face_sets.py:184
msgid "Creates new UV Map. If disabled will overwrite active UV Map, if it exists"
msgstr "创建新的 UV 贴图。若禁用，将覆盖活动 UV 贴图（如果存在）"

#: __init__.py:1
msgid "Face Set Operators"
msgstr "面集合操作"

#: face_sets.py:189
msgid "Keep Existing Seams"
msgstr "保留现有缝合边"

#: face_sets.py:189
msgid "Keep existing seams and use them for UV unwrapping alongside face set boundaries"
msgstr "保留现有缝合边，并将其与面集合边界一起用于 UV 展开"

#: face_sets.py:110
msgid "Material slots were created for each face set"
msgstr "已为每个面集合创建材质槽"

#: __init__.py:1
msgid "Sculpt"
msgstr "雕刻"

#: face_sets.py:238
msgid "UVMap created from face set boundaries"
msgstr "已根据面集合边界创建 UV 贴图"

#: face_sets.py:179
msgid "Unwrap UVs"
msgstr "展开 UV"

#: face_sets.py:151
msgid "Vertex groups were created for each face set"
msgstr "已为每个面集合创建顶点组"

#: face_sets.py:179
msgid "Will automatically unwrap UVs. If disabled it will only create seams"
msgstr "将自动展开 UV。若禁用，则仅创建缝合边"

#: face_sets.py:176
msgctxt "Operator"
msgid "Creates UV islands from Face Set boundaries"
msgstr "根据面集合边界创建 UV 孤岛"

#: face_sets.py:117
msgctxt "Operator"
msgid "Creates Vertex Group for each Face Set"
msgstr "为每个面集合创建顶点组"

#: face_sets.py:158
msgctxt "Operator"
msgid "Creates cached face sets attribute usable outside node tool contexts"
msgstr "创建缓存的 face_sets 属性，可在节点工具上下文之外使用"

#: face_sets.py:157
msgctxt "Operator"
msgid "Face Sets to Attribute"
msgstr "面集合转属性"

#: face_sets.py:78
