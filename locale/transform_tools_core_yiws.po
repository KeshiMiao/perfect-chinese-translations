msgstr "创建一个带 X、Y、Z 轴的 3D Gizmo"

#: transform_tools_core/ui_modules/panels.py:44
msgctxt "Operator"
msgid "Cursor Pivot"
msgstr "游标轴心点"

#: transform_tools_core/ui_modules/operators.py:13
msgctxt "Operator"
msgid "Cursor transform"
msgstr "游标变换"

#: transform_tools_core/ui_modules/operators.py:78
