msgid "Toggle Transform Orientation"
msgstr "切换变换方向"

#: transform_tools_core/ui_modules/operators.py:365
msgctxt "Operator"
msgid "Toggle between the 3D cursor and the last used transform orientation and pivot point"
msgstr "在 3D 游标与上次使用的变换方向和轴心点之间切换"

#: transform_tools_core/ui_modules/panels.py:54
msgctxt "Operator"
msgid "Transform"
msgstr "变换"

#: transform_tools_core/ui_modules/operators.py:187
msgctxt "Operator"
msgid "Transform the selection from the Previous (Faded) Gizmo to the active (Bright) Gizmo"
msgstr "将所选内容从上个（淡显）Gizmo 变换到活动（高亮）Gizmo"

