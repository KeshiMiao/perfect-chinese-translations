msgid "IngeTrazo"
msgstr "IngeTrazo"

#: __init__.py:85
msgid "IngeTrazo does not notice the change by itself: the document has to be closed and opened again there"
msgstr "IngeTrazo 不会自动察觉更改：需要在其中关闭并重新打开文档"

#: __init__.py:161
msgid "IngeTrazo: no UV changes to send"
msgstr "IngeTrazo：没有要发送的 UV 更改"

#: __init__.py:218
#: __init__.py:323
msgid "IngeTrazo: nothing sent"
msgstr "IngeTrazo：未发送任何内容"

#: __init__.py:266
msgid "IngeTrazo: select the cameras to send"
msgstr "IngeTrazo：选择要发送的摄像机"

#: __init__.py:145
#: __init__.py:208
msgid "IngeTrazo: the .igz was saved in IngeTrazo after it was loaded here. Reload first, then send."
msgstr "IngeTrazo：.igz 在此处加载后又在 IngeTrazo 中保存过。请先重新加载，再发送。"

#: __init__.py:367
msgid "No IngeTrazo document yet"
msgstr "尚无 IngeTrazo 文档"

#: __init__.py:402
msgid "Reload when the file changes"
msgstr "文件更改时重新加载"

#: __init__.py:85
msgid "Remind me to reopen the file in IngeTrazo after sending UVs or cameras"
msgstr "发送 UV 或摄像机后提醒我在 IngeTrazo 中重新打开文件"

#: __init__.py:118
msgid "The face keeps the same texture, now as its own paint, mapped as you edited it. Repainting the group in IngeTrazo will no longer change these faces"
msgstr "该面保留相同纹理，现在作为其独立绘制，按你的编辑进行映射。在 IngeTrazo 中重新绘制该组将不再更改这些面"

#: __init__.py:60
msgid "Update materials"
msgstr "更新材质"

#: __init__.py:402
msgid "Watch the imported .igz files and update the scene each time IngeTrazo saves them"
msgstr "监视导入的 .igz 文件，并在 IngeTrazo 每次保存它们时更新场景"

