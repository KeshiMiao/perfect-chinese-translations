msgid "Also write one STL with every part laid out as shown"
msgstr "另外再写一个 STL，包含所有按图示排布的部件"

#: panels.py:96
#: props.py:85
msgid "Artwork"
msgstr "图案"

#: props.py:323
msgid "Border line"
msgstr "边框线"

#: props.py:195
msgid "Build the cutter and the stamp as a mirror image, because both are turned over onto the dough. The cookie then matches the artwork, and lettering reads the right way round"
msgstr "将切模和印章生成为镜像，因为两者都要翻面压到面团上。这样饼干就与图案一致，文字方向也正确"

#: operators.py:278
msgid "Choose at least one kind of file to write."
msgstr "请至少选择一种要写入的文件类型。"

#: props.py:78
msgid "Cookie"
msgstr "饼干"

#: panels.py:72
msgid "Cookie Cutter Studio"
msgstr "Cookie Cutter Studio"

#: props.py:180
msgid "Cookie shape"
msgstr "饼干形状"

#: props.py:171
msgid "Dim every colour except the one selected in the list"
msgstr "将列表中未选中的颜色调暗"

#: props.py:311
msgid "Draft angle"
msgstr "拔模角度"

#: operators.py:275
msgid "Generate the parts first."
msgstr "请先生成部件。"

#: props.py:334
msgid "Handle"
msgstr "手柄"

#: panels.py:122
msgid "Highlight"
msgstr "高亮"

#: props.py:171
msgid "Highlight selected colour"
msgstr "高亮选中的颜色"

#: props.py:311
msgid "How much the sides of the detail lean, in degrees, so the dough lets go of the stamp"
msgstr "细节侧面的倾斜角度（度），使面团易于脱模"

#: props.py:334
msgid "Make a screw-in handle, and a threaded socket for it in the back of the stamp"
msgstr "生成螺纹手柄，并在印章背面生成对应的螺纹孔"

#: props.py:195
msgid "Mirror the parts"
msgstr "镜像部件"

#: operators.py:249
msgid "Name"
msgstr "名称"

#: props.py:122
msgid "On the cookie"
msgstr "饼干上的效果"

#: props.py:370
msgid "One file per part"
msgstr "每个部件一个文件"

#: operators.py:185
msgid "Parts were built, but a check failed. See the Results panel."
msgstr "部件已生成，但检查未通过。请查看“结果”面板。"

#: props.py:375
msgid "Plate"
msgstr "底板"

#: props.py:159
#: props.py:165
msgid "Preview"
msgstr "预览"

#: props.py:159
msgid "Show the cookie in the viewport and keep it up to date"
msgstr "在视图中显示饼干并保持更新"

#: props.py:79
msgid "Stamp"
msgstr "印章"

#: operators.py:249
msgid "Start of every file name"
msgstr "每个文件名的开头"

#: props.py:85
msgid "The artwork laid flat, in its true colours"
msgstr "平铺的图案，显示其真实颜色"

#: props.py:78
msgid "The cookie as it will come out, in relief"
msgstr "饼干成品的浮雕效果"

#: props.py:79
msgid "The face of the stamp: the reverse of the cookie. What is pressed into the cookie stands up here, what is raised on the cookie is a hollow"
msgstr "印章的正面：饼干的反面。压入饼干的部分在此凸起，饼干上凸起的部分在此凹陷"

#: operators.py:308
msgid "The guide is missing from this installation."
msgstr "此安装中缺少该指南。"

#: props.py:122
msgid "What this colour does to the cookie. The stamp is the reverse"
msgstr "该颜色在饼干上的效果。印章与之相反"

#: props.py:180
msgid "Where the outline of the cookie comes from"
msgstr "饼干轮廓的来源"

#: props.py:370
msgid "Write the cutter, stamp and handle as separate STL files"
msgstr "将切模、印章和手柄分别写为独立的 STL 文件"

