msgctxt "Operator"
msgid "Rename Palette…"
msgstr "重命名调色板…"

#: operators.py:712
#: operators.py:909
msgctxt "Operator"
msgid "Rename the current palette"
msgstr "重命名当前调色板"

#: operators.py:1075
#: operators.py:1193
msgctxt "Operator"
msgid "Replace ALL palettes with those from a .json preset file"
msgstr "将所有调色板替换为 .json 预设文件中的调色板"

#: panel.py:603
#: panel.py:1018
msgctxt "Operator"
msgid "Reset Hotkeys"
msgstr "重置快捷键"

#: panel.py:542
msgctxt "Operator"
msgid "Reset THIS palette completely: clear every slot/sub-slot and restore its number of slots and the two outline colours to defaults. Does not touch universal settings or other palettes"
msgstr "完全重置此调色板：清空所有槽位/子槽位，并将槽位数量及两种轮廓颜色恢复为默认值。不会改动通用设置或其他调色板"

#: panel.py:541
#: panel.py:837
msgctxt "Operator"
msgid "Reset This Palette"
msgstr "重置此调色板"

#: panel.py:604
msgctxt "Operator"
msgid "Restore the default hotkeys: Open Palette to \\, Cycle Palette to Tab, and the Jump-to Palette modifier to Ctrl. Does not touch palettes, appearance or the Sculpt Interaction toggles"
msgstr "恢复默认快捷键：打开调色板为 \\，循环切换调色板为 Tab，跳转到调色板修饰键为 Ctrl。不会改动调色板、外观或雕刻交互开关"

#: dynamic_sliders.py:199
msgctxt "Operator"
msgid "Right-click and drag to adjust the brush Radius (horizontal) or Strength (vertical)"
msgstr "右键拖动可调整笔刷半径（水平）或强度（垂直）"

#: panel.py:822
msgctxt "Operator"
msgid "Save Preferences"
msgstr "保存偏好设置"

#: operators.py:1039
#: operators.py:1177
msgctxt "Operator"
msgid "Save all palettes and every universal setting (appearance and interaction) to a .json preset file"
msgstr "将所有调色板及所有通用设置（外观和交互）保存到 .json 预设文件"

#: modal.py:277
msgctxt "Operator"
msgid "Sculptools: Palette"
msgstr "Sculptools: Palette"

#: panel.py:633
msgctxt "Operator"
msgid "Sculptools: Palette - Cycle Palette (Preview)"
msgstr "Sculptools: Palette - 循环切换调色板（预览）"

#: panel.py:668
msgctxt "Operator"
msgid "Sculptools: Palette - Cycle Palette Backwards (Preview)"
msgstr "Sculptools: Palette - 反向循环切换调色板（预览）"

#: dynamic_sliders.py:198
msgctxt "Operator"
msgid "Sculptools: Palette - Dynamic Sliders"
msgstr "Sculptools: Palette - 动态滑块"

#: operators.py:870
msgctxt "Operator"
msgid "Sculptools: Palette - Jump to Palette"
msgstr "Sculptools: Palette - 跳转到调色板"

#: quick_numbers.py:77
msgctxt "Operator"
msgid "Sculptools: Palette - Quick Number"
msgstr "Sculptools: Palette - 快速编号"

#: panel.py:878
msgctxt "Operator"
msgid "Show Preview Editor"
msgstr "显示预览编辑器"

#: panel.py:707
msgctxt "Operator"
msgid "Show/Hide the Palette preview editor in the viewport."
msgstr "在视图中显示/隐藏调色板预览编辑器"

#: operators.py:871
msgctxt "Operator"
msgid "Switch directly to the palette with this number"
msgstr "直接切换到对应编号的调色板"

#: panel.py:634
msgctxt "Operator"
msgid "Switch to the next palette while the Preview Editor is shown. With the wheel open the same key cycles there"
msgstr "显示预览编辑器时切换到下一个调色板。轮盘打开时，同一按键也会在其中循环切换"

#: panel.py:669
msgctxt "Operator"
msgid "Switch to the previous palette while the Preview Editor is shown. With the wheel open the same key cycles there"
msgstr "显示预览编辑器时切换到上一个调色板。轮盘打开时，同一按键也会在其中循环切换"

#: panel.py:706
msgctxt "Operator"
msgid "Toggle Palette Preview"
msgstr "切换调色板预览"
