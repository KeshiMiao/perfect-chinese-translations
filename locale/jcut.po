msgid ""
msgstr ""
"Language: zh_HANS\n"
"Content-Type: text/plain; charset=UTF-8\n"

#: __init__.py:111
msgid "Click the key field and press your new shortcut."
msgstr "点击快捷键输入框，然后按下新的快捷键。"

#: __init__.py:116
msgid "Cuts cross multiple faces and split intervening edges."
msgstr "跨越多个面进行切割，并拆分其间的边。"

#: __init__.py:118
msgid "Disable Quick J to avoid shortcut conflicts."
msgstr "禁用快速 J 以避免快捷键冲突。"

#: __init__.py:95
msgid "Edge snap distance"
msgstr "边吸附距离"

#: __init__.py:114
msgid "Edit Mode: select one vertex, hover a target, use the shortcut."
msgstr "编辑模式：选择一个顶点，悬停在目标上，使用快捷键。"

#: __init__.py:137
msgid "Edit one mesh at a time for JCut"
msgstr "JCut 一次只能编辑一个网格"

#: __init__.py:146
msgid "Select just one starting vertex (or deselect all)"
msgstr "仅选择一个起始顶点（或取消全选）"

#: __init__.py:102
msgid "Shortcut"
msgstr "快捷键"

#: __init__.py:113
msgid "Shortcut unavailable. Re-enable JCut to restore it."
msgstr "快捷键不可用。请重新启用 JCut 以恢复。"

#: __init__.py:140
msgid "Switch to vertex selection mode first"
msgstr "请先切换到顶点选择模式"

#: __init__.py:117
msgid "Unconnectable vertices become the new starting vertex."
msgstr "无法连接的顶点将成为新的起始顶点。"

#: __init__.py:93
msgid "Vertex snap distance"
msgstr "顶点吸附距离"

#: __init__.py:115
msgid "With nothing selected, the shortcut picks the starting vertex."
msgstr "未选择任何内容时，快捷键会选择起始顶点。"

#: __init__.py:124
msgctxt "Operator"
msgid "Cut across faces to a nearby vertex or a new point on an edge"
msgstr "跨面切割至附近的顶点或边上的新点"

#: __init__.py:123
msgctxt "Operator"
msgid "JCut: Connect Under Cursor"
msgstr "JCut：连接光标下的元素"
