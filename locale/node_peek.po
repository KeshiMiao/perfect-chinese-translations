#: __init__.py:157
msgid "Normalize Out-of-Range Data"
msgstr "归一化超出范围的数据"

#: __init__.py:173
msgid "Pin previews on selected nodes: Ctrl+Shift+P"
msgstr "在选中节点上钉住预览：Ctrl+Shift+P"

#: __init__.py:122
msgid "Pixel size of each rendered preview (higher = sharper but slower)"
msgstr "每个渲染预览的像素尺寸（越高越清晰但越慢）"

