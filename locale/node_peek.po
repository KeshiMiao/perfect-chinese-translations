msgstr "EEVEE（实验性）"

#: __init__.py:1173
msgid "Editor overlays are off"
msgstr "编辑器叠加层已关闭"

#: __init__.py:151
msgid "Faster, but often renders black in background mode"
msgstr "更快，但在后台模式下常渲染为黑色"

#: __init__.py:1183
msgid "Individual Preview Size"
msgstr "单个预览大小"

#: __init__.py:1041
msgid "No previewable node selected"
msgstr "未选择可预览的节点"

#: __init__.py:17
msgid "Node"
msgstr "节点"

#: __init__.py:17
#: __init__.py:1148
msgid "Node Peek"
msgstr "Node Peek"

#: __init__.py:1231
#: __init__.py:1273
