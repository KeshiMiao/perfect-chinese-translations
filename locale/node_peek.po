msgstr "更新延迟（秒）"

#: __init__.py:141
msgid "Wait this long after the last edit before re-rendering"
msgstr "上次编辑后等待这段时间再重新渲染"

#: __init__.py:128
msgid "Which nodes get a preview thumbnail"
msgstr "哪些节点获得预览缩略图"

#: __init__.py:1210
msgid "Worker keeps crashing — see worker.log"
msgstr "工作进程反复崩溃 — 见 worker.log"

#: __init__.py:1097
msgctxt "Operator"
msgid "Clear Previews"
msgstr "清除预览"

#: __init__.py:1080
msgctxt "Operator"
msgid "Force a re-render of all node previews, ignoring the cache"
msgstr "强制重新渲染所有节点预览，忽略缓存"

#: __init__.py:1027
msgctxt "Operator"
msgid "Keep the preview visible on the selected nodes even after they are deselected"
msgstr "即使取消选择，也让选中节点上的预览保持可见"

#: __init__.py:1026
msgctxt "Operator"
msgid "Pin Preview"
msgstr "钉住预览"

#: __init__.py:1079
msgctxt "Operator"
msgid "Refresh Previews"
msgstr "刷新预览"

#: __init__.py:1098
msgctxt "Operator"
msgid "Remove all thumbnails and empty the render cache. Previews rebuild on the next edit or Refresh"
msgstr "移除所有缩略图并清空渲染缓存。预览将在下次编辑或刷新时重建"

#: __init__.py:1065
msgctxt "Operator"
msgid "Remove every pinned preview"
msgstr "移除所有钉住的预览"

#: __init__.py:1199
msgctxt "Operator"
msgid "Reset All"
msgstr "全部重置"

#: __init__.py:1134
msgctxt "Operator"
msgid "Reset All Preview Sizes"
msgstr "重置所有预览大小"

#: __init__.py:1119
msgctxt "Operator"
msgid "Reset Selected Preview Sizes"
msgstr "重置选中预览大小"

#: __init__.py:1135
msgctxt "Operator"
msgid "Restore every individually resized preview to its default size"
msgstr "将所有单独调整过大小的预览恢复为默认大小"

#: __init__.py:1120
msgctxt "Operator"
msgid "Restore selected nodes to the default preview size"
msgstr "将选中节点恢复为默认预览大小"

#: __init__.py:1064
msgctxt "Operator"
msgid "Unpin All Previews"
msgstr "取消钉住所有预览"
