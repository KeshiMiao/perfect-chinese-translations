msgid "Render"
msgstr "渲染"

#: ui.py:87
msgid "Select an image plane to edit it"
msgstr "选择图像平面以进行编辑"

#: nodes.py:55
msgid "Shadeless"
msgstr "无光照"

#: operators.py:116
#: operators.py:296
msgid "Shading"
msgstr "着色"

#: ui.py:271
msgid "Show Backface"
msgstr "显示背面"

#: props.py:67
msgid "Show the matte in black and white to fine-tune the keying. White is kept, black is removed"
msgstr "以黑白显示遮罩，以便微调键控。白色保留，黑色移除"

#: operators.py:121
msgid "Standing up, facing the front view"
msgstr "竖立，面向正视图"

#: operators.py:137
msgid "Store the image path relative to the blend file"
msgstr "将图像路径存储为相对于 blend 文件的路径"

#: operators.py:505
msgid "Swap the plane's image for the saved PNG and switch to Image Alpha mode, which is the cheapest shader to render"
msgstr "将平面的图像替换为已保存的 PNG，并切换到图像 Alpha 模式，这是渲染开销最低的着色器"

#: nodes.py:55
msgid "The camera sees the exact image colors regardless of lighting. The plane still casts shadows and shows up lit in reflections"
msgstr "无论光照如何，摄像机看到的都是图像原本的颜色。该平面仍会投射阴影，并在反射中显示为受光"

#: props.py:77
msgid "The untraced plane, kept so the cutout can be re-traced or restored"
msgstr "未描摹的平面，保留以便重新描摹或恢复抠图"

