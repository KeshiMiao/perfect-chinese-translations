msgid "Move Axes"
msgstr "移动轴"

#: bbone_gizmo/preferences.py:63
msgid "Plane Move"
msgstr "平面移动"

#: bbone_gizmo/__init__.py:12
msgid "Rigging"
msgstr "绑定"

#: bbone_gizmo/preferences.py:75
msgid "Scale Axes"
msgstr "缩放轴"

#: bbone_gizmo/__init__.py:12
msgid "Shape bendy bones by dragging viewport Gizmos"
msgstr "拖动视图中的小工具来塑造弯曲骨骼"

#: bbone_gizmo/bbone_gizmo.py:436
msgid "Shape the active bendy bone by dragging the gizmos on its start and end\nMove to bend / ease, the dial twists (roll), the boxes scale the bbone"
msgstr "拖动起点和终点上的小工具来塑造活动弯曲骨骼\n移动可调整弯曲/缓动，圆盘旋拧（滚转），方块缩放 B 骨"

#: bbone_gizmo/preferences.py:69
msgid "Show the dial that twists the bbone around its Y axis (Roll In / Roll Out)"
msgstr "显示绕 Y 轴扭转 B 骨的圆盘（滚入 / 滚出）"

#: bbone_gizmo/preferences.py:81
msgid "Show the dot that moves the handle freely in the view plane"
msgstr "显示可在视图平面中自由移动控制柄的圆点"

#: bbone_gizmo/preferences.py:87
msgid "Show the line from the bone's head / tail to its handle"
msgstr "显示从骨骼头/尾到其控制柄的连线"

#: bbone_gizmo/preferences.py:57
msgid "Show the move arrows along the bone's local axes (X: Curve X, Y: Ease, Z: Curve Z)"
msgstr "显示沿骨骼局部轴的移动箭头（X：曲线 X，Y：缓动，Z：曲线 Z）"

#: bbone_gizmo/preferences.py:75
msgid "Show the scale boxes (Scale In / Scale Out X, Y, Z)"
msgstr "显示缩放方块（向内缩放 / 向外缩放 X、Y、Z）"

#: bbone_gizmo/preferences.py:63
msgid "Show the two-axis plane handles (YZ, XZ, XY) - moves constrained to one plane"
msgstr "显示双轴平面控制柄（YZ、XZ、XY）- 移动限制在一个平面内"

#: bbone_gizmo/preferences.py:48
msgid "Size of the BBone handles. Multiplies Blender's own Gizmo Size preference (Interface > Editors > Gizmo Size)"
msgstr "B 骨控制柄的大小。与 Blender 自身的小工具大小偏好相乘（界面 > 编辑器 > 小工具大小）"

#: bbone_gizmo/preferences.py:69
msgid "Twist (Y)"
msgstr "扭转 (Y)"

#: bbone_gizmo/preferences.py:95
msgid "Visible Gizmos"
msgstr "可见小工具"

#: bbone_gizmo/preferences.py:122
msgid "Y"
msgstr "Y"
