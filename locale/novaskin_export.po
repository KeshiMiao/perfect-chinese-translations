#: __init__.py:5672
msgid "Export Mesh v2: bake the per-character / per-layer relight atlas. OFF reuses the previous export's atlas (re-render other steps without re-baking)"
msgstr "导出网格 v2：烘焙每个角色/每个图层的重新打光图集。关闭则复用上次导出的图集（重新渲染其他步骤而无需重新烘焙）"

#: __init__.py:5676
msgid "Export Mesh v2: render the clean background image. OFF reuses the previous export"
msgstr "导出网格 v2：渲染干净的背景图像。关闭则复用上次导出"

#: __init__.py:5679
msgid "Export Mesh v2: render the per-entity FOREGROUND matte -- one map of everything in front of the entity (scenery occludes + water/glass tints). OFF reuses the previous"
msgstr "导出网格 v2：渲染每个实体的前景遮罩 —— 一张包含实体前方所有内容的图（场景遮挡 + 水/玻璃染色）。关闭则复用上次结果"

#: __init__.py:5683
msgid "Export Mesh v2: render the per-entity shadow ratios (the slow pass). OFF reuses"
msgstr "导出网格 v2：渲染每个实体的阴影比例（较慢的一遍）。关闭则复用"

#: __init__.py:5686
msgid "Export Mesh v2: render the sprite-type scenery layers. OFF reuses the previous"
msgstr "导出网格 v2：渲染精灵类型的场景图层。关闭则复用上次结果"

#: __init__.py:6054
msgid "Fast preview: 50% resolution, few samples"
msgstr "快速预览：50% 分辨率，少量采样"

#: __init__.py:6036
msgid "Fast preview: render everything at 50% resolution with few samples (framing/marking iteration -- not for the final export)"
msgstr "快速预览：以 50% 分辨率和少量采样渲染全部内容（用于构图/标记迭代 —— 不用于最终导出）"

