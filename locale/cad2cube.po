msgid "Recenter"
msgstr "重新居中"

#: preferences.py:28
msgid "Recenter to Origin by Default"
msgstr "默认重新居中到原点"

#: operators.py:165
msgid "Render non-continuous lines (Dashed, Hidden, Center, Dot) as dashed curves"
msgstr "将非连续线（虚线、隐藏线、中心线、点线）渲染为虚线曲线"

#: operators.py:88
msgid "Reuse geometry via instances (memory-efficient, recommended)"
msgstr "通过实例复用几何体（节省内存，推荐）"

#: operators.py:342
msgid "Scale"
msgstr "缩放"

#: operators.py:316
msgid "Scale & Units"
msgstr "缩放与单位"

#: operators.py:349
msgid "Scene"
msgstr "场景"

#: operators.py:180
