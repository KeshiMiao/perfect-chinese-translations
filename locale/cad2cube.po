msgid "Polyline Only"
msgstr "仅多段线"

#: operators.py:151
msgid "Polylines"
msgstr "多段线"

#: operators.py:70
msgid "Put everything in one collection, no layer separation"
msgstr "将所有内容放入一个集合，不分离图层"

#: operators.py:41
msgid "Read $INSUNITS from DXF header"
msgstr "从 DXF 文件头读取 $INSUNITS"

