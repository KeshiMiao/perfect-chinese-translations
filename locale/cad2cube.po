msgstr "圆弧、椭圆、样条每整圈的段数"

#: operators.py:144
msgid "Skip Hidden / Frozen Layers"
msgstr "跳过隐藏/冻结图层"

#: operators.py:92
msgid "Skip all block references entirely"
msgstr "完全跳过所有块参照"

#: operators.py:115
msgid "Skip all hatches"
msgstr "跳过所有填充"

#: operators.py:144
msgid "Skip layers that are off, frozen, or locked in the source file"
msgstr "跳过源文件中关闭、冻结或锁定的图层"

#: operators.py:116
msgid "Solid hatches only"
msgstr "仅实体填充"

#: operators.py:44
msgid "Source is cm, target is m (x0.01)"
msgstr "源为厘米，目标为米（x0.01）"

