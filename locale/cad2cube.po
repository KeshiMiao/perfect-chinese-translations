msgid "Source is m, target is m (x1.0)"
msgstr "源为米，目标为米（x1.0）"

#: operators.py:43
msgid "Source is mm, target is m (x0.001)"
msgstr "源为毫米，目标为米（x0.001）"

#: operators.py:136
msgid "Tint objects with their CAD layer color in the viewport (object color only — no materials, does not affect render). Makes the import look like the original CAD drawing"
msgstr "在视图中用 CAD 图层颜色为物体着色（仅物体颜色——不使用材质，不影响渲染）。使导入结果看起来像原始 CAD 图纸"

#: operators.py:353
msgid "Tol (m)"
msgstr "容差 (m)"

