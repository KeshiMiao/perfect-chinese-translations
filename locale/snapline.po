msgstr "Snapline — 快速参考"

#: snapline/operators.py:276
msgid "Source and Target cannot be the same object"
msgstr "源和目标不能是同一物体"

#: snapline/panels.py:169
msgid "Source ≠ Target"
msgstr "源 ≠ 目标"

#: snapline/panels.py:31
msgid "Target"
msgstr "目标"

#: snapline/props.py:30
msgid "Target Object"
msgstr "目标物体"

#: snapline/panels.py:94
msgid "VERT — free 3-axis swing"
msgstr "顶点 — 自由三轴摆动"

#: snapline/props.py:35
msgid "Vertices"
msgstr "顶点"

#: snapline/props.py:35
msgid "Vertices only"
msgstr "仅顶点"

#: snapline/props.py:34
msgid "Verts + Edge Midpoints + Face Centers"
msgstr "顶点 + 边中点 + 面中心"

