#: properties.py:382
msgid "Price of 1 kg of silicone (A + B), to estimate the cost (0 = don't show)"
msgstr "1 千克硅胶（A + B）的价格，用于估算成本（0 = 不显示）"

#: properties.py:396
msgid "Price of 1 kg of the cast material (0 = don't show)"
msgstr "1 千克浇注材料的价格（0 = 不显示）"

#: ui.py:353
msgid "Print Bed"
msgstr "打印床"

#: properties.py:53
msgid "Print Master on Base"
msgstr "在底座上打印母模"

#: ui.py:230
msgid "Print Master with Sprue"
msgstr "打印带浇道的母模"

#: properties.py:26
msgid "Printable block mold to cast the object itself in silicone (e.g. a hot end sock)"
msgstr "可打印的块状模具，用硅胶浇注物体本身（例如热端硅胶套）"

#: properties.py:19
msgid "Printable box + base to pour a block silicone mold around the master (e.g. a candle)"
msgstr "可打印的盒子 + 底座，在母模周围浇注块状硅胶模具（例如蜡烛）"

#: properties.py:23
msgid "Printable frame + parting board to pour a silicone mold in two halves, for masters with no flat side (figures, balls): pour one half, flip, remove the board, pour the other"
msgstr "可打印的框架 + 分型板，用于浇注两半式硅胶模具，适用于没有平面的母模（人偶、球体）：先浇注一半，翻转，移除分型板，再浇注另一半"

#: properties.py:21
msgid "Printable shell that follows the master's shape to pour a thin silicone mold and save silicone"
msgstr "可打印的外壳，贴合母模形状，用于浇注薄硅胶模具以节省硅胶"

#: properties.py:156
msgid "Put the parting line (where the two silicone halves meet) at the widest section of the master"
msgstr "将分型线（两半硅胶相接处）置于母模最宽处"

#: properties.py:457
msgid "Radius"
msgstr "半径"

#: properties.py:314
msgid "Radius of the air vents (small: they only let the air out)"
msgstr "排气孔半径（较小：仅用于排出空气）"

#: properties.py:324
msgid "Radius of the pour hole or channel where it touches the cast part, narrowing in a short cone: a smaller mark on the part (0 = as wide as the hole)"
msgstr "浇注孔或通道与浇注件接触处的半径，以短锥形收窄：在部件上留下较小的痕迹（0 = 与孔同宽）"

#: properties.py:309
msgid "Radius of the pouring hole"
msgstr "浇注孔半径"

#: properties.py:268
msgid "Radius of the registration keys (0 = automatic from the wall/flange size)"
msgstr "定位键半径（0 = 根据壁/法兰尺寸自动）"

#: properties.py:330
msgid "Radius of the vents where they touch the cast part, narrowing in a short cone: a smaller mark (0 = as wide as the vent)"
msgstr "排气孔与浇注件接触处的半径，以短锥形收窄：留下较小的痕迹（0 = 与排气孔同宽）"

