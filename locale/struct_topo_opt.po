#: ui.py:690
msgid "(select a mesh)"
msgstr "（选择网格）"

#: properties.py:166
msgid "1.0 = keep solid, 0.0 = keep empty, in between = fraction of material to keep inside this region"
msgstr "1.0 = 保持实体，0.0 = 保持空，介于两者之间 = 该区域内保留材料的比例"

#: properties.py:201
msgid "Cancel the solver if a single iteration takes longer than this many seconds"
msgstr "若单次迭代耗时超过此秒数，则取消求解器"

#: properties.py:240
msgid "Close Holes"
msgstr "封闭孔洞"

#: ui.py:783
msgid "Converged"
msgstr "已收敛"

#: properties.py:196
msgid "Convergence Tol"
msgstr "收敛容差"

#: properties.py:155
msgid "Direction"
msgstr "方向"

#: properties.py:155
msgid "Direction of the load (will be normalized)"
msgstr "载荷方向（将被归一化）"

#: properties.py:175
msgid "Edge length of each voxel in scene units"
msgstr "每个体素的边长，以场景单位计"

#: properties.py:240
msgid "Fill open boundary edges for a watertight mesh"
msgstr "填充开放的边界边以生成水密网格"

#: properties.py:186
msgid "Filter Radius (voxels)"
msgstr "过滤半径（体素）"

#: properties.py:235
msgid "Force load voxels solid in the extracted mesh"
msgstr "在提取的网格中强制将载荷体素设为实体"

#: properties.py:230
msgid "Force support voxels solid in the extracted mesh"
msgstr "在提取的网格中强制将支撑体素设为实体"

#: properties.py:139
msgid "Fraction of the domain to keep as material (volume fraction)"
msgstr "保留为材料的区域比例（体积分数）"

#: properties.py:212
msgid "Grid Info"
msgstr "体素网格信息"

#: properties.py:221
msgid "Hide voxels below this density in the result view"
msgstr "在结果视图中隐藏低于此密度的体素"

#: properties.py:235
msgid "Include Loads"
msgstr "包含载荷"

#: properties.py:230
msgid "Include Supports"
msgstr "包含支撑"

#: ui.py:725
msgid "Increase voxel size to reduce DOF count"
msgstr "增大体素尺寸以减少自由度数量"

#: properties.py:201
msgid "Iter Timeout (s)"
msgstr "迭代超时（秒）"

#: properties.py:245
msgid "Laplacian smoothing strength per pass (0 = off)"
msgstr "每次平滑的拉普拉斯平滑强度（0 = 关闭）"

#: properties.py:149
msgid "Lateral contraction ratio. Steel ~0.3, rubber ~0.49"
msgstr "横向收缩比。钢约 0.3，橡胶约 0.49"

#: properties.py:144
msgid "Material stiffness. Steel ~200, aluminum ~70, plastic ~2"
msgstr "材料刚度。钢约 200，铝约 70，塑料约 2"

#: properties.py:191
msgid "Max Iterations"
msgstr "最大迭代次数"

#: properties.py:206
msgid "Maximum density change per OC step. Lower = more stable, higher = faster"
msgstr "每个 OC 步的最大密度变化。越低越稳定，越高越快"

#: properties.py:191
msgid "Maximum optimization iterations before stopping"
msgstr "停止前的最大优化迭代次数"

#: ui.py:716
msgid "Model Actions"
msgstr "模型操作"

#: ui.py:249
msgid "No mesh objects selected."
msgstr "未选择网格物体。"

#: ui.py:500
msgid "No preview mesh — run 'Voxelize & Preview' first."
msgstr "无预览网格 — 请先运行「体素化并预览」。"

#: ui.py:599
msgid "No solve result — run Solve first."
msgstr "无求解结果 — 请先运行求解。"

#: ui.py:319
msgid "No tagged meshes found."
msgstr "未找到已标记的网格。"

#: ui.py:613
msgid "No voxels above threshold — lower the threshold."
msgstr "没有高于阈值的体素 — 请降低阈值。"

#: properties.py:250
msgid "Number of smoothing passes"
msgstr "平滑次数"

#: properties.py:206
msgid "OC Move Limit"
msgstr "OC 移动限制"

#: properties.py:250
#: ui.py:798
msgid "Passes"
msgstr "次数"

#: properties.py:181
msgid "Penalization exponent. Higher = more 0/1 result, less smooth"
msgstr "惩罚指数。越高结果越接近 0/1，越不平滑"

#: __init__.py:12
msgid "Physics"
msgstr "物理"

#: properties.py:149
msgid "Poisson's Ratio"
msgstr "泊松比"

