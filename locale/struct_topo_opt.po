msgstr "阈值"

#: properties.py:160
msgid "Total Force (kN)"
msgstr "总力（kN）"

#: properties.py:160
msgid "Total force applied to the load region, distributed equally across all load voxels"
msgstr "施加到载荷区域的总力，平均分配到所有载荷体素"

#: ui.py:710
msgid "Voxel Grid"
msgstr "体素网格"

#: properties.py:175
msgid "Voxel Size"
msgstr "体素尺寸"

#: ui.py:770
msgid "Voxelize first"
msgstr "请先体素化"

#: properties.py:131
