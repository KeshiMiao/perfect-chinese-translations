msgstr "SIMP 惩罚"

#: __init__.py:12
msgid "SIMP+OC structural topology optimisation with voxelized meshes"
msgstr "基于体素化网格的 SIMP+OC 结构拓扑优化"

#: ui.py:688
msgid "Selected Object"
msgstr "选定物体"

#: properties.py:186
msgid "Sensitivity filter radius in voxel units. Prevents checkerboards"
msgstr "以体素为单位的灵敏度过滤半径。可防止棋盘格现象"

#: ui.py:261
msgid "Show Domain Voxels"
msgstr "显示域体素"

#: ui.py:261
msgid "Show plain (no role) domain voxels as grey cubes"
msgstr "将无角色的普通域体素显示为灰色立方体"

#: properties.py:245
