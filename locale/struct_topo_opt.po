msgstr "当最大密度变化低于此值时停止"

#: ui.py:680
msgid "Struct Topo"
msgstr "结构拓扑"

#: __init__.py:12
#: ui.py:676
msgid "Structural Topology Optimization"
msgstr "结构拓扑优化"

#: ui.py:671
