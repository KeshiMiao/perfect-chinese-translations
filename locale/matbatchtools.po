#: __init__.py:53
msgid "32-bit floating point color per channel - recommended for baked HDR light"
msgstr "每通道 32 位浮点颜色 - 推荐用于烘焙的 HDR 光照"

#: __init__.py:53
msgid "8-bit integer color per channel - the most common format for game engines"
msgstr "每通道 8 位整数颜色 - 游戏引擎中最常见的格式"

