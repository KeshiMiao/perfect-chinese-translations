#: region.py:703
msgid "A 3 x 3 x 3 lattice you can reshape"
msgstr "可重塑的 3 x 3 x 3 晶格"

#: guided.py:336
msgid "A box, a sphere, a lattice or any closed mesh that marks a part to redo"
msgstr "用于标记要重做部分的立方体、球体、晶格或任意封闭网格"

#: guided.py:3436
msgid "A box, a sphere, or the shapes you have selected"
msgstr "立方体、球体或所选形状"

#: region.py:703
msgid "A box, or a 3 x 3 x 3 lattice you can reshape to fit the part to redo"
msgstr "立方体，或可重塑以贴合待重做部分的 3 x 3 x 3 晶格"

#: segment_goals.py:53
msgid "A clean quad sheet: even rows and few poles, so it bends well. Judged mainly on its topology score"
msgstr "整洁的四边面片：行列均匀、极点少，弯曲效果好。主要依据拓扑评分评判"

#: guided.py:345
msgid "A curve, a Grease Pencil drawing, or a mesh made of edges only. The quads are made to follow it"
msgstr "曲线、蜡笔手绘或仅由边构成的网格。四边面会沿其生成"

#: guided.py:65
msgid "A line across a joint or crease: several evenly spaced loops so the mesh bends without pinching"
msgstr "跨关节或折痕的线：生成多条均匀间隔的环，使网格弯曲时不夹紧"

#: guided.py:64
msgid "A loop or flow line drawn by hand: it becomes real continuous edge loops of regular quads, with the poles outside it"
msgstr "手绘的环线或走向线：会成为由规则四边面组成的真实连续边环，极点位于其外侧"

#: seglive.py:68
msgid "A part smaller than this share of its loose piece joins its neighbour"
msgstr "小于所属松散块此比例的部分会并入相邻部分"

#: region.py:47
msgid "A regular grid. Cleanest when the region has four clear sides; otherwise it is laid out and closed to quads"
msgstr "规则网格。区域有四条清晰边时最整洁；否则会布局并封闭为四边面"

#: profiles.py:16
msgid "A regular grid. Needs a part with one open edge loop; a closed part falls back to Auto"
msgstr "规则网格。需要具有一个开放边环的部分；封闭部分会回退为自动"

#: guided.py:3436
msgid "A round shape you can move and scale"
msgstr "可移动和缩放的圆形形状"

#: guided.py:78
msgid "A share of the faces your mesh has now"
msgstr "当前网格面数的比例"

#: __init__.py:249
msgid "A stopped job keeps its finished parts in the add-on's user folder, so Start resumes it."
msgstr "停止的任务会将已完成部分保留在插件的用户文件夹中，因此点击开始可继续。"

#: guided.py:63
msgid "A thin line the quads follow, like a panel line"
msgstr "四边面沿其生成的细线，例如面板线"

#: region.py:41
msgid "Add"
msgstr "添加"

#: region.py:1014
msgid "Add a cage, then move it over the part"
msgstr "添加一个笼，然后将其移到该部分上方"

#: region.py:560
msgid "Add a ring of quads along jagged borders so quads next to the seam stay well shaped"
msgstr "沿锯齿边界添加一圈四边面，使接缝旁的四边面保持良好形状"

#: region.py:41
msgid "Add the faces inside this cage to the region"
msgstr "将此笼内的面添加到区域"

#: panel.py:582
msgid "Adjust"
msgstr "调整"

