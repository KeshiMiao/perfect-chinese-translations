#: bl/operators.py:329
msgctxt "Operator"
msgid "Wire cones at the -6 dB coverage angles of the selected band, parented to each speaker"
msgstr "在所选频段的 -6 dB 覆盖角度处绘制线框锥体，并父级到各扬声器"
