#: __init__.py:3118
msgid "1. Overlap Source and Target."
msgstr "1. 让源和目标重叠。"

#: __init__.py:3112
msgid "1. Put Source in neutral."
msgstr "1. 将源设为中性姿态。"

#: __init__.py:3113
msgid "2. Load/create correspondences."
msgstr "2. 加载/创建对应关系。"

#: __init__.py:3119
msgid "2. Put Source in neutral."
msgstr "2. 将源设为中性姿态。"

#: __init__.py:3120
msgid "3. Build Surface Map."
msgstr "3. 构建表面映射。"

#: __init__.py:3114
msgid "3. Fit / Build Transfer Map."
msgstr "3. 拟合/构建传递映射。"

#: __init__.py:3121
msgid "4. Change Source deformation."
msgstr "4. 更改源变形。"

#: __init__.py:3115
msgid "4. Change Source expression."
msgstr "4. 更改源表情。"

#: __init__.py:3116
#: __init__.py:3122
msgid "5. Transfer to Target shape key."
msgstr "5. 传递到目标形态键。"

