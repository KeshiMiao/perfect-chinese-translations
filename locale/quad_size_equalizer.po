msgstr "上次目标"

#: __init__.py:737
msgid "Length"
msgstr "长度"

#: __init__.py:271
msgid "Lower Iterations or Vertex Limit if Blender felt stuck."
msgstr "如果 Blender 卡顿，请降低迭代次数或顶点上限。"

#: __init__.py:295
msgid "Manual Length"
msgstr "手动长度"

#: __init__.py:284
msgid "Match Smaller Faces"
msgstr "匹配较小面"

#: __init__.py:290
msgid "Match Smallest Edges"
msgstr "匹配最小边"

