#: __init__.py:619
msgid "Added QSE Fine Displacement. Pattern Scale / Fine Amount / Displacement are on the modifier."
msgstr "已添加 QSE 精细置换。图案缩放 / 精细量 / 置换在修改器上。"

#: __init__.py:339
msgid "After equalizing, convert every face to triangles. Best for displacement and cloth; keep off if you still want quads"
msgstr "均衡后将所有面转换为三角面。最适合置换和布料；若仍想保留四边面请关闭"

#: __init__.py:290
msgid "Aim for the shortest edges (ignores the smallest 2% as outliers)"
msgstr "以最短边为目标（忽略最小的 2% 作为离群值）"

#: __init__.py:4
msgid "Community edition: subdivide large quads until they match the smaller ones, without changing the object's shape and without T-junctions. Mesh tool — run after Subdivision / Bevel, before Displace or cloth."
msgstr "社区版：细分较大的四边面直至与较小的面匹配，不改变物体形状且不产生 T 形接点。网格工具 — 在细分 / 倒角之后、置换或布料之前运行。"

#: __init__.py:326
msgid "Each pass halves remaining long edges. 6 = up to 64 splits per edge"
msgstr "每次迭代将剩余长边减半。6 = 每条边最多 64 次分割"

#: __init__.py:303
msgid "Edges longer than this percentile (times tolerance) are split. Lower = denser, closer to the smallest quads"
msgstr "长于此百分位的边（乘以容差）会被分割。数值越低 = 越密集，越接近最小的四边面"

#: __init__.py:318
msgid "Edges may stay this many times longer than the target. 1.0 is strict, 1.3 is a good default"
msgstr "边可保持为目标长度的这么多倍。1.0 为严格，1.3 是合适的默认值"

#: __init__.py:376
msgid "Equalize after Subdivision/Bevel and apply those modifiers. Displace and other later modifiers stay on the object"
msgstr "在细分/倒角后均衡并应用这些修改器。置换及其他后续修改器保留在物体上"

#: __init__.py:359
msgid "Equalize faces outside the vertex group instead"
msgstr "改为均衡顶点组之外的面"

#: __init__.py:617
msgid "Geometry Nodes test displacement already on the object"
msgstr "物体上已有的几何节点测试置换"

#: __init__.py:354
#: __init__.py:752
msgid "Group"
msgstr "组"

#: __init__.py:280
msgid "How the target edge length is chosen"
msgstr "目标边长如何选取"

