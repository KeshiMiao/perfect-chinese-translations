msgid "Nothing to equalize"
msgstr "没有可均衡的内容"

#: __init__.py:721
msgid "Old Geometry Nodes placeholder"
msgstr "旧的几何节点占位符"

#: __init__.py:546
msgid "Old Geometry Nodes placeholder removed"
msgstr "已移除旧的几何节点占位符"

#: __init__.py:354
msgid "Only equalize faces in this vertex group. Empty = whole mesh"
msgstr "仅均衡此顶点组中的面。留空 = 整个网格"

#: __init__.py:303
#: __init__.py:735
msgid "Percentile"
msgstr "百分位"

#: __init__.py:806
msgid "QSE"
msgstr "QSE"

#: __init__.py:786
#: __init__.py:802
msgid "Quad Size Equalizer"
msgstr "四边面尺寸均衡器"

#: __init__.py:4
msgid "Quad Size Equalizer (Community)"
msgstr "四边面尺寸均衡器（社区版）"

#: __init__.py:364
msgid "Relax on Surface"
msgstr "在表面松弛"

#: __init__.py:705
msgid "Select at least one edge"
msgstr "请至少选择一条边"

#: __init__.py:651
msgid "Select faces (or vertices) first"
msgstr "请先选择面（或顶点）"

#: __init__.py:364
msgid "Slide vertices on the original surface after splitting to even leftover 2:1 jumps. Tiny shape change possible"
msgstr "分割后在原始表面上滑动顶点，以抹平残留的 2:1 跳变。可能产生轻微形状变化"

#: __init__.py:370
msgid "Split edges longer than 2× the target and collapse edges shorter than 0.8× so quads stay closer to uniform size"
msgstr "分割长于目标 2 倍的边，并塌陷短于 0.8 倍的边，使四边面尺寸更趋一致"

#: __init__.py:345
msgid "Stop refining beyond this many vertices. 0 = no limit. Type a larger value if the slider stops too early"
msgstr "超过此顶点数后停止细化。0 = 不限制。若滑块过早停止，请输入更大的值"

#: __init__.py:311
msgid "Target Length"
msgstr "目标长度"

#: __init__.py:311
msgid "Target edge length in scene units (Manual mode)"
msgstr "以场景单位表示的目标边长（手动模式）"

#: __init__.py:577
msgid "Test material assigned (Displacement and Bump). Use Cycles; Displacement-only looks faceted and is unsupported in EEVEE."
msgstr "已指定测试材质（置换和凹凸）。请使用 Cycles；仅用置换会显得有棱面，EEVEE 不支持。"

#: __init__.py:269
msgid "This can take a while and use a lot of RAM."
msgstr "这可能需要一些时间并占用大量内存。"

#: __init__.py:318
#: __init__.py:740
msgid "Tolerance"
msgstr "容差"

#: __init__.py:339
msgid "Triangulate All"
msgstr "全部三角化"

#: __init__.py:333
msgid "Triangulate N-gons"
msgstr "三角化多边面"

#: __init__.py:333
msgid "Triangulate n-gons (caps, poles) so they can be refined. Off keeps caps intact and avoids sliver triangles"
msgstr "三角化多边面（封盖、极点）以便细化。关闭则保持封盖完整并避免细长三角形"

#: __init__.py:370
msgid "Uniform Size"
msgstr "统一尺寸"

#: __init__.py:376
msgid "Use Modifiers"
msgstr "使用修改器"

#: __init__.py:295
msgid "Use a fixed target edge length in scene units"
msgstr "使用以场景单位表示的固定目标边长"

#: __init__.py:284
msgid "Use a percentile of current edge lengths so tiny outliers do not force the whole mesh to explode"
msgstr "使用当前边长的百分位，避免极小的离群值导致整个网格爆炸式细分"

#: __init__.py:345
#: __init__.py:742
msgid "Vertex Limit"
msgstr "顶点上限"

#: __init__.py:587
msgctxt "Operator"
msgid "Add Displacement Test (Geometry Nodes)"
msgstr "添加置换测试（几何节点）"

#: __init__.py:552
msgctxt "Operator"
msgid "Add Displacement Test Material"
msgstr "添加置换测试材质"

#: __init__.py:588
msgctxt "Operator"
msgid "Add a Geometry Nodes modifier with the same fine Voronoi/Noise/Ridge pattern as the test material. Vertices move along normals so you can check topology in the viewport"
msgstr "添加带与测试材质相同的精细 Voronoi/噪波/脊线图案的几何节点修改器。顶点沿法线移动，便于在视图中检查拓扑"

#: __init__.py:761
msgctxt "Operator"
msgid "Apply"
msgstr "应用"

#: __init__.py:392
msgctxt "Operator"
msgid "Apply Quad Size Equalizer"
msgstr "应用四边面尺寸均衡器"

#: __init__.py:506
msgctxt "Operator"
msgid "Apply the leftover Geometry Nodes placeholder onto the mesh, then remove it"
msgstr "将残留的几何节点占位符应用到网格上，然后将其移除"

#: __init__.py:553
msgctxt "Operator"
msgid "Assign a fine procedural displacement material. Use Cycles rendered view — uneven topology shows as blotchy detail"
msgstr "指定一个精细的程序化置换材质。使用 Cycles 渲染视图——不均匀的拓扑会显现为斑块细节"

#: __init__.py:669
msgctxt "Operator"
msgid "Clear QSE Selection"
msgstr "清除 QSE 选择"

#: __init__.py:441
msgctxt "Operator"
msgid "Create a new object with the equalized mesh. The original stays unchanged"
msgstr "用均衡后的网格创建新物体。原物体保持不变"

#: __init__.py:630
msgctxt "Operator"
msgid "Create vertex group 'QSE' from selected faces and only equalize those"
msgstr "从选中面创建顶点组「QSE」，仅均衡这些面"

#: __init__.py:756
msgctxt "Operator"
msgid "Edges"
msgstr "边"

#: __init__.py:670
msgctxt "Operator"
msgid "Equalize the whole mesh again"
msgstr "再次均衡整个网格"

#: __init__.py:440
msgctxt "Operator"
msgid "Equalize to Copy"
msgstr "均衡到副本"

#: __init__.py:755
msgctxt "Operator"
msgid "Faces"
msgstr "面"

#: __init__.py:770
msgctxt "Operator"
msgid "GN Displace"
msgstr "几何节点置换"

#: __init__.py:723
msgctxt "Operator"
msgid "Keep Result & Remove"
msgstr "保留结果并移除"

#: __init__.py:629
msgctxt "Operator"
msgid "QSE: Faces to Vertex Group"
msgstr "QSE：面转顶点组"

#: __init__.py:687
msgctxt "Operator"
msgid "QSE: Selected Edge as Target"
msgstr "QSE：以选中边为目标"

#: __init__.py:505
msgctxt "Operator"
msgid "Remove Old Geometry Nodes"
msgstr "移除旧的几何节点"

#: __init__.py:765
msgctxt "Operator"
msgid "Test Material"
msgstr "测试材质"

#: __init__.py:762
msgctxt "Operator"
msgid "To Copy"
msgstr "到副本"

#: __init__.py:688
msgctxt "Operator"
msgid "Use the shortest selected edge as the target length (Manual mode)"
msgstr "使用最短的选中边作为目标长度（手动模式）"

#: __init__.py:393
msgctxt "Operator"
msgid "Write equalized topology onto this mesh. Enable Use Modifiers to include Subdivision/Bevel first"
msgstr "将均衡后的拓扑写入此网格。先启用「使用修改器」以包含细分/倒角"
