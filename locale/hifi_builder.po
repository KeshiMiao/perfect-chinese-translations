msgctxt "Operator"
msgid "Apply"
msgstr "应用"

#: hifi_builder/hifi_uv_anim.py:254
msgctxt "Operator"
msgid "Apply Sollumz emissive.sps material, generate seamless UV scrolling, convert to Sollumz Drawable, create anim@ Clip Dictionary targeting Material, and configure YTYP with UV anim flags"
msgstr "应用 Sollumz emissive.sps 材质，生成无缝 UV 滚动，转换为 Sollumz Drawable，创建以材质为目标的 anim@ Clip Dictionary，并配置带 UV 动画标记的 YTYP"

#: hifi_builder/operators.py:111
msgctxt "Operator"
msgid "Apply Transforms"
msgstr "应用变换"

#: hifi_builder/hifi_auto_anim.py:160
msgctxt "Operator"
msgid "Automatically build a 2-bone skeleton, bind vertex weights, apply linear 360-degree spin keyframes, and configure Sollumz Drawable structure"
msgstr "自动构建 2 骨骼骨架，绑定顶点权重，应用线性 360 度旋转关键帧，并配置 Sollumz Drawable 结构"

