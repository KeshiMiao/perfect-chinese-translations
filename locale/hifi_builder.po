msgctxt "Operator"
msgid "Bake Rig Action (NLA / Constraints)"
msgstr "烘焙绑定动作（NLA / 约束）"

#: hifi_builder/hifi_custom_rig.py:975
msgctxt "Operator"
msgid "Bake the rig's evaluated NLA/constraints/procedural motion into an Action before export. This bakes existing motion; it does not create a spin."
msgstr "在导出前将绑定评估后的 NLA/约束/程序化运动烘焙为动作。此操作仅烘焙现有运动，不会创建旋转。"

#: hifi_builder/operators.py:189
msgctxt "Operator"
msgid "Center the active object to world zero (0,0,0), center its geometry origin, and freeze all transforms (location, rotation, scale)"
msgstr "将活动物体居中到世界原点 (0,0,0)，居中其几何原点，并冻结所有变换（位置、旋转、缩放）"

#: hifi_builder/operators.py:177
#: hifi_builder/ui.py:37
