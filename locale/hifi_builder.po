msgctxt "Operator"
msgid "Clear Preview"
msgstr "清除预览"

#: hifi_builder/operators.py:49
msgctxt "Operator"
msgid "Clear Previews"
msgstr "清除预览"

#: hifi_builder/hifi_auto_anim.py:371
msgctxt "Operator"
msgid "Construct the Sollumz anim@ Clip Dictionary with linked GTA animation, action data, and clip properties"
msgstr "构建包含关联 GTA 动画、动作数据和片段属性的 Sollumz anim@ Clip Dictionary"

#: hifi_builder/operators.py:9
msgctxt "Operator"
msgid "Convert the active real-time preview into a permanent mesh in your scene with applied transforms and median origin"
msgstr "将活动实时预览转换为场景中的永久网格，并应用变换和中心原点"

#: hifi_builder/operators.py:144
msgctxt "Operator"
msgid "Copy Location, Rotation, and Scale to Clipboard in formatted text, including one-click CodeWalker (X, Y, Z) coordinates"
msgstr "以格式化文本将位置、旋转和缩放复制到剪贴板，包含一键 CodeWalker (X, Y, Z) 坐标"

#: hifi_builder/ui.py:208
msgctxt "Operator"
msgid "Copy To Clipboard"
msgstr "复制到剪贴板"

#: hifi_builder/operators.py:143
msgctxt "Operator"
msgid "Copy Transform"
msgstr "复制变换"

#: hifi_builder/hifi_custom_rig.py:943
msgctxt "Operator"
msgid "Create the anim@ Clip Dictionary, bind the detected custom Action, and configure clip duration/frame bounds."
msgstr "创建 anim@ Clip Dictionary，绑定检测到的自定义动作，并配置片段时长/帧范围。"

#: hifi_builder/hifi_custom_rig.py:926
msgctxt "Operator"
msgid "Detect the rig's existing Action, prepare the export copy, organize the export collection, apply bone flags, and convert meshes/Armature to Sollumz Drawables."
msgstr "检测绑定现有的动作，准备导出副本，整理导出集合，应用骨骼标记，并将网格/骨架转换为 Sollumz Drawable。"

#: hifi_builder/hifi_collision.py:78
msgctxt "Operator"
msgid "Duplicate mesh in-place, optimize geometry, convert to Sollumz Composite, apply flag preset to .col.bvh, and assign chosen collision material to .col.poly_mesh"
msgstr "原地复制网格，优化几何体，转换为 Sollumz Composite，将标记预设应用到 .col.bvh，并将所选碰撞材质指定给 .col.poly_mesh"

#: hifi_builder/operators.py:8
#: hifi_builder/ui.py:121
msgctxt "Operator"
msgid "Generate Mesh"
msgstr "生成网格"

#: hifi_builder/hifi_auto_anim.py:552
msgctxt "Operator"
msgid "Generate the YTYP definition, link the clip dictionary, and automatically enable GTA V animation streaming flags"
msgstr "生成 YTYP 定义，关联片段字典，并自动启用 GTA V 动画流式加载标记"

#: hifi_builder/hifi_custom_rig.py:959
msgctxt "Operator"
msgid "Generate the YTYP, create the Archetype from the custom skeleton, link the anim@ Clip Dictionary, and enable animation streaming flags."
msgstr "生成 YTYP，从自定义骨架创建原型，关联 anim@ Clip Dictionary，并启用动画流式加载标记。"

