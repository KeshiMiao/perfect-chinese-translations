#: plateline_light/core.py:555
msgid "# runs become the shot number, @ runs the sequence. e.g. @@@@_#### gives 0010_0010, 0010_0020, then 0020_0010"
msgstr "# 连续段成为镜头编号，@ 连续段成为序列编号。例如 @@@@_#### 得到 0010_0010、0010_0020，然后 0020_0010"

