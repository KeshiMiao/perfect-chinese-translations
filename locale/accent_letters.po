#: accent_letters/__init__.py:154
#: accent_letters/__init__.py:157
msgid "Accent Letters"
msgstr "变音字母"

#: accent_letters/__init__.py:171
msgid "Adds to the end — Tab to edit"
msgstr "添加到末尾 — 按 Tab 编辑"

#: accent_letters/__init__.py:74
msgid "Character"
msgstr "字符"

#: accent_letters/__init__.py:106
msgid "Convert"
msgstr "转换"

#: accent_letters/__init__.py:114
msgid "Drop the mark"
msgstr "去掉变音符号"

#: accent_letters/__init__.py:111
msgid "German umlauts"
msgstr "德语变音符号"

#: accent_letters/__init__.py:169
msgid "Goes in at the cursor"
msgstr "在光标处插入"

#: accent_letters/__init__.py:107
msgid "Keep"
msgstr "保留"

#: accent_letters/__init__.py:107
msgid "Leave them as they are"
msgstr "保持原样"

#: accent_letters/__init__.py:102
msgid "Letters with no plain form"
msgstr "没有普通形式的字母"

#: accent_letters/__init__.py:78
msgid "No letter given"
msgstr "未提供字母"

#: accent_letters/__init__.py:175
msgid "No letter matches that"
msgstr "没有匹配的字母"

#: accent_letters/__init__.py:195
msgid "Search"
msgstr "搜索"

#: accent_letters/__init__.py:195
msgid "Search by the letter, its name, the accent mark, a language or a code point"
msgstr "按字母、名称、变音符号、语言或码位搜索"

#: accent_letters/__init__.py:167
msgid "Select a text object"
msgstr "选择一个文本物体"

#: accent_letters/__init__.py:83
msgid "Select a text object first"
msgstr "请先选择一个文本物体"

#: accent_letters/__init__.py:181
msgid "Showing the first %d — keep typing to narrow"
msgstr "显示前 %d 个 — 继续输入以缩小范围"

#: accent_letters/__init__.py:115
msgid "Spell out"
msgstr "拼写出来"

#: accent_letters/__init__.py:141
msgid "There are no accents to remove in the selected text"
msgstr "所选文本中没有可移除的变音符号"

#: accent_letters/__init__.py:102
msgid "What to do with ø, ł, đ, ß, æ, œ and þ, which Unicode does not decompose"
msgstr "如何处理 ø、ł、đ、ß、æ、œ 和 þ，Unicode 不会分解这些字符"

#: accent_letters/__init__.py:114
msgid "ä becomes a"
msgstr "ä 变为 a"

#: accent_letters/__init__.py:115
msgid "ä becomes ae"
msgstr "ä 变为 ae"

#: accent_letters/__init__.py:106
msgid "ø becomes o, ß becomes ss, æ becomes ae"
msgstr "ø 变为 o，ß 变为 ss，æ 变为 ae"

#: accent_letters/__init__.py:70
msgctxt "Operator"
msgid "Insert accented letter"
msgstr "插入变音字母"

#: accent_letters/__init__.py:71
msgctxt "Operator"
msgid "Put this letter in the active text object"
msgstr "将此字母放入活动文本物体"

#: accent_letters/__init__.py:98
msgctxt "Operator"
msgid "Remove accents"
msgstr "移除变音符号"

#: accent_letters/__init__.py:99
msgctxt "Operator"
msgid "Rewrite the selected text objects without their accents"
msgstr "重写所选文本物体，去除其变音符号"
