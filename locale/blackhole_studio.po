#: properties.py:92
#: ui.py:149
msgid "Accretion Disk"
msgstr "吸积盘"

#: properties.py:267
msgid "Add an invisible emitter matching the disk so it lights nearby objects (Cycles, Eevee)"
msgstr "添加与吸积盘匹配的不可见发光体，使其照亮附近物体（Cycles、EEVEE）"

#: ui.py:219
msgid "Artistic"
msgstr "艺术效果"

#: params.py:147
msgid "Beaming Exponent"
msgstr "集束指数"

#: properties.py:238
msgid "Bend the view of real scene objects behind the black hole using a steered refraction (Cycles only). Off: the lensed background is the skybox/starfield"
msgstr "通过受控折射弯曲黑洞后方真实场景物体的视图（仅 Cycles）。关闭时：透镜化背景为天空盒/星空"

