msgstr "多普勒与红移"

#: params.py:147
msgid "Doppler Beaming"
msgstr "多普勒集束"

#: properties.py:189
msgid "Draft (8)"
msgstr "草稿（8）"

#: properties.py:198
msgid "Draw the photon-sphere and horizon markers and the disk-light outline in the viewport"
msgstr "在视图中绘制光子球和视界标记以及吸积盘光照轮廓"

#: properties.py:195
msgid "Draw the wireframe of the lens sphere in the viewport (it always renders)"
msgstr "在视图中绘制透镜球线框（它始终参与渲染）"

#: properties.py:272
msgid "Drive World Background"
msgstr "驱动世界背景"

#: properties.py:141
msgid "Each radius orbits at its real Keplerian speed (inner parts faster), so structures wind into spirals over time"
msgstr "各半径按真实开普勒速度公转（内侧更快），因此结构会随时间卷成旋臂"

#: params.py:147
msgid "Einstein Ring Glow"
msgstr "爱因斯坦环辉光"

#: properties.py:245
msgid "Equirectangular (2:1) sky image. Defaults to the bundled Milky Way (NASA); use the folder icon to load your own"
msgstr "等距圆柱（2:1）天空图像。默认使用捆绑的银河（NASA）；使用文件夹图标加载自定义图像"

#: operators.py:24
#: properties.py:46
msgid "Exact (Cycles OSL)"
msgstr "精确（Cycles OSL）"

#: properties.py:43
msgid "Exact Schwarzschild geodesics from a precomputed lookup table, evaluated with shader nodes. Works on GPU and in Eevee"
msgstr "从预计算查找表获取精确史瓦西测地线，用着色器节点求值。支持 GPU 和 EEVEE"

#: ui.py:42
msgid "Exact mode needs Cycles + OSL (CPU)"
msgstr "精确模式需要 Cycles + OSL（CPU）"

#: properties.py:81
msgid "Exact mode: RK4 steps per 2π of orbital angle"
msgstr "精确模式：轨道角每 2π 的 RK4 步数"

#: operators.py:23
#: properties.py:43
msgid "Fast (GPU / Eevee)"
msgstr "快速（GPU / EEVEE）"

