msgstr "选中的木板"

#: properties.py:278
msgid "Separate End Depth"
msgstr "分开端部深度"

#: properties.py:255
msgid "Shape of the grain ridges. 0 = soft, rolling waves; 1 = narrow, crisp ridges between wide, scooped grooves"
msgstr "木纹脊线的形状。0 = 柔和起伏的波浪；1 = 宽阔凹槽之间有窄而清晰的脊线。"

#: properties.py:367
msgid "Show Grain Pattern"
msgstr "显示木纹图案"

