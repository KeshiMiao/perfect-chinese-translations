msgstr "."

#: operators.py:282
msgid "0 = sharp corner, 1 = as round as the board allows"
msgstr "0 = 尖角，1 = 板材允许的最大圆角"

#: operators.py:276
msgid "All 12 edges"
msgstr "全部 12 条边"

#: operators.py:276
msgid "All Edges"
msgstr "所有边"

#: properties.py:296
msgid "Amount of cracks (checks): straight splits along the long faces and radial cracks on the ends. 0 = none; 1 = about 6 per metre and 4 per end"
msgstr "裂缝（干裂）数量：长面上的直线开裂以及端部的径向裂纹。0 = 无；1 = 每米约 6 条、每端约 4 条"

#: properties.py:373
msgid "Applying a preset also sets Length, Width and Thickness to the preset's board. Off = keep your size and take only the look"
msgstr "应用预设时也会把长度、宽度和厚度设为该预设的板材尺寸。关闭 = 保持你的尺寸，只采用外观"

#: properties.py:338
msgid "Auto Detail Boost"
msgstr "自动细节增强"

#: properties.py:38
msgid "Back"
msgstr "背面"

#: properties.py:36
msgid "Bottom"
msgstr "底面"

#: operators.py:556
msgid "Built-in presets can't be removed."
msgstr "内置预设无法删除。"

#: properties.py:283
msgid "Carving depth on the two ends, in full-size mm, when Separate End Depth is on"
msgstr "启用“分离端部深度”时，两端的雕刻深度，单位：实际尺寸 mm"

#: properties.py:38
msgid "Centre the end rings on the back edge of each end"
msgstr "将端部年轮的中心对齐到每个端部的后边"

#: properties.py:36
msgid "Centre the end rings on the bottom edge of each end"
msgstr "将端部年轮的中心对齐到每个端部的底边"

#: properties.py:37
msgid "Centre the end rings on the front edge of each end"
msgstr "将端部年轮的中心对齐到每个端部的前边"

#: properties.py:35
msgid "Centre the end rings on the top edge of each end"
msgstr "将端部年轮的中心对齐到每个端部的顶边"

#: properties.py:296
msgid "Checks"
msgstr "干裂"

#: properties.py:367
msgid "Colour boards by their pattern in the viewport: light earlywood, dark ridges, darker knots and cracks, grey for faces that won't be weathered"
msgstr "在视图中按图案为板材着色：浅色早材、深色脊线、更深的节疤与裂纹，不会风化的面显示为灰色"

#: properties.py:355
msgid "Count"
msgstr "数量"

#: properties.py:235
msgid "Depth (mm)"
msgstr "深度（mm）"

#: properties.py:323
#: ui_panel.py:230
msgid "Detail Boost"
msgstr "细节增强"

#: ui_panel.py:230
msgid "Detail Boost (min)"
msgstr "细节增强（最小值）"

#: properties.py:265
msgid "Distance between the semicircular rings on the board ends, in full-size mm"
msgstr "板材端部半圆年轮之间的距离，单位：实际尺寸 mm"

#: properties.py:34
msgid "Each end picks its own edge, usually the top or bottom, so the arcs span the width"
msgstr "每个端部自行选择边，通常是顶边或底边，使弧线横跨宽度"

#: properties.py:240
msgid "Edge Margin (mm)"
msgstr "边缘边距（mm）"

#: ui_panel.py:138
msgid "Edge Rounding"
msgstr "边缘圆角"

#: operators.py:272
msgid "Edges"
msgstr "边"

#: operators.py:278
msgid "End A Edges"
msgstr "端部 A 边"

#: operators.py:279
msgid "End B Edges"
msgstr "端部 B 边"

#: properties.py:269
msgid "End Centre"
msgstr "端部中心"

#: properties.py:283
msgid "End Depth (mm)"
msgstr "端部深度（mm）"

#: properties.py:265
msgid "End Ring Spacing (mm)"
msgstr "端部年轮间距（mm）"

#: properties.py:273
msgid "End Wobble"
msgstr "端部波动"

#: ui_panel.py:198
msgid "Ends"
msgstr "端部"

#: properties.py:323
msgid "Exaggerate ring spacing and carving depth by this factor, so the grain shows at small scales. With Auto Detail Boost on, this is the minimum"
msgstr "用此系数放大年轮间距和雕刻深度，使木纹在小尺度下也可见。开启自动细节增强时，此值为最小值"

#: properties.py:328
msgid "Export a much lighter mesh with the same shape, for FreeCAD or other CAD. The shape moves by at most about 0.01 mm, well below what a printer shows"
msgstr "导出形状相同但轻得多的网格，供 FreeCAD 或其他 CAD 使用。形状最多偏移约 0.01 mm，远低于打印机能呈现的程度"

#: properties.py:31
#: core/presets.py:52
msgid "FDM"
msgstr "FDM"

#: ui_panel.py:121
msgid "Faces to weather"
msgstr "要风化的面"

#: properties.py:287
msgid "Fewest knots per board. Each board picks a number between Min and Max. The grain flows around knots and their hard cores stand proud"
msgstr "每块板的最少节疤数。每块板会在最小值和最大值之间取一个数。木纹绕过节疤，其硬核凸起"

#: properties.py:31
msgid "Filament printer: sets Resolution to 0.1 mm and Smallest Feature to 0.4 mm"
msgstr "线材打印机：将分辨率设为 0.1 mm，最小特征设为 0.4 mm"

#: properties.py:37
msgid "Front"
msgstr "正面"

#: properties.py:201
msgid "Full-size actual thickness, before scaling. A nominal 2x is 1.5 in thick, a nominal 1x is 0.75 in"
msgstr "缩放前的实际厚度（实际尺寸）。公称 2x 的厚度为 1.5 英寸，公称 1x 的厚度为 0.75 英寸"

#: properties.py:196
msgid "Full-size actual width, before scaling. Use the actual size, not the nominal one: a nominal 1x6 is 5.5 in wide"
msgstr "缩放前的实际宽度（实际尺寸）。请使用实际尺寸而非公称尺寸：公称 1x6 的宽度为 5.5 英寸"

#: properties.py:192
msgid "Full-size length of the real board, before scaling (e.g. 96 for an 8 ft board)"
msgstr "缩放前真实板材的实际长度（例如 8 英尺板为 96）"

#: properties.py:278
msgid "Give the ends their own carving depth instead of using Depth. End grain often weathers more deeply than the faces"
msgstr "让端部使用单独的雕刻深度，而不是使用“深度”。端面木纹通常比板面风化得更深"

#: operators.py:519
msgid "Give the preset a name."
msgstr "为预设命名。"

#: properties.py:260
msgid "Grain Waviness"
msgstr "木纹波动"

#: properties.py:273
msgid "Hand-made unevenness in the end rings. 0 = perfect, evenly spaced semicircles; 1 = up to half a ring of wobble"
msgstr "端部年轮的手工不均匀度。0 = 完美、等距的半圆；1 = 最多半个年轮的波动"

#: properties.py:235
msgid "How deep the worn grooves between the grain ridges go, in full-size mm. Detail Boost multiplies it; it never goes past a quarter of the thickness"
msgstr "木纹脊线之间磨损凹槽的深度，单位：实际尺寸 mm。细节增强会乘以该值；深度不会超过厚度的四分之一"

#: properties.py:355
msgid "How many boards Add Weathered Board creates at once, side by side, each with its own pattern"
msgstr "“添加风化板”一次并排创建多少块板材，每块都有各自的图案"

#: properties.py:260
msgid "How much the grain lines on the long faces wander. 0 = smooth, regular grain; 1 = wavy, irregular grain"
msgstr "长面上木纹线的游走程度。0 = 平滑、规则的木纹；1 = 波浪状、不规则的木纹"

#: properties.py:301
msgid "How unevenly the wear varies over the board. 0 = even wear everywhere; 1 = some sheltered areas barely worn at all"
msgstr "板材上磨损变化的不均匀程度。0 = 各处磨损均匀；1 = 一些遮蔽区域几乎不磨损"

