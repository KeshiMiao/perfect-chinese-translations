#: __init__.py:2505
msgid "When disabled, box selection prioritizes the viewport and only selects meshes visible in the viewport.\nWhen enabled, box selection automatically calculates in X-Ray mode, allowing selection of occluded meshes (C4D like)"
msgstr "禁用时，框选优先依据视图，仅选择视图中可见的网格。\n启用时，框选会自动以 X 射线模式计算，可选择被遮挡的网格（类似 C4D）"

#: __init__.py:2505
msgid "X-ray select"
msgstr "X 射线选择"

#: __init__.py:2569
msgid "You can find this tool (Cross Select) in the tool panel (T-panel) on the left side of the 3D viewport"
msgstr "可在 3D 视图左侧的工具面板（T 面板）中找到此工具（Cross Select）"

#: __init__.py:2575
msgid "【Box Select Mode】: Dragging left performs a half match box select, dragging right performs a fully match box select"
msgstr "【框选模式】：向左拖动执行半匹配框选，向右拖动执行完全匹配框选"

#: __init__.py:2578
msgid "【Fully Match】: In this state, only elements fully contained within the selection area will be selected"
msgstr "【完全匹配】：在此状态下，仅选择完全包含在选区内的元素"

#: __init__.py:2579
msgid "【Half Match】: In this state, any element partially touched by the selection area will be selected"
msgstr "【半匹配】：在此状态下，任何与选区部分接触的元素都会被选择"

#: __init__.py:2576
msgid "【Lasso Select Mode】: Drawing a lasso clockwise performs a half match lasso select, drawing counterclockwise performs a fully match lasso select"
msgstr "【套索选择模式】：顺时针绘制套索执行半匹配套索选择，逆时针绘制执行完全匹配套索选择"

#: __init__.py:2508
msgid "面板选择"
msgstr "面板选择"

#: __init__.py:264
msgctxt "Operator"
msgid "Cross Selector, intelligently selects scene objects based on mouse movement\n\n【Blue】: Fully Match – select only if all vertices are inside the range\n【Orange】: Half Match – select if any vertices are inside the range\n\n【shift】: Add Selection\n【ctrl】: Subtract Selection"
msgstr "交叉选择器，根据鼠标移动智能选择场景物体\n\n【蓝色】：完全匹配 – 仅当所有顶点都在范围内时选择\n【橙色】：半匹配 – 只要有任一顶点在范围内就选择\n\n【Shift】：加选\n【Ctrl】：减选"

#: __init__.py:2663
#: __init__.py:2670
msgctxt "Operator"
msgid "Elf Select"
msgstr "精灵选择"

#: __init__.py:2635
msgctxt "Operator"
msgid "Force Fix Hotkeys"
msgstr "强制修复热键"

#: __init__.py:1996
msgctxt "Operator"
