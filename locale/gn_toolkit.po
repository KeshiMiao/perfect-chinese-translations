msgctxt "Operator"
msgid "Open this group/material/world tree in a node editor"
msgstr "在节点编辑器中打开此组/材质/世界树"

#: sync_operators.py:551
msgctxt "Operator"
msgid "Overwrite this group in the .blend with the JSON version (JSON wins)"
msgstr "用 JSON 版本覆盖 .blend 中的此组（JSON 优先）"

#: sync_operators.py:3043
msgctxt "Operator"
msgid "Pick a JSON package and import one group plus its missing dependencies. Groups already present in the .blend are never touched."
msgstr "选择 JSON 包，导入一个组及其缺失的依赖。.blend 中已存在的组不会被改动。"

#: sync_ui.py:2655
msgctxt "Operator"
msgid "Pick a group and preview its missing dependencies"
msgstr "选择一个组并预览其缺失的依赖"

