msgctxt "Operator"
msgid "Show this issue in the list again"
msgstr "在列表中再次显示此问题"

#: sync_operators.py:1617
msgctxt "Operator"
msgid "Stage JSON"
msgstr "暂存 JSON"

#: sync_ui.py:1955
msgctxt "Operator"
msgid "Stage all"
msgstr "全部暂存"

#: sync_operators.py:1618
msgctxt "Operator"
msgid "Stage this JSON file for the next Git commit. Writes the real Git index; the working file is not changed"
msgstr "暂存此 JSON 文件以供下次 Git 提交。写入真实 Git 索引；工作文件不会更改"

#: sync_operators.py:2528
msgctxt "Operator"
msgid "Start tracking groups using an existing JSON as the source of truth — a unified package (one file) or a single-group export ('Export package' with folder structure). The JSON is read only and is NOT modified; use 'Track All' instead to write a new master JSON from the current .blend"
msgstr "使用现有 JSON 作为唯一来源开始跟踪组——统一包（单个文件）或单组导出（带文件夹结构的“Export package”）。该 JSON 为只读且不会被修改；如需从当前 .blend 写入新的主 JSON，请改用“全部跟踪”"

#: sync_operators.py:256
msgctxt "Operator"
msgid "Start tracking the active group: writes its JSON from the current .blend content (first save)"
msgstr "开始跟踪活动组：根据当前 .blend 内容写入其 JSON（首次保存）"

#: sync_operators.py:360
msgctxt "Operator"
msgid "Start tracking the active material: writes its JSON (node tree + versioned material settings) from the current .blend content (first save)"
msgstr "开始跟踪活动材质：根据当前 .blend 内容写入其 JSON（节点树 + 版本化材质设置）（首次保存）"

#: sync_operators.py:422
msgctxt "Operator"
msgid "Start tracking the active world: writes its JSON (node tree + versioned world settings) from the current .blend content (first save)"
msgstr "开始跟踪活动世界：根据当前 .blend 内容写入其 JSON（节点树 + 版本化世界设置）（首次保存）"

#: sync_operators.py:1816
msgctxt "Operator"
msgid "Start tracking untracked dependency groups found in the .blend: each one is written to its own JSON file in the folder (or into the master package) and recorded with its own entry"
msgstr "开始跟踪 .blend 中发现的未跟踪依赖组：每个组都会写入文件夹中的独立 JSON 文件（或写入主包），并记录为独立条目"

#: sync_operators.py:485
msgctxt "Operator"
msgid "Stop Tracking"
msgstr "停止跟踪"

#: sync_operators.py:518
msgctxt "Operator"
msgid "Stop Tracking All"
msgstr "停止跟踪全部"

#: sync_ui.py:2852
msgctxt "Operator"
msgid "Stop tracking"
msgstr "停止跟踪"

#: sync_ui.py:953
msgctxt "Operator"
msgid "Stop tracking all..."
msgstr "停止跟踪全部..."

#: sync_operators.py:519
msgctxt "Operator"
msgid "Stop tracking every group — the JSON files and the node trees are kept"
msgstr "停止跟踪所有组——JSON 文件和节点树会保留"

#: sync_operators.py:486
msgctxt "Operator"
msgid "Stop tracking this group — the JSON file and the node tree are kept"
msgstr "停止跟踪此组——JSON 文件和节点树会保留"

#: sync_operators.py:1757
msgctxt "Operator"
msgid "Store the token for the host: the OS vault when available, otherwise the add-on preferences"
msgstr "为主机存储令牌：可用时存入操作系统保管库，否则存入插件偏好设置"

#: sync_operators.py:827
msgctxt "Operator"
msgid "Throw away this group's local edits and take the JSON version (the saved one wins)"
msgstr "丢弃此组的本地编辑并采用 JSON 版本（以已保存的为准）"

