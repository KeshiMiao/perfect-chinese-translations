msgctxt "Operator"
msgid "Track All"
msgstr "全部跟踪"

#: sync_operators.py:1958
msgctxt "Operator"
msgid "Track All Materials"
msgstr "跟踪所有材质"

#: sync_operators.py:2027
msgctxt "Operator"
msgid "Track All Worlds"
msgstr "跟踪所有世界"

#: sync_operators.py:2088
msgctxt "Operator"
msgid "Track All from Folder"
msgstr "从文件夹跟踪全部"

#: sync_operators.py:1815
msgctxt "Operator"
msgid "Track Dependencies"
msgstr "跟踪依赖"

#: sync_operators.py:255
msgctxt "Operator"
msgid "Track Group"
msgstr "跟踪组"

#: sync_operators.py:3226
msgctxt "Operator"
msgid "Track Imported Group to JSON…"
msgstr "将导入的组跟踪到 JSON…"

#: sync_operators.py:359
msgctxt "Operator"
msgid "Track Material"
msgstr "跟踪材质"

#: sync_operators.py:421
msgctxt "Operator"
msgid "Track World"
msgstr "跟踪世界"

#: sync_ui.py:927
msgctxt "Operator"
msgid "Track all groups..."
msgstr "跟踪所有组..."

#: sync_ui.py:930
msgctxt "Operator"
msgid "Track all materials..."
msgstr "跟踪所有材质..."

#: sync_ui.py:933
msgctxt "Operator"
msgid "Track all worlds..."
msgstr "跟踪所有世界..."

#: sync_operators.py:1959
msgctxt "Operator"
msgid "Track every material with a node tree, writing one master JSON from the current .blend — the addon CREATES the JSON here (first save). Versioned per material: its node tree plus the curated settings (mix mode, culling, viewport display...)"
msgstr "跟踪每个含节点树的材质，从当前 .blend 写入一个主 JSON —— 插件在此处创建 JSON（首次保存）。按材质分别建立版本：其节点树加上精选设置（混合模式、剔除、视图显示……）"

#: sync_operators.py:1861
msgctxt "Operator"
msgid "Track every node group (Geometry Nodes, Shader and Compositor), writing one master JSON from the current .blend — the addon CREATES the JSON here (first save). Use 'Track from Existing JSON' instead when the JSON already exists elsewhere and must not be rewritten"
msgstr "跟踪每个节点组（几何节点、着色器和合成器），从当前 .blend 写入一个主 JSON —— 插件在此处创建 JSON（首次保存）。当 JSON 已存在于别处且不能被重写时，请改用「从现有 JSON 跟踪」"

#: sync_operators.py:2089
msgctxt "Operator"
msgid "Track every per-group JSON export found in a folder ('Export package' with folder structure): pick any file inside the exported folder, and each JSON whose group exists in the .blend is tracked against its own file. The JSONs are read only and are NOT modified"
msgstr "跟踪文件夹中找到的每个逐组 JSON 导出（带文件夹结构的「导出包」）：选择导出文件夹内的任意文件，每个组存在于 .blend 中的 JSON 都会与其自身文件进行跟踪。这些 JSON 为只读，不会被修改"

#: sync_operators.py:2028
msgctxt "Operator"
msgid "Track every world with a node tree, writing one master JSON from the current .blend - the addon CREATES the JSON here (first save)"
msgstr "跟踪每个含节点树的世界，从当前 .blend 写入一个主 JSON —— 插件在此处创建 JSON（首次保存）"

#: sync_operators.py:2527
msgctxt "Operator"
msgid "Track from Existing JSON"
msgstr "从现有 JSON 跟踪"

#: sync_ui.py:936
msgctxt "Operator"
msgid "Track from folder..."
msgstr "从文件夹跟踪..."

#: sync_ui.py:944
msgctxt "Operator"
msgid "Track scene compositor..."
msgstr "跟踪场景合成器..."

#: sync_operators.py:3227
msgctxt "Operator"
msgid "Track the imported group (and its untracked dependencies) to a JSON package: the group is written into the JSON and becomes sync-tracked"
msgstr "将导入的组（及其未跟踪的依赖项）跟踪到 JSON 包：该组被写入 JSON 并变为同步跟踪"

#: sync_ui.py:2707
msgctxt "Operator"
msgid "Track to JSON..."
msgstr "跟踪到 JSON..."

