#: sync_ui.py:2811
msgctxt "Operator"
msgid "Un-ignore"
msgstr "取消忽略"

#: sync_operators.py:1116
msgctxt "Operator"
msgid "Un-ignore Changes"
msgstr "取消忽略更改"

