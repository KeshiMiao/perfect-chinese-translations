msgctxt "Operator"
msgid "Save Marked to JSON"
msgstr "将标记项保存到 JSON"

#: sync_operators.py:2361
msgctxt "Operator"
msgid "Save Modified to JSON"
msgstr "将修改项保存到 JSON"

