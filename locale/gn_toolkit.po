#: sync_ui.py:2817
msgctxt "Operator"
msgid "Unmark"
msgstr "取消标记"

#: sync_operators.py:768
msgctxt "Operator"
msgid "Unmark All Changes"
msgstr "取消标记所有更改"

#: sync_operators.py:739
msgctxt "Operator"
msgid "Unmark Change"
msgstr "取消标记更改"

#: sync_ui.py:533
msgctxt "Operator"
msgid "Unmark all"
msgstr "取消标记全部"

#: sync_operators.py:769
msgctxt "Operator"
msgid "Unmark every change"
msgstr "取消标记每个更改"

#: sync_operators.py:1634
msgctxt "Operator"
msgid "Unstage JSON"
msgstr "取消暂存 JSON"

#: sync_ui.py:1957
msgctxt "Operator"
msgid "Unstage all"
msgstr "取消暂存全部"

#: sync_operators.py:1635
msgctxt "Operator"
msgid "Unstage this JSON file (the index entry goes back to HEAD; the working file keeps its changes)"
msgstr "取消暂存此 JSON 文件（索引条目回到 HEAD；工作文件保留其更改）"

#: sync_ui.py:2418
msgctxt "Operator"
msgid "Validate"
msgstr "验证"

#: sync_ui.py:2613
msgctxt "Operator"
msgid "Validate Geometry"
msgstr "验证几何"

#: sync_operators.py:2304
msgctxt "Operator"
msgid "Write every tracked group's .blend content into its JSON file"
msgstr "将所有已跟踪组的 .blend 内容写入其 JSON 文件"

#: sync_operators.py:2362
msgctxt "Operator"
msgid "Write only edited or conflicting groups into their JSON files"
msgstr "仅将已编辑或冲突的组写入其 JSON 文件"

#: sync_operators.py:781
msgctxt "Operator"
msgid "Write the marked groups' .blend content into their JSON files (blend wins)"
msgstr "将已标记组的 .blend 内容写入其 JSON 文件（以 .blend 为准）"

#: sync_ui.py:1609
msgctxt "Operator"
msgid "Write the merged package with the per-item decisions chosen in the merge report, rebuild the entry in the .blend and mark it Synced; nothing is written while any conflict is undecided"
msgstr "写入合并包，采用合并报告中为各项选择的决定，在 .blend 中重建条目并将其标记为已同步；只要有冲突未决定，就不会写入任何内容"

#: sync_ui.py:1842
msgctxt "Operator"
msgid "Write this entry as it was in the selected revision into the JSON file; the .blend is not touched - Pull rebuilds the group from the JSON"
msgstr "将此条目按所选修订版本中的原样写入 JSON 文件；.blend 不受影响 —— 拉取会从 JSON 重建该组"

#: sync_operators.py:607
msgctxt "Operator"
msgid "Write this group's .blend content into its JSON file (blend wins)"
msgstr "将此组的 .blend 内容写入其 JSON 文件（以 .blend 为准）"
