msgctxt "Operator"
msgid "Rebuild the current graph board with fresh statuses (layout and selection are reset)"
msgstr "以最新状态重建当前图板（布局和选择将被重置）"

#: sync_operators.py:1146
msgctxt "Operator"
msgid "Recompute the sync status of every tracked group"
msgstr "重新计算每个已跟踪组的同步状态"

#: operators.py:747
msgctxt "Operator"
msgid "Recreate all node groups (Geometry Nodes, Shader and Compositor) and modifiers from a JSON package — or pick any file inside a folder export ('Export package' with folder structure) to recreate its NodeGroups/Modifiers folders; 'Update existing groups' rebuilds existing ones in place"
msgstr "从 JSON 包重新创建所有节点组（几何节点、着色器和合成器）及修改器——或选择文件夹导出（带文件夹结构的“Export package”）中的任意文件，以重新创建其 NodeGroups/Modifiers 文件夹；“更新现有组”会就地重建现有组"

#: sync_ui.py:2639
msgctxt "Operator"
msgid "Refresh Git History"
msgstr "刷新 Git 历史"

#: sync_operators.py:1145
#: sync_ui.py:788
msgctxt "Operator"
msgid "Refresh Status"
msgstr "刷新状态"

#: sync_ui.py:2640
msgctxt "Operator"
msgid "Reload the cached repository history"
msgstr "重新加载缓存的仓库历史"

#: sync_operators.py:1048
msgctxt "Operator"
msgid "Remove the disposable graph board and its helper trees"
msgstr "移除临时图板及其辅助节点树"

#: sync_ui.py:1509
msgctxt "Operator"
msgid "Resolve: Keep Blend"
msgstr "解决：保留 .blend"

#: sync_ui.py:1532
msgctxt "Operator"
msgid "Resolve: Keep JSON"
msgstr "解决：保留 JSON"

#: sync_ui.py:775
#: sync_ui.py:1841
msgctxt "Operator"
msgid "Restore This Revision"
msgstr "恢复此修订"

#: sync_operators.py:1529
msgctxt "Operator"
msgid "Restore the changed tracked JSON files from HEAD when their only differences are cosmetic (layout) data"
msgstr "当已更改的已跟踪 JSON 文件仅有外观（布局）数据差异时，从 HEAD 恢复它们"

#: sync_operators.py:2476
msgctxt "Operator"
msgid "Retry Failed"
msgstr "重试失败项"

#: sync_ui.py:452
msgctxt "Operator"
msgid "Retry failed"
msgstr "重试失败项"

