#: __init__.py:629
msgctxt "Operator"
msgid "Turn Off Sequencer"
msgstr "关闭序列编辑器"

#: __init__.py:761
msgctxt "Operator"
msgid "checks whether the panel / operators / scene properties / render pre-handler are all present and prints the full report to the system console"
msgstr "检查面板、操作符、场景属性、渲染前置处理器是否齐全，并将完整报告打印到系统控制台"

#: mmt_names.py:261
msgctxt "Operator"
msgid "guess the face / hair / eye / brow / lash materials by name on the selected model"
msgstr "根据名称在所选模型上推测脸部、头发、眼睛、眉毛、睫毛材质"

#: mmt_seethrough.py:860
msgctxt "Operator"
msgid "make the eyes and brows show through the hair: writes the three masks, builds the compositor group and wires it in"
msgstr "让眼睛和眉毛透过头发显示：写入三个遮罩，构建合成器节点组并接入"

#: __init__.py:417
msgctxt "Operator"
msgid "one click: read the native MMD materials, apply the toon preset, build the MMD edge preview. A failing step is reported on its own and does not affect the others"
msgstr "一键：读取原生 MMD 材质，应用卡通预设，构建 MMD 边缘预览。失败的步骤会单独报告，不影响其他步骤"

#: mmt_seethrough.py:890
msgctxt "Operator"
msgid "remove the see-through nodes and restore the hair and the view layer"
msgstr "移除透视节点并还原头发和视图层"

#: __init__.py:923
msgctxt "Operator"
msgid "the beginner button: toon shading with outline, then eye-through, then glow. A failing step is reported on its own and never cancels the others"
msgstr "新手按钮：带描边的卡通着色，然后眼透，然后辉光。失败的步骤会单独报告，绝不会取消其他步骤"

#: __init__.py:855
msgctxt "Operator"
msgid "turn every MikuMikuToon effect off and put the materials back to how the MMD model looked before the first one-click toon"
msgstr "关闭所有 MikuMikuToon 效果，并将材质恢复到首次一键卡通前的 MMD 模型状态"

#: __init__.py:630
msgctxt "Operator"
msgid "when the Video Sequencer is on and has strips, renders go through it and the compositor (glow) is skipped; this turns that post-processing step off"
msgstr "当视频序列编辑器开启且有片段时，渲染会经过它并跳过合成器（辉光）；此操作关闭该后处理步骤"

#: mmt_seethrough.py:800
msgctxt "Operator"
msgid "眼透"
msgstr "眼透"
