#: __init__.py:176
msgid "A blend of the above two options, resulting in cuts along all axes"
msgstr "上述两个选项的混合，沿所有轴向进行切割"

#: __init__.py:67
msgid "A value higher than zero will cause close-together vertices to merge, resulting in a more performant (but potentially less accurate) collision mesh"
msgstr "大于零的值会使靠得很近的顶点合并，从而得到性能更好（但可能不太精确）的碰撞网格"

#: __init__.py:207
msgid "Any hulls smaller than this size will be omitted from the final resulting collision. This can be used to skip small body parts like finger and toes, for example. If you don't want ANY hulls to be skipped, set this to zero"
msgstr "小于此尺寸的凸块将从最终碰撞中省略。例如可用于跳过手指、脚趾等小的身体部位。如果不希望跳过任何凸块，请将其设为 0"

#: __init__.py:36
msgid "At 1.0, decimation is disabled. Lower value = stronger decimation, resulting in less accurate but more performant collision mesh. Note: Decimation reduces effectiveness of Merge Adjacent Similars"
msgstr "值为 1.0 时禁用减面。值越低减面越强，碰撞网格精度越低但性能越好。注意：减面会降低「合并相邻相似项」的效果"

#: __init__.py:3937
msgid "Bisection"
msgstr "对分"

#: __init__.py:164
msgid "Bisections"
msgstr "对分次数"

#: __init__.py:143
msgid "Brush Texture"
msgstr "画刷纹理"

#: __init__.py:31
msgid "Can dramatically reduce the hull count for smaller or individual props. Leave this disabled if you're generating collision for entire rooms, levels, or any objects with interior cavities"
msgstr "可大幅减少较小或单个道具的凸块数量。如果要为整个房间、关卡或任何有内部空腔的物体生成碰撞，请保持禁用"

#: __init__.py:3958
msgid "Cleanup"
msgstr "清理"

#: __init__.py:4021
msgid "Compile"
msgstr "编译"

#: __init__.py:174
msgid "Cuts along the X/Y axes, resulting in horizontally flat hulls"
msgstr "沿 X/Y 轴切割，得到水平扁平的凸块"

#: __init__.py:175
msgid "Cuts along the Z axis, resulting in vertical hulls"
msgstr "沿 Z 轴切割，得到垂直的凸块"

#: __init__.py:36
msgid "Decimate Ratio"
msgstr "减面比例"

#: __init__.py:27
msgid "Dissolve"
msgstr "融并"

#: __init__.py:137
msgid "Export to"
msgstr "导出至"

#: __init__.py:60
msgid "Extrude Factor"
msgstr "挤出系数"

#: __init__.py:92
#: __init__.py:192
msgid "Find"
msgstr "查找"

#: __init__.py:192
msgid "Finds hulls that are mostly or entirely inside another hull. The hulls are highlighted in Edit Mode, without any modification"
msgstr "查找大部分或完全位于另一个凸块内部的凸块。在编辑模式下高亮显示这些凸块，不进行任何修改"

#: __init__.py:92
msgid "Finds thin hulls, based on the Thin Threshold setting. The hulls are highlighted in Edit Mode, without any modification"
msgstr "根据「薄度阈值」设置查找薄的凸块。在编辑模式下高亮显示这些凸块，不进行任何修改"

#: __init__.py:137
msgid "Folder where exported hulls will be saved as Hammer brush .VMF files"
msgstr "导出的凸块将保存为 Hammer 画刷 .VMF 文件的文件夹"

#: __init__.py:3927
msgid "Fracture"
msgstr "断裂"

#: __init__.py:44
msgid "Fracture Target"
msgstr "断裂目标"

#: __init__.py:100
msgid "Full path of the folder in which to save the generated QCs"
msgstr "用于保存生成的 QC 文件的文件夹完整路径"

#: __init__.py:52
#: __init__.py:156
msgid "Gap Width"
msgstr "间隙宽度"

#: __init__.py:3894
msgid "Generate"
msgstr "生成"

#: __init__.py:4070
msgid "Hammer Brushes"
msgstr "Hammer 画刷"

#: __init__.py:156
msgid "How big the gap should be between bisected sections. Used only by the Bisection generator"
msgstr "对分各段之间的间隙大小。仅由「对分」生成器使用"

#: __init__.py:52
msgid "How large or small the gap between hulls should be. Used only by the Fracture generation method"
msgstr "凸块之间间隙的大小。仅由「断裂」生成方法使用"

#: __init__.py:164
msgid "How many times should the model be bisected along the middle by the Bisection generator"
msgstr "「对分」生成器沿中间对模型进行对分的次数"

#: __init__.py:199
msgid "How strong a weight must be in order to be included for collision. A higher value will result in fewer hulls, while a lower value will result in more"
msgstr "权重需要多高才会被纳入碰撞。值越高凸块越少，值越低凸块越多"

#: __init__.py:176
msgid "Hybrid"
msgstr "混合"

#: __init__.py:132
msgid "If enabled, the 'Update VMF' button will REMOVE partitioned ('_phys_part_') collision models from the VMF along with their corresponding entity (ie. prop_static). Can't be undone. Keep a backup VMF just in case"
msgstr "启用后，「更新 VMF」按钮会从 VMF 中移除分区（'_phys_part_'）碰撞模型及其对应的实体（如 prop_static）。无法撤销。请保留一份 VMF 备份以防万一"

#: __init__.py:27
msgid "If enabled, the resulting collision mesh is much more optimized, but also potentially less accurate. If you prefer accuracy over optimization, disable this"
msgstr "启用后，生成的碰撞网格会优化得多，但也可能不够精确。如果更看重精确度而非优化，请禁用此项"

#: __init__.py:4002
msgid "Inside Hulls"
msgstr "内部凸块"

#: __init__.py:113
msgid "Materials Path"
msgstr "材质路径"

#: __init__.py:93
msgid "Merge"
msgstr "合并"

#: __init__.py:67
msgid "Merge Distance"
msgstr "合并距离"

#: __init__.py:93
msgid "Merges thin hulls with adjacent hulls (if any), based on the Thin Threshold setting"
msgstr "根据「薄度阈值」设置，将薄的凸块与相邻凸块（如果有）合并"

