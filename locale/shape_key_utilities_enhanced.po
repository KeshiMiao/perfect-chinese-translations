#: __init__.py:5253
msgctxt "Operator"
msgid "Select this row. Double-click renames it. Ctrl+click toggles its mark, Shift+click marks a range from the active row, Alt+click removes marks (with Shift, over a range)"
msgstr "选择此行。双击可重命名。Ctrl+单击切换其标记，Shift+单击从活动行标记一个范围，Alt+单击移除标记（配合 Shift 时作用于范围）。"

#: Shape_Keys___Vertex_Groups_Utilities.py:2255
