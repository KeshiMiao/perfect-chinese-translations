#: Shape_Keys___Vertex_Groups_Utilities.py:1476
#: __init__.py:1493
msgctxt "Operator"
msgid "Rename the marked shape keys (or the active one) to end with the L suffix, replacing any existing L/R ending."
msgstr "将已标记的形态键（或活动键）重命名为以 L 后缀结尾，替换现有的 L/R 结尾。"

#: Shape_Keys___Vertex_Groups_Utilities.py:1467
#: __init__.py:1484
msgctxt "Operator"
