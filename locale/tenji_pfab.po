msgid "詳細(対象・枠)"
msgstr "详细（目标・框）"

#: __init__.py:84
msgid "語を行にまたがせない。長すぎる語は音節で切り、行末に「ー」を付ける"
msgstr "不让词跨行。过长的词按音节切分，并在行末加上“ー”"

#: __init__.py:62
msgid "読み"
msgstr "读音"

#: __init__.py:99
msgid "警告角度(°)"
msgstr "警告角度 (°)"

#: __init__.py:86
msgid "配置"
msgstr "放置"

#: __init__.py:282
msgctxt "Operator"
msgid "いまのテキストと設定で、分かち書き・点字変換・モデル上の生成をやり直す"
msgstr "使用当前文本和设置，重新进行分词、盲文转换和模型上的生成"

#: __init__.py:182
msgctxt "Operator"
msgid "テキストを分かち書きして読み一覧を作り直す(手で直した読み・空白はリセットされる)"
msgstr "对文本进行分词并重建读音列表（手动修改的读音和空白将被重置）"

#: __init__.py:299
msgctxt "Operator"
msgid "今の点字を確定して残し(Tenji_Label という名前の通常のメッシュになる)、テキストを空にして新しい点字を作り始める。対象モデル・枠・サイズの設定はそのまま使う。確定しないと、次の更新で今の点字は上書きされる"
msgstr "确定并保留当前盲文（成为名为 Tenji_Label 的普通网格），清空文本并开始创建新盲文。目标模型、框、尺寸设置保持不变。如果不确定，下次更新会覆盖当前盲文"

#: __init__.py:268
msgctxt "Operator"
msgid "対象モデル(詳細で指定)に対して、今の3Dビューの向きに投影枠を合わせる"
msgstr "让投影框按当前 3D 视图方向对齐到目标模型（在“详细”中指定）"

#: __init__.py:195
msgctxt "Operator"
msgid "対象モデルの上に Empty を置く。ローカル -Z が投影方向、+X が読む方向、-Y が次の行"
msgstr "在目标模型上放置 Empty。本地 -Z 为投影方向，+X 为阅读方向，-Y 为下一行"

#: __init__.py:194
msgctxt "Operator"
msgid "投影枠を作成"
msgstr "创建投影框"

#: __init__.py:298
msgctxt "Operator"
msgid "新規点字"
msgstr "新建盲文"

#: __init__.py:281
#: __init__.py:385
msgctxt "Operator"
msgid "更新"
msgstr "更新"

#: __init__.py:323
msgctxt "Operator"
msgid "検証(逆読み)"
msgstr "验证（反向读取）"

#: __init__.py:324
msgctxt "Operator"
msgid "生成されたメッシュから点を読み戻し、期待する点字と一致するか確認する"
msgstr "从生成的网格中读回点，并检查是否与预期盲文一致"

#: __init__.py:267
msgctxt "Operator"
msgid "視点から枠を作成"
msgstr "从视图创建框"

#: __init__.py:181
msgctxt "Operator"
msgid "読みを作り直す"
msgstr "重建读音"

#: __init__.py:246
msgctxt "Operator"
msgid "選択モデルに点字作成"
msgstr "在所选模型上创建盲文"

#: __init__.py:247
msgctxt "Operator"
msgid "選択中のモデルの、今 3Dビューの中央に見えている場所に点字を作る。画面の右が読む方向、下が次の行、奥の面に向かって載る。載せたい面を正面に向けてから押す。もう一度押すと、今の点字をその場所へ移す"
msgstr "在所选模型当前 3D 视图中央可见的位置创建盲文。屏幕右侧为阅读方向，下方为下一行，朝向后面的面放置。先将想要放置的面朝向正面再按下。再次按下会将当前盲文移动到该位置"
