msgstr "Alt+P"

#: anotherv_sketchtools_lite/ui.py:156
msgid "Alt+P push/pull • Alt+U box • Alt+C cylinder"
msgstr "Alt+P 推/拉 • Alt+U 盒 • Alt+C 圆柱"

