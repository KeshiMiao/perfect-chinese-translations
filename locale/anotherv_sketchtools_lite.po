#: anotherv_sketchtools_lite/ui.py:38
msgid "After cutting, select the face(s) inside the shape (ready for E / I)"
msgstr "切割后，选择形状内的面（可进行 E / I）"

#: anotherv_sketchtools_lite/ui.py:46
msgid "After each action the tool stays active for the next one. Esc or right-click drops what is being drawn; once more leaves the tool. Off: every tool ends after one action"
msgstr "每次操作后工具保持激活以进行下一次。Esc 或右键放弃正在绘制的内容；再按一次退出工具。关闭：每个工具在一次操作后结束"

#: anotherv_sketchtools_lite/ops_knife.py:89
#: anotherv_sketchtools_lite/ui.py:41
msgid "Align"
msgstr "对齐"

#: anotherv_sketchtools_lite/ui.py:13
msgid "Align the shape to the longest edge of the face (good for walls/floors)"
msgstr "将形状对齐到面的最长边（适合墙壁/地板）"

#: anotherv_sketchtools_lite/ui.py:14
msgid "Align the shape to the screen"
msgstr "将形状对齐到屏幕"

#: anotherv_sketchtools_lite/ui.py:72
msgid "Also snap to the other visible meshes in the scene, the ones that are not being edited: point at a corner of another object to reference it (up to 400,000 vertices; switch off if a very big scene feels slow)"
msgstr "也吸附到场景中其他可见网格（未被编辑的网格）：指向另一个物体的角点以作为参考（最多 400,000 个顶点；如果场景很大导致卡顿请关闭）"

#: anotherv_sketchtools_lite/osnap.py:683
msgid "Alt+G"
msgstr "Alt+G"

#: anotherv_sketchtools_lite/ui.py:160
msgid "Alt+G move • Alt+R rotate (Ctrl = copy)"
msgstr "Alt+G 移动 • Alt+R 旋转（Ctrl = 复制）"

#: anotherv_sketchtools_lite/osnap.py:679
msgid "Alt+K"
msgstr "Alt+K"

#: anotherv_sketchtools_lite/ui.py:154
msgid "Alt+K shape • Alt+L line"
msgstr "Alt+K 形状 • Alt+L 线"

