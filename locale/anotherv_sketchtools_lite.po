msgstr "形状切割：半径必须大于 0"

#: anotherv_sketchtools_lite/ops_knife.py:148
msgid "Shape Knife: run it from the 3D viewport (Alt+K) and click on a face"
msgstr "形状切割：请从 3D 视图运行（Alt+K）并点击一个面"

#: anotherv_sketchtools_lite/ops_knife.py:151
msgid "Shape Knife: width/height must be > 0"
msgstr "形状切割：宽度/高度必须大于 0"

#: anotherv_sketchtools_lite/ui.py:76
msgid "Show a line of help for the running tool in Blender's status bar at the bottom"
msgstr "在 Blender 底部状态栏显示正在运行工具的帮助行"

#: anotherv_sketchtools_lite/ui.py:79
msgid "Show the bar with the tools and snaps at the bottom of the viewport whenever you are in Edit Mode. Off: it only shows while a tool is running"
msgstr "在编辑模式下，始终在视图底部显示工具与捕捉栏。关闭：仅在工具运行时显示"

#: anotherv_sketchtools_lite/ops_line.py:40
