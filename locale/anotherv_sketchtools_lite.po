msgstr "草图直线可在 3D 视图中使用"

#: anotherv_sketchtools_lite/ops_line.py:254
msgid "Sketch Line: both ends must touch the face outline to cut — cancelled"
msgstr "草图直线：两端必须接触面轮廓才能切割——已取消"

#: anotherv_sketchtools_lite/ops_line.py:261
msgid "Sketch Line: that edge already exists"
msgstr "草图直线：该边已存在"

