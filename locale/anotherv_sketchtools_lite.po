msgid "I = Offset  (Shift = snap)"
msgstr "I = 偏移（Shift = 吸附）"

#: anotherv_sketchtools_lite/ops_knife.py:80
#: anotherv_sketchtools_lite/ui.py:34
msgid "Include connected faces on the picked surface within Cut Depth; exclude hidden faces, separate shells and sharp corners"
msgstr "包括所选表面上切割深度内的相连面；排除隐藏面、分离的壳和尖角"

