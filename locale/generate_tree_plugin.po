msgstr "等高概率"

#: properties.py:268
msgid "Scale Max"
msgstr "最大缩放"

#: properties.py:267
msgid "Scale Min"
msgstr "最小缩放"

#: properties.py:245
msgid "Scatter deformed icosphere blobs along each branch and the canopy top"
msgstr "沿每个枝条和树冠顶部散布变形后的二十面球体团块"

