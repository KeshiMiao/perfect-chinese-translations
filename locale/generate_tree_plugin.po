#: properties.py:192
msgid "Secondary Length Max"
msgstr "次级长度最大值"

#: properties.py:124
#: properties.py:191
msgid "Secondary Length Min"
msgstr "次级长度最小值"

#: properties.py:129
#: properties.py:193
msgid "Secondary Thickness"
msgstr "次级粗细"

