msgid "Object"
msgstr "物体"

#: SoundPlanes/ui.py:60
msgid "Objects"
msgstr "物体"

#: SoundPlanes/ui.py:21
msgid "Only sets with 'Process' enabled are analyzed."
msgstr "仅分析启用了「处理」的集。"

#: SoundPlanes/ui.py:82
msgid "Planes"
msgstr "平面"

#: SoundPlanes/props.py:40
#: SoundPlanes/ui.py:32
