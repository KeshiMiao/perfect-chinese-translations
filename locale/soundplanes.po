msgid "UID"
msgstr "UID"

#: SoundPlanes/props.py:73
msgid "Velocity Factor"
msgstr "速度系数"

#: SoundPlanes/props.py:96
msgid "Volume Randomness"
msgstr "音量随机性"

#: SoundPlanes/props.py:73
msgid "Volume blend uses:\nvol = max(0, speed) * vf + base - (base * vf)\n(vf=0 keeps base, vf=1 uses speed as volume)"
msgstr "音量混合使用：\nvol = max(0, speed) * vf + base - (base * vf)\n（vf=0 保持基础值，vf=1 使用速度作为音量）"

#: SoundPlanes/props.py:51
msgid "When running 'Analyze & Add Sounds', automatically remove previously generated Sound Planes strips for THIS set (tagged strips) in this set's channel range before adding new ones."
msgstr "运行「分析并添加声音」时，在添加新片段前自动移除此集通道范围内先前生成的 Sound Planes 片段（已标记的片段）。"

