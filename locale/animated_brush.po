msgstr "动画纹理笔刷"

#: __init__.py:374
msgid "Both"
msgstr "两者"

#: __init__.py:367
msgid "Choose a frame when a stroke starts"
msgstr "笔划开始时选择一帧"

#: __init__.py:379
msgid "Choose any frame with equal probability; consecutive duplicates are allowed unless No Repeat is enabled"
msgstr "等概率随机选择任意帧；除非启用不重复，否则允许连续重复"

#: __init__.py:366
msgid "Choose frames at the update rate during a stroke"
msgstr "笔划中按更新速率选择帧"

#: __init__.py:366
msgid "Continuous"
msgstr "连续"

#: __init__.py:364
msgid "Cycle Mode"
msgstr "循环模式"

