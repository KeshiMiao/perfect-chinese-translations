#: __init__.py:380
msgid "Advance from the current frame: 1, 2, 3, then wrap to 1 after the last frame"
msgstr "从当前帧前进：1、2、3，末帧后回到 1"

#: __init__.py:381
msgid "Advance then reverse at the ends: 1, 2, 3, 2, 1, 2; endpoints are not duplicated"
msgstr "到端点后反向：1、2、3、2、1、2；端点不重复"

