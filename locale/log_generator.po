msgctxt "Operator"
msgid "Generate Logs"
msgstr "生成原木"

#: operators.py:158
msgctxt "Operator"
msgid "Load Settings From Selected"
msgstr "从选中项载入设置"

#: operators.py:199
msgctxt "Operator"
msgid "New Seed"
msgstr "新种子"

#: operators.py:118
msgctxt "Operator"
msgid "Regenerate Selected"
msgstr "重新生成选中项"

#: operators.py:296
msgctxt "Operator"
msgid "Save Log Preset"
msgstr "保存原木预设"

#: operators.py:213
msgctxt "Operator"
msgid "Use Typical Size"
msgstr "使用典型尺寸"
