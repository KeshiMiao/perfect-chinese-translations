#: operators.py:429
#: operators.py:492
msgid "Add"
msgstr "添加"

#: operators.py:429
msgid "Add value to current offset"
msgstr "将数值加到当前偏移"

#: operators.py:492
msgid "Add value to current roll"
msgstr "将数值加到当前滚转"

#: properties.py:241
msgid "Adjust (frames)"
msgstr "调整（帧）"

#: ui.py:74
#: ui.py:102
msgid "Amplitude"
msgstr "振幅"

#: properties.py:355
msgid "Amplitude factor at the chain root (0 = no motion at root, 1 = full motion everywhere)"
msgstr "链根部的振幅系数（0 = 根部无运动，1 = 处处完全运动）"

#: properties.py:211
msgid "Any settings change for the active chain will apply to all selected bone chains"
msgstr "对活动链的任何设置更改都会应用到所有选中的骨骼链"

#: operators.py:370
msgid "Apply offset to main axis wave"
msgstr "将偏移应用到主轴波"

#: operators.py:371
msgid "Apply offset to sub axis wave"
msgstr "将偏移应用到副轴波"

#: operators.py:439
msgid "Apply to main axis offset"
msgstr "应用到主轴偏移"

#: operators.py:440
msgid "Apply to sub axis offset"
msgstr "应用到副轴偏移"

#: properties.py:211
msgid "Auto Update All Selected Chains"
msgstr "自动更新所有选中的链"

#: operators.py:93
msgid "Bake the physics to keyframes in a new action instead of overwriting the existing action"
msgstr "将物理烘焙为新动作中的关键帧，而不是覆盖现有动作"

#: operators.py:93
msgid "Bake to New Action"
msgstr "烘焙到新动作"

#: ui.py:164
msgid "Batch Offset"
msgstr "批量偏移"

#: properties.py:455
msgid "Constant angular offset in the main sway direction (positive = toward arrow, negative = against arrow)"
msgstr "主摆动方向上的恒定角度偏移（正值 = 朝向箭头，负值 = 反向箭头）"

#: properties.py:465
msgid "Constant angular offset in the sub sway direction (positive = toward arrow, negative = against arrow)"
msgstr "副摆动方向上的恒定角度偏移（正值 = 朝向箭头，负值 = 反向箭头）"

#: operators.py:110
msgid "Could not find any sway bone chains to bake"
msgstr "找不到可烘焙的摆动骨骼链"

#: properties.py:249
msgid "Degrees to add, subtract, or set the y-axis roll of selected sway chains"
msgstr "用于对选中摆动链的 Y 轴滚转进行增加、减去或设置的度数"

#: ui.py:80
#: ui.py:108
msgid "Delay"
msgstr "延迟"

#: ui.py:24
#: ui.py:28
msgid "Flow"
msgstr "Flow"

#: properties.py:435
msgid "Frame offset for the Z-axis wave starting position"
msgstr "Z 轴波起始位置的帧偏移"

#: properties.py:345
msgid "Frame offset for the chain's starting position in the wave cycle"
msgstr "链在波周期中起始位置的帧偏移"

#: ui.py:77
#: ui.py:105
msgid "Frequency (Hz)"
msgstr "频率（Hz）"

#: properties.py:365
msgid "Global speed multiplier for the sway animation"
msgstr "摆动动画的全局速度倍数"

#: properties.py:233
msgid "Increment (frames)"
msgstr "增量（帧）"

#: properties.py:233
msgid "Incremental offset value applied to each selected chain when using batch offset"
msgstr "使用批量偏移时，对每个选中链应用的递增偏移值"

#: properties.py:217
msgid "Keep Existing Settings"
msgstr "保留现有设置"

#: properties.py:325
msgid "Lag between the ends of the chain as a percentage of one wave cycle, creating the cascading sway effect. Independent of frequency, speed, fps and chain length (100% = the trailing bone is a full cycle behind the leading one)"
msgstr "链两端之间以一个波周期的百分比表示的滞后，产生级联摆动效果。与频率、速度、fps 和链长无关（100% = 末端骨骼比前端骨骼滞后一个完整周期）"

#: properties.py:415
msgid "Lag between the ends of the chain for the Z-axis wave cascade, as a percentage of one sub wave cycle. Independent of frequency, speed, fps and chain length"
msgstr "Z 轴波级联中链两端之间的滞后，以一个副波周期的百分比表示。与频率、速度、fps 和链长无关"

#: ui.py:96
#: ui.py:124
msgid "Limit +"
msgstr "上限 +"

#: ui.py:95
#: ui.py:123
msgid "Limit -"
msgstr "下限 -"

#: operators.py:370
#: operators.py:439
msgid "Main Axis"
msgstr "主轴"

#: properties.py:475
msgid "Maximum positive rotation (in rest space) on the main sway axis. Acts like a soft collision wall."
msgstr "主摆动轴上最大正向旋转（在静置空间中）。作用类似于柔性碰撞墙。"

#: properties.py:489
msgid "Maximum positive rotation (in rest space) on the sub sway axis."
msgstr "副摆动轴上最大正向旋转（在静置空间中）。"

#: properties.py:305
msgid "Maximum rotation angle in degrees for the main axis sway wave"
msgstr "主轴摆动波的最大旋转角度（度）"

#: properties.py:395
msgid "Maximum rotation angle in degrees for the sub axis sway wave"
msgstr "副轴摆动波的最大旋转角度（度）"

#: properties.py:482
msgid "Minimum (most negative) rotation (in rest space) on the main sway axis."
msgstr "主摆动轴上的最小（最负）旋转（在静置空间中）。"

#: properties.py:496
msgid "Minimum (most negative) rotation (in rest space) on the sub sway axis."
msgstr "副摆动轴上的最小（最负）旋转（在静置空间中）。"

