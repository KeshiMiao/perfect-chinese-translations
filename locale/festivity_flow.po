msgstr "未找到用户预设"

#: operators.py:24
msgid "None of the bones you selected can be used. The bones need a parent to work"
msgstr "你选中的骨骼均不可用。骨骼需要父级才能工作"

#: properties.py:405
msgid "Number of complete Z-axis wave cycles per second"
msgstr "每秒 Z 轴完整波周期数"

#: properties.py:315
msgid "Number of complete wave cycles per second"
msgstr "每秒完整波周期数"

#: ui.py:86
#: ui.py:114
msgid "Offset (frames)"
msgstr "偏移（帧）"

#: properties.py:385
msgid "Per-bone phase offset in degrees to curve the sway direction along the chain"
msgstr "以度为单位的逐骨骼相位偏移，用于沿链弯曲摆动方向"

#: ui.py:158
msgid "Random Seed"
msgstr "随机种子"

#: properties.py:375
msgid "Random time offset for this chain to prevent all chains from syncing"
msgstr "此链的随机时间偏移，防止所有链同步"

#: ui.py:83
#: ui.py:111
msgid "Reverse Delay Direction"
msgstr "反转延迟方向"

#: properties.py:427
msgid "Reverse the sub-axis wave cascade direction so the root leads and the tip trails"
msgstr "反转副轴波级联方向，使根部领先、末端跟随"

#: properties.py:337
msgid "Reverse the wave cascade direction so the root leads and the tip trails"
msgstr "反转波级联方向，使根部领先、末端跟随"

#: properties.py:249
msgid "Roll Adjust"
msgstr "滚转调整"

#: ui.py:89
