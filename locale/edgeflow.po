#: op_set_edge_curve.py:14
msgctxt "Operator"
msgid "Adjust curvature along the direction the edgeloop\nALT: reuse last settings"
msgstr "沿边循环方向调整曲率\nALT：重复使用上次设置"

#: op_set_edge_flow.py:103
msgctxt "Operator"
msgid "Adjust curvature to match surface defined by edges crossing the edgeloop\nALT: reuse last settings"
msgstr "调整曲率以匹配与边循环相交的边所定义的曲面\nALT：重复使用上次设置"

#: op_set_vertex_curve.py:470
msgctxt "Operator"
msgid "Curves vertices between the selected vertices in picking order of the selected vertices.\n    2 vertices selected: placed on a half circle between endpoints.\n    3 vertices selected: placed onto a circle segment between endpoints.\n    4+ vertices selected: placed onto a spline going through selected vertices\n\n    ALT: reuse last settings"
msgstr "按选中顶点的选取顺序在它们之间生成曲线。\n    选中 2 个顶点：置于两端点之间的半圆上。\n    选中 3 个顶点：置于两端点之间的圆弧段上。\n    选中 4 个及以上顶点：置于穿过选中顶点的样条上\n\n    ALT：重复使用上次设置"

#: op_set_edge_linear.py:13
msgctxt "Operator"
msgid "Makes edge loops linear between start and end vertices"
msgstr "使边循环在起点与终点顶点之间呈线性"

