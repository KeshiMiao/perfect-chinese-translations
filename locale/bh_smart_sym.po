msgctxt "Operator"
msgid "Reset Hotkey"
msgstr "重置快捷键"

#: bh_smart_sym/__init__.py:101
msgctxt "Operator"
msgid "Reset to Default (Alt+X)"
msgstr "重置为默认值（Alt+X）"

