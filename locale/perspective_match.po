#: props.py:29
msgid "Lines parallel to the world Y axis"
msgstr "平行于世界 Y 轴的线"

#: props.py:30
msgid "Lines parallel to the world Z axis (vertical)"
msgstr "平行于世界 Z 轴（垂直）的线"

