msgstr "第二轴"

#: props.py:166
msgid "Second axis of 2 Points"
msgstr "2 点的第二个轴"

#: ops.py:114
msgid "Select the file relative to the blend file"
msgstr "选择相对于 blend 文件的文件"

#: props.py:99
msgid "Set the size of the scene by a known length from the world origin along an axis: drag the end of that axis at the origin to the end of something you know the size of"
msgstr "通过从世界原点沿某一轴的已知长度来设定场景大小：将原点处该轴的端点拖到已知大小的物体末端"

#: props.py:177
msgid "Show the horizon (eye level) of the camera"
msgstr "显示相机的地平线（视线高度）"

#: props.py:175
msgid "Show the perspective lines in the camera view"
msgstr "在相机视图中显示透视线"

#: ui.py:178
msgid "Specify Scale"
msgstr "指定缩放"

#: props.py:72
msgid "Start"
msgstr "起点"

#: props.py:116
msgid "The known length goes along the negative axis"
msgstr "已知长度沿负轴方向"

#: props.py:114
msgid "The length was set once (it is remembered)"
msgstr "长度已设置过一次（会被记住）"

#: ops.py:208
msgid "The photo has no pixels"
msgstr "照片没有像素"

#: ops.py:165
msgid "The photo has no pixels (cannot read it)"
msgstr "照片没有像素（无法读取）"

#: props.py:158
msgid "Three vanishing points (X, Y and Z lines): the principal point (shift) is computed too"
msgstr "三个灭点（X、Y 和 Z 线）：主点（偏移）也会被计算"

#: props.py:42
msgid "Two horizontal directions (floor, walls, the two sides of a building)"
msgstr "两个水平方向（地板、墙壁、建筑的两侧）"

#: props.py:152
msgid "Two vanishing points give rotation and focal length; switching to this mode sets the shift to 0"
msgstr "两个灭点可得出旋转和焦距；切换到此模式会将偏移设为 0"

#: props.py:111
msgid "Where the end of the known length is on the photo"
msgstr "已知长度的末端在照片上的位置"

#: props.py:97
msgid "Where the world origin is on the photo"
msgstr "世界原点在照片上的位置"

#: props.py:168
msgid "Which two directions the lines follow"
msgstr "线条所沿的两个方向"

