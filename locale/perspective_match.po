#: ui.py:72
msgid "No background image on this camera"
msgstr "此相机没有背景图"

#: props.py:155
msgid "No tilt or roll (rotation X 90°, Y 0°): vertical lines stay vertical; uses the X and Y lines"
msgstr "无倾斜或滚转（X 旋转 90°，Y 0°）：垂直线保持垂直；使用 X 和 Y 线"

#: props.py:43
msgid "One horizontal direction (X) and the verticals"
msgstr "一个水平方向（X）和垂直线"

#: props.py:44
msgid "One horizontal direction (Y) and the verticals"
msgstr "一个水平方向（Y）和垂直线"

#: props.py:161
msgid "One vanishing point turns the camera; the focal length is kept, switching to this mode sets the shift to 0"
msgstr "一个灭点会旋转相机；焦距保持不变，切换到此模式会将偏移设为 0"

#: props.py:97
msgid "Origin"
msgstr "原点"

