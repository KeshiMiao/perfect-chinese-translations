msgstr "启用阴影或世界空间光照，或添加一盏太阳光"

#: HDRIRotator/preferences.py:76
msgid "Fade Duration"
msgstr "淡出持续时间"

#: HDRIRotator/operators.py:690
msgid "Failed to enter Sun mode"
msgstr "进入太阳模式失败"

#: HDRIRotator/preferences.py:26
msgid "Hold SHIFT for precise rotation (slower movement)"
msgstr "按住 SHIFT 进行精确旋转（移动更慢）"

#: HDRIRotator/preferences.py:106
msgid "Horizontal Position"
msgstr "水平位置"

#: HDRIRotator/preferences.py:106
msgid "Horizontal position of the overlay (percentage from left)"
msgstr "叠加层的水平位置（距左侧的百分比）"

#: HDRIRotator/preferences.py:67
msgid "How long to display the overlay (seconds)"
msgstr "叠加层显示时长（秒）"

#: HDRIRotator/preferences.py:76
msgid "How long to fade out the overlay (seconds)"
msgstr "叠加层淡出时长（秒）"

#: HDRIRotator/preferences.py:38
msgid "Invert Height Direction"
msgstr "反转高度方向"

#: HDRIRotator/preferences.py:32
msgid "Invert Rotation Direction"
msgstr "反转旋转方向"

