#: operators.py:11
msgctxt "Tooltip"
msgid "Adds a new sensor to the 'LuxMeter Sensors' collection at the 3D cursor's position"
msgstr "在 3D 光标位置向「LuxMeter Sensors」集合添加新传感器"

#: operators.py:420
msgctxt "Tooltip"
msgid "Adjust the Exposure Value by a specific step"
msgstr "按指定步长调整曝光值"

#: properties.py:133
msgctxt "Tooltip"
msgid "Adjust the ground level (Z-axis) if it's not at 0"
msgstr "如果地面高度（Z 轴）不在 0，请调整"

#: operators.py:124
msgctxt "Tooltip"
msgid "Adjusts the strength of the selected Sun Light so that the 'Basis Sensor' receives the 'Target Lux' value"
msgstr "调整所选太阳光的强度，使「Basis Sensor」接收到「Target Lux」值"

#: properties.py:68
msgctxt "Tooltip"
msgid "Analyzes speed over a specified frame range using Point A and Point B"
msgstr "使用点 A 和点 B 分析指定帧范围内的速度"

#: operators.py:206
msgctxt "Tooltip"
msgid "Calculate the optimal texture size based on the active camera view"
msgstr "根据活动相机视图计算最佳纹理尺寸"

#: properties.py:67
msgctxt "Tooltip"
msgid "Calculates speed by advancing the timeline frame by frame"
msgstr "逐帧推进时间轴以计算速度"

#: operators.py:226
msgctxt "Tooltip"
msgid "Calculates the average, maximum, and minimum speed of the target object between the start and end frames"
msgstr "计算目标物体在起始帧与结束帧之间的平均、最大和最小速度"

#: operators.py:333
msgctxt "Tooltip"
msgid "Calculates the distance at which an object would have a parallax shift equal to the 'Allowed Pixel Shift'"
msgstr "计算物体视差偏移等于「Allowed Pixel Shift」时的距离"

#: operators.py:276
msgctxt "Tooltip"
msgid "Calculates the distance from the scene's active camera to the target (3D Cursor or Active Object)"
msgstr "计算场景活动相机到目标（3D 光标或活动物体）的距离"

#: operators.py:296
msgctxt "Tooltip"
msgid "Calculates the distance to the horizon from the active camera's height, considering atmospheric refraction"
msgstr "根据活动相机高度计算到地平线的距离，并考虑大气折射"

#: properties.py:127
msgctxt "Tooltip"
msgid "Choose the target for distance calculation: the 3D Cursor or the currently active object"
msgstr "选择距离计算的目标：3D 光标或当前活动物体"

#: properties.py:110
msgctxt "Tooltip"
msgid "Converts exposure based on visual appearance back to 0 EV physical luminance and calculates illuminance on an absolute scale.If the original exposure reference is unknown, entering the estimated EV value of the environment will provide results closer to real-world illuminance."
msgstr "将基于视觉外观的曝光转换为 0 EV 的物理亮度，并按绝对尺度计算照度。如果原始曝光参考未知，输入环境的估计 EV 值可获得更接近真实照度的结果。"

#: operators.py:430
msgctxt "Tooltip"
msgid "Copy the specified value to the clipboard"
msgstr "将指定数值复制到剪贴板"

#: properties.py:55
msgctxt "Tooltip"
msgid "Correction factor for speed calculation. E.g., if 1 Blender Unit = 1 cm, set to 0.01 to get results in meters/sec"
msgstr "速度计算的修正系数。例如：若 1 Blender 单位 = 1 厘米，设为 0.01 即可得到米/秒的结果"

#: operators.py:313
msgctxt "Tooltip"
msgid "Creates an Empty object at the calculated horizon distance in front of the camera"
msgstr "在相机前方计算出的地平线距离处创建空物体"

#: operators.py:406
msgctxt "Tooltip"
msgid "Creates an Empty object at the calculated parallax distance in front of the camera"
msgstr "在相机前方计算出的视差距离处创建空物体"

#: operators.py:378
msgctxt "Tooltip"
msgid "Finds the two frames within the scene's frame range where the camera has moved the farthest apart"
msgstr "在场景帧范围内查找相机移动距离最远的两帧"

#: properties.py:37
msgctxt "Tooltip"
msgid "How many texture pixels to assign per 1 screen pixel. The slider goes up to 100%, but higher values can be entered manually"
msgstr "每 1 个屏幕像素分配多少纹理像素。滑块最高为 100%，但可手动输入更高值"

#: operators.py:34
msgctxt "Tooltip"
msgid "Measures the illuminance (lux) for all sensors in the collection. This may take time as it involves rendering"
msgstr "测量集合中所有传感器的照度（lux）。由于涉及渲染，可能需要一些时间"

#: operators.py:92
msgctxt "Tooltip"
msgid "Saves the names and lux values of all measured sensors to a CSV file"
msgstr "将所有已测量传感器的名称和 lux 值保存到 CSV 文件"

#: properties.py:115
msgctxt "Tooltip"
msgid "Select the Sun Light object you want to adjust"
msgstr "选择要调整的太阳光物体"

#: properties.py:74
