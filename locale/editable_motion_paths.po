msgstr "-X"

#: ops_timing.py:186
msgid "0 = spacing as it was, 1 = exactly the profile"
msgstr "0 = 保持原间距，1 = 完全贴合轮廓"

#: ops_tools.py:1553
msgid "0.5 = 50% bigger deviation from the baseline, -1 = flatten"
msgstr "0.5 = 相对基线的偏差增大 50%，-1 = 压平"

#: ops_shape.py:354
msgid "0.5 is a circular arc, lower is flatter / concave, higher keeps more of the corner"
msgstr "0.5 为圆弧，更低更平/更凹，更高保留更多拐角"

#: ops_tools.py:2220
msgid "0.5: handles 50% longer, -1: no handles"
msgstr "0.5：控制柄加长 50%，-1：无控制柄"

#: ops_tools.py:1998
msgid "1: full ease (the bone comes to rest at the key), -1: the opposite, faster through the key (Keep the Path: the frames spread out at the key; Handles: longer handles, a wider path around it)"
msgstr "1：完全缓动（骨骼在关键帧处静止），-1：相反，更快通过关键帧（保持路径：帧在关键帧处拉开；控制柄：控制柄更长，周围路径更宽）"

#: props.py:531
msgid "3D Cursor"
msgstr "3D 光标"

#: ops_tools.py:693
msgid "A bone of that armature (empty: the object itself)"
msgstr "该骨架的一根骨骼（留空：物体本身）"

#: props.py:698
msgid "A circle when the bone / object stays in place, the path otherwise"
msgstr "骨骼/物体原地不动时显示圆，否则显示路径"

#: props.py:869
msgid "A click near a path goes to the path, not to a bone or object under it: keys, handles win from farther away (2.5 times). Away from them, a click selects bones and objects as usual"
msgstr "在路径附近单击会选中路径，而不是其下方的骨骼或物体：关键帧、控制柄在更远处仍优先（2.5 倍）。远离它们时，单击会照常选择骨骼和物体"

#: props.py:531
msgid "A floor at the height of the 3D cursor"
msgstr "位于 3D 光标高度的地面"

#: props.py:530
msgid "A floor at this height (a rooftop, a table...)"
msgstr "此高度的地面（屋顶、桌面……）"

#: props.py:650
msgid "A graph of the speed of the active path, above the timing chart"
msgstr "活动路径速度的图表，位于时间图上方"

#: ops_io.py:111
msgid "A key on every point of the curve (exported paths keep their frames)"
msgstr "曲线每个点上都有关键帧（导出的路径保留其帧）"

#: props.py:608
msgid "A timing chart of the selected keys at the bottom of the viewport: where every frame is between them. Drag a frame tick (or a frame dot on the path) to change it"
msgstr "视图底部的所选关键帧时间图：显示每帧在它们之间的位置。拖动帧刻度（或路径上的帧点）即可更改"

