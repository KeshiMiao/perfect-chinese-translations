msgid "Assign a Driver Mesh with shapes to see folders."
msgstr "指定带形态的驱动网格以查看文件夹。"

#: __init__.py:123
msgid "Assign main Driver mesh first."
msgstr "请先指定主驱动网格。"

#: __init__.py:475
